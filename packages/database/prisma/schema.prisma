  submittedOn                  DateTime                 @map("submitted_on") @db.Date
  returnDueOn                  DateTime                 @map("return_due_on") @db.Date
  status                       SecurityInstrumentStatus @default(LODGED)
  lodgeJournalEntryId          String?                  @map("lodge_journal_entry_id") @db.Uuid
  fundedByLegalEntityId        String?                  @map("funded_by_legal_entity_id") @db.Uuid
  fundedByPartyId              String?                  @map("funded_by_party_id") @db.Uuid
  fundedByBankAccountDetails   String?                  @map("funded_by_bank_account_details")
  fundedByTransferAmount       Decimal?                 @map("funded_by_transfer_amount") @db.Decimal(19, 4)
  fundedByTransferMode         String?                  @map("funded_by_transfer_mode")
  fundedByNote                 String?                  @map("funded_by_note")
  returnedAmount               Decimal?                 @map("returned_amount") @db.Decimal(19, 4)
  returnedOn                   DateTime?                @map("returned_on") @db.Date
  returnedToLegalEntityId      String?                  @map("returned_to_legal_entity_id") @db.Uuid
  returnedToPartyId            String?                  @map("returned_to_party_id") @db.Uuid
  returnedToBankAccountDetails String?                  @map("returned_to_bank_account_details")
  returnJournalEntryId         String?                  @map("return_journal_entry_id") @db.Uuid
  narrative                    String?
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  createdBy                    String?                  @map("created_by") @db.Uuid
  updatedAt                    DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy                    String?                  @map("updated_by") @db.Uuid
  version                      Int                      @default(1)

  legalEntity           LegalEntity               @relation("SecurityInstrumentLegalEntity", fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_security_instruments_legal_entity_org_consistent")
  project               Project?                  @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_security_instruments_project_org_consistent")
  tender                Tender?                   @relation(fields: [tenderId, organizationId], references: [id, organizationId], map: "fk_security_instruments_tender_org_consistent")

enum SecurityInstrumentCategory {
  EMD
  SD
}

/// Organization-seeded (six starter purposes seeded automatically at org
/// creation — see seed.ts), then Administrator-extensible via the generic
/// Masters catalogue (`master.manage`) exactly like every other flat lookup
/// master. `category` is nullable specifically because that generic
/// create/update path (masters.service.ts) only ever sets the common
/// code/name/description/sortOrder columns — a NOT NULL category would
/// crash on any admin-created purpose; SecurityInstrumentsService simply
/// excludes a null-category purpose's amounts from the EMD/SD tile split
/// rather than guessing. `defaultRecoverableLedgerAccountId` is the
/// per-purpose "which asset account does this deposit sit in" mapping
/// SecurityInstrumentsService resolves at lodge time — left null for
/// purposes with no seeded mapping yet; lodging a cash-equivalent
/// instrument under an unmapped purpose is rejected rather than guessing.
/// No dedicated UI to edit either field exists this slice (seed-only),
/// same as LedgerAccount.allowManualPosting being reserved without a
/// toggle UI in ADR-062.
model SecurityInstrumentPurpose {
  id                                String                      @id @db.Uuid
  organizationId                    String                      @map("organization_id") @db.Uuid
  code                              String
  name                              String
  description                       String?
  category                          SecurityInstrumentCategory?
  defaultRecoverableLedgerAccountId String?                     @map("default_recoverable_ledger_account_id") @db.Uuid
  sortOrder                         Int                         @default(0) @map("sort_order")
  isActive                          Boolean                     @default(true) @map("is_active")
  deletedAt                         DateTime?                   @map("deleted_at") @db.Timestamptz
  deletedBy                         String?                     @map("deleted_by") @db.Uuid
  createdAt                         DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  createdBy                         String?                     @map("created_by") @db.Uuid
  updatedAt                         DateTime                    @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy                         String?                     @map("updated_by") @db.Uuid
  version                           Int                         @default(1)

  defaultRecoverableLedgerAccount LedgerAccount?       @relation(fields: [defaultRecoverableLedgerAccountId, organizationId], references: [id, organizationId], map: "fk_security_instrument_purposes_ledger_account_org_consistent")
  instruments                     SecurityInstrument[]

  @@unique([organizationId, code], map: "uq_security_instrument_purposes_org_code")
  // Supports the composite FK from SecurityInstrument.purposeId (org-consistency check).
  @@unique([id, organizationId], map: "uq_security_instrument_purposes_id_org")
  @@map("security_instrument_purposes")
}

/// Organization-seeded (seven starter types seeded automatically at org
/// creation, including `cash` added in Phase 4.5 — see seed.ts), then
/// Administrator-extensible. `requiresCashPosting` drives
/// SecurityInstrumentsService's branch between "post a Dr Recoverable / Cr
/// Bank journal at lodge/return" and "track only, principal is contingent
/// exposure" (docs/06) — true for cash-equivalent types (cash, demand
/// draft, FDR, banker's cheque, online payment), false for guarantee
/// instruments (bank guarantee, insurance surety bond).
model SecurityInstrumentType {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  code                String
  name                String
  description         String?
  requiresCashPosting Boolean   @default(true) @map("requires_cash_posting")
  sortOrder           Int       @default(0) @map("sort_order")
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy           String?   @map("deleted_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)

  instruments SecurityInstrument[]

  @@unique([organizationId, code], map: "uq_security_instrument_types_org_code")
  // Supports the composite FK from SecurityInstrument.typeId (org-consistency check).
  @@unique([id, organizationId], map: "uq_security_instrument_types_id_org")
  @@map("security_instrument_types")
}

/// uq_legal_entities_org_pan (a partial unique index on organization_id,
/// pan_number WHERE deleted_at IS NULL) is hand-added in the migration SQL
/// since Prisma's @@unique cannot express a WHERE clause — this lets a
/// soft-deleted entity's PAN be reused by a new one.
model LegalEntity {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  legalName         String    @map("legal_name")
  panNumber         String    @map("pan_number")
  registeredAddress String    @map("registered_address")
  // Optional print images (ADR-141). Bytes stay off list queries; content
  // type is the presence flag. PNG or JPEG only, capped in the service.
  logoContentType           String? @map("logo_content_type")
  logoBytes                 Bytes?  @map("logo_bytes")
  sealContentType           String? @map("seal_content_type")
  sealBytes                 Bytes?  @map("seal_bytes")
  authorizedSignContentType String? @map("authorized_sign_content_type")
  authorizedSignBytes       Bytes?  @map("authorized_sign_bytes")
  // S3 object keys (ADR-193). New uploads go to object storage and leave the
  // *Bytes columns null; rows saved before keep their bytes and still print.
  logoStorageKey            String? @map("logo_storage_key")
  sealStorageKey            String? @map("seal_storage_key")
  authorizedSignStorageKey  String? @map("authorized_sign_storage_key")
  // Printed on the tax invoice (ADR-142). Bank lines come from Bank Accounts.
  invoicePlaceOfSupply   String? @map("invoice_place_of_supply")
  invoiceJurisdiction    String? @map("invoice_jurisdiction")
  invoiceStateCode       String? @map("invoice_state_code")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy         String?   @map("deleted_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy         String?   @map("updated_by") @db.Uuid
  version           Int       @default(1)

  gstRegistrations              GstRegistration[]
  financialYears                FinancialYear[]
  auditEvents                   AuditEvent[]
  projects                      Project[]
  employees                     Employee[]
  journalEntries                JournalEntry[]
  securityInstruments           SecurityInstrument[]   @relation("SecurityInstrumentLegalEntity")
  fundedSecurityInstruments     SecurityInstrument[]   @relation("SecurityInstrumentFundingLegalEntity")
  returnedToSecurityInstruments SecurityInstrument[]   @relation("SecurityInstrumentReturnLegalEntity")
  invoices                      Invoice[]
  creditDebitNotes              CreditDebitNote[]
  vendorBills                   VendorBill[]
  bankAccounts                  BankAccount[]
  clientReceipts                ClientReceipt[]
  ledgerOpeningBalances         LedgerOpeningBalance[]
  paymentRequests               PaymentRequest[]
  vendorPayments                VendorPayment[]
  employeeAdvances              EmployeeAdvance[]
  employeeExpenseClaims         EmployeeExpenseClaim[]
  directExpenses                DirectExpense[]
  cardAccounts                  CardAccount[]
  inventoryReceipts             InventoryReceipt[]
  tdsCertificates               TdsCertificate[]
  tdsDeposits                   TdsDeposit[]
  inventoryConsumptions         InventoryConsumption[]
  salaryImports                 SalaryImport[]
  introducerAgreements          IntroducerAgreement[]
  introducerPayments            IntroducerPayment[]
  salaryPayments                SalaryPayment[]

  // Composite-unique support constraint letting gst_registrations and
  // financial_years enforce organization consistency via real composite FKs.
  @@unique([id, organizationId], map: "uq_legal_entities_id_org")
  @@map("legal_entities")
}

/// chk_gst_registrations_gstin_format (15-char GSTIN regex) is hand-added in
/// the migration SQL — Prisma's schema DSL has no regex CHECK expression.
/// uq_gst_registrations_gstin is likewise hand-added as a partial unique
/// index (WHERE deleted_at IS NULL) so a soft-deleted registration's GSTIN
/// can be reused by a new one.
model GstRegistration {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  legalEntityId  String    @map("legal_entity_id") @db.Uuid
  stateId        String    @map("state_id") @db.Uuid
  gstin          String
  tradeName      String?   @map("trade_name")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  // Composite FK enforces the legal entity belongs to this organization.
  // stateId stays a plain FK — State is a global catalog with no
  // organization_id to cross-check.
  legalEntity      LegalEntity       @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_gst_registrations_legal_entity_org_consistent")
  state            State             @relation(fields: [stateId], references: [id])
  journalLines     JournalLine[]
  invoices         Invoice[]
  creditDebitNotes CreditDebitNote[]
  vendorBills      VendorBill[]

  @@unique([id, organizationId], map: "uq_gst_registrations_id_org")
  @@index([legalEntityId], map: "idx_gst_registrations_legal_entity_id")
  @@map("gst_registrations")
}

/// Container only — no independent state machine. uq_financial_years_one_current
/// (a partial unique index on legal_entity_id WHERE is_current) is hand-added
/// in the migration SQL since Prisma's @@unique cannot express a WHERE clause.
model FinancialYear {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  legalEntityId  String   @map("legal_entity_id") @db.Uuid
  label          String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid
  version        Int      @default(1)

  legalEntity       LegalEntity        @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_financial_years_legal_entity_org_consistent")
  accountingPeriods AccountingPeriod[]
  invoices          Invoice[]
  creditDebitNotes  CreditDebitNote[]
  vendorBills       VendorBill[]

  @@unique([legalEntityId, label], map: "uq_financial_years_legal_entity_label")
  // Composite-unique support constraint letting accounting_periods enforce
  // organization consistency via a real composite FK.
  @@unique([id, organizationId], map: "uq_financial_years_id_org")
  @@map("financial_years")
}

/// System-generated — 12 rows created automatically when a financial year is
/// created. chk_accounting_periods_status and chk_accounting_periods_reopener_differs
/// (maker-checker: the actor who reopens a period must differ from the actor
/// who locked it) are hand-added in the migration SQL.
model AccountingPeriod {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  financialYearId String    @map("financial_year_id") @db.Uuid
  periodNumber    Int       @map("period_number")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  status          String    @default("OPEN")
  lockedAt        DateTime? @map("locked_at") @db.Timestamptz
  lockedBy        String?   @map("locked_by") @db.Uuid
  reopenedAt      DateTime? @map("reopened_at") @db.Timestamptz
  reopenedBy      String?   @map("reopened_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?   @map("updated_by") @db.Uuid
  version         Int       @default(1)

  financialYear  FinancialYear                @relation(fields: [financialYearId, organizationId], references: [id, organizationId], map: "fk_accounting_periods_fy_org_consistent")
  transitions    AccountingPeriodTransition[]
  journalEntries JournalEntry[]

  @@unique([financialYearId, periodNumber], map: "uq_accounting_periods_fy_period_number")
  // Composite-unique support constraint letting accounting_period_transitions
  // enforce organization consistency via a real composite FK.
  @@unique([id, organizationId], map: "uq_accounting_periods_id_org")
  @@map("accounting_periods")
}

/// Append-only, system-managed — one row per transition command, always
/// written in the same transaction as the accounting_periods status update.
model AccountingPeriodTransition {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  accountingPeriodId String   @map("accounting_period_id") @db.Uuid
  previousStatus     String   @map("previous_status")
  newStatus          String   @map("new_status")
  action             String
  actorId            String   @map("actor_id") @db.Uuid
  reason             String
  correlationId      String   @map("correlation_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Composite FK enforces the accounting period belongs to this organization
  // (previously this relation didn't exist at all — accountingPeriodId was
  // an unenforced scalar).
  accountingPeriod AccountingPeriod @relation(fields: [accountingPeriodId, organizationId], references: [id, organizationId], map: "fk_accounting_period_transitions_period_org_consistent")

  @@index([accountingPeriodId, createdAt], map: "idx_accounting_period_transitions_period_id")
  @@map("accounting_period_transitions")
}

/// Administrator-created; distinct from User (an employee may exist without
/// ever getting a login — e.g. non-application staff — and a user may exist
/// without an employee record — e.g. a platform administrator who isn't
/// staff). userId is nullable (both directions of "may exist without the
/// other" must remain possible) but unique when populated: at most one
/// employee record per user. displayed_salary_amount is explicitly
/// non-authoritative (reference/display only; no payroll calculation reads
/// it in Phase 2). status is the sole lifecycle source of truth — there is
/// deliberately no separate is_active column (see docs/12 decisions log).
model Employee {
  id                    String    @id @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  userId                String?   @unique(map: "uq_employees_user_id") @map("user_id") @db.Uuid
  /// The company the employee works for (ADR-154); null until set.
  legalEntityId         String?   @map("legal_entity_id") @db.Uuid
  internalDepartmentId  String?   @map("internal_department_id") @db.Uuid
  designationId         String?   @map("designation_id") @db.Uuid
  employmentTypeId      String?   @map("employment_type_id") @db.Uuid
  employeeCode          String    @map("employee_code")
  fullName              String    @map("full_name")
  isReimbursable        Boolean   @default(false) @map("is_reimbursable")
  displayedSalaryAmount Decimal?  @map("displayed_salary_amount") @db.Decimal(19, 4)
  /// Optional (ADR-170): an imported employee may not have one yet.
  joiningDate           DateTime? @map("joining_date") @db.Date
  status                String    @default("ACTIVE")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy             String?   @map("deleted_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy             String?   @map("created_by") @db.Uuid
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy             String?   @map("updated_by") @db.Uuid
  version               Int       @default(1)

  // Composite FK (user_id, organization_id) -> users(id, organization_id):
  // when userId is populated, the linked user must belong to the SAME
  // organization as this employee. Trivially satisfied when userId is NULL
  // (Postgres skips a composite FK check when any column is NULL).
  user                   User?                       @relation(fields: [userId, organizationId], references: [id, organizationId], map: "fk_employees_user_org_consistent")
  internalDepartment     InternalDepartment?         @relation(fields: [internalDepartmentId, organizationId], references: [id, organizationId], map: "fk_employees_internal_department_org_consistent")
  designation            Designation?                @relation(fields: [designationId, organizationId], references: [id, organizationId], map: "fk_employees_designation_org_consistent")
  legalEntity            LegalEntity?                @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_employees_legal_entity_org_consistent")
  employmentType         EmploymentType?             @relation(fields: [employmentTypeId, organizationId], references: [id, organizationId], map: "fk_employees_employment_type_org_consistent")
  assignedLeads          Lead[]                      @relation("LeadAssignedToEmployee")
  assignedTenders        Tender[]                    @relation("TenderAssignedToEmployee")
  projectsManaged        Project[]                   @relation("ProjectManager")
  projectsSold           Project[]                   @relation("SalesManager")
  projectTeamMemberships ProjectTeamMember[]
  journalLines           JournalLine[]
  employeeAdvances       EmployeeAdvance[]
  employeeExpenseClaims  EmployeeExpenseClaim[]
  directExpensePurchases DirectExpense[]
  cardAccountsHeld       CardAccount[]
  salaryImportLines      SalaryImportLine[]
  salaryPaymentLines     SalaryPaymentLine[]
  monthlyAllocations     EmployeeMonthlyAllocation[]
  salaryRevisions        EmployeeSalaryRevision[]

  @@index([legalEntityId], map: "idx_employees_legal_entity_id")
  @@unique([organizationId, employeeCode], map: "uq_employees_org_employee_code")
  // Supports the composite FK from Lead.assignedToEmployeeId.
  @@unique([id, organizationId], map: "uq_employees_id_org")
  @@map("employees")
}

/// System-seeded, global, fixed reference — no organization scoping, no
/// end-user CRUD (code-controlled; extended only by future phases' own seed
/// migrations, e.g. VENDOR/INTRODUCER are reserved rows added now but only
/// consumed once Phase 6/7 build those entities).
model EntityType {
  code        String  @id
  description String?

  documentCategoryLinks DocumentCategoryEntityType[]
  documentLinks         DocumentLink[]

  @@map("entity_types")
}

/// Organization-scoped flat lookup master, Administrator-created. Common
/// baseline (see InternalDepartment's doc comment). Absence of any row in
/// document_category_entity_types for a category means "applies to every
/// entity type" (relational equivalent of a nullable "applies everywhere").
model DocumentCategory {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  entityTypeLinks DocumentCategoryEntityType[]
  documents       Document[]

  @@unique([organizationId, code], map: "uq_document_categories_org_code")
  // Composite-unique support constraint (id is already globally unique via
  // the PK; this exists purely so Document.documentCategoryId can enforce
  // organization consistency via a real composite FK — the same technique
  // used for districts/cities and users/employees).
  @@unique([id, organizationId], map: "uq_document_categories_id_org")
  @@map("document_categories")
}

/// Junction, System/Administrator-managed alongside its parent category.
model DocumentCategoryEntityType {
  documentCategoryId String @map("document_category_id") @db.Uuid
  entityTypeCode     String @map("entity_type_code")

  documentCategory DocumentCategory @relation(fields: [documentCategoryId], references: [id])
  entityType       EntityType       @relation(fields: [entityTypeCode], references: [code])

  @@id([documentCategoryId, entityTypeCode])
  @@map("document_category_entity_types")
}

/// Organization-scoped flat lookup master, Administrator-created, flat
/// (decided — no parent_id). ledgerAccountId (Phase 6.2) resolves which
/// expense ledger account a VendorBillLine tagged with this category
/// debits at finalize — nullable-with-fallback, same shape as
/// PenaltyCategory.acceptedLedgerAccountId; VendorBillsService falls back
/// to one default "Other Expenses" account when unset, exactly like
/// ReceiptsService already does for an unset PenaltyCategory account.
/// Common baseline (see InternalDepartment's doc comment).
model ExpenseCategory {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  code            String
  name            String
  description     String?
  ledgerAccountId String?   @map("ledger_account_id") @db.Uuid
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy       String?   @map("deleted_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?   @map("updated_by") @db.Uuid
  version         Int       @default(1)

  ledgerAccount         LedgerAccount?         @relation(fields: [ledgerAccountId, organizationId], references: [id, organizationId], map: "fk_expense_categories_ledger_account_org_consistent")
  vendorBillLines       VendorBillLine[]
  employeeExpenseClaims EmployeeExpenseClaim[]
  directExpenses        DirectExpense[]

  @@unique([organizationId, code], map: "uq_expense_categories_org_code")
  // Composite-unique support constraint (id is already globally unique via
  // the PK; this exists purely so VendorBillLine.expenseCategoryId can
  // enforce organization consistency via a real composite FK — Phase 6.1).
  @@unique([id, organizationId], map: "uq_expense_categories_id_org")
  @@map("expense_categories")
}

/// Organization-scoped flat lookup master (units_of_measure, Phase 6.2
/// polish) — byte-for-byte DocumentCategory's own common baseline shape,
/// added as a 13th MasterTypeKey behind the existing generic masters API
/// rather than a bespoke model. code is the immutable slug the frontend
/// resolves 'qty' against for its default selection; name/description/
/// sortOrder/isActive are the only editable fields (generic MasterPort.
/// update() never accepts code).
model UnitOfMeasure {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  vendorBillLines VendorBillLine[]
  inventoryItems  InventoryItem[]

  @@unique([organizationId, code], map: "uq_units_of_measure_org_code")
  // Composite-unique support constraint letting VendorBillLine.unitOfMeasureId
  // enforce organization consistency via a real composite FK.
  @@unique([id, organizationId], map: "uq_units_of_measure_id_org")
  @@map("units_of_measure")
}

/// Organization-scoped flat lookup master, Administrator-created, flat.
/// A 15th generic MasterTypeKey (Phase 7.1, ADR-091) classifying
/// InventoryItem rows on the product master screen
/// (07-assets-inventory/master-product.html: "category"). Kept generic —
/// unlike ExpenseCategory it carries no ledger-account linkage, because
/// inventory always debits the single INVENTORY account regardless of
/// category (docs/06 "Finalize vendor bill for inventory").
model ProductCategory {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  inventoryItems InventoryItem[]

  @@unique([organizationId, code], map: "uq_product_categories_org_code")
  // Composite-unique support constraint letting InventoryItem.productCategoryId
  // enforce organization consistency via a real composite FK.
  @@unique([id, organizationId], map: "uq_product_categories_id_org")
  @@map("product_categories")
}

/// Product / item master (Phase 7.1, ADR-091). Deliberately NOT a generic
/// MasterTypeKey: it carries unit of measure, HSN/SAC, category, an optional
/// default rate and the isStockTracked discriminator, well beyond the flat
/// baseline shape ADR-037/038 scopes the generic masters API to. Same
/// precedent as ExpenseCategory and PenaltyCategory, both forced out of that
/// registry for exactly this reason (ADR-062).
///
/// `isStockTracked` is docs/01's own discriminator — "stock-tracked items use
/// Inventory; non-stock goods/services use Expense". Only a stock-tracked item
/// may be referenced by a VendorBillLine's inventory variant (Slice 7.2) or
/// consumed (Slice 7.3).
///
/// No fixed-asset classification or depreciation fields, ever — ADR-018,
/// docs/04 §14 ("No Fixed Asset or depreciation screens are required") and
/// docs/16 §7.7 all exclude them despite the prototype's folder name.
///
/// Deactivation (isActive=false) keeps the row visible in filters and
/// read-only historical views but never selectable on create/edit — the
/// project-wide deactivated-master rule, implemented through the shared
/// `includeInactive` list flag.
model InventoryItem {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  /// Server-generated, org-unique (ITEM-000001). Never user-entered, so it
  /// can never collide with a re-used or hand-typed value.
  code              String
  name              String
  description       String?
  unitOfMeasureId   String    @map("unit_of_measure_id") @db.Uuid
  productCategoryId String?   @map("product_category_id") @db.Uuid
  hsnSac            String?   @map("hsn_sac")
  /// Optional convenience default only. Never an accounting figure — the
  /// real cost of stock is always the weighted average derived from posted
  /// movements (Slice 7.2), never this column.
  defaultRateAmount Decimal?  @map("default_rate_amount") @db.Decimal(19, 4)
  isStockTracked    Boolean   @default(true) @map("is_stock_tracked")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy         String?   @map("deleted_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy         String?   @map("updated_by") @db.Uuid
  version           Int       @default(1)

  unitOfMeasure    UnitOfMeasure              @relation(fields: [unitOfMeasureId, organizationId], references: [id, organizationId], map: "fk_inventory_items_unit_of_measure_org_consistent")
  movements        InventoryMovement[]
  receiptLines     InventoryReceiptLine[]
  consumptionLines InventoryConsumptionLine[]
  vendorBillLines  VendorBillLine[]
  productCategory  ProductCategory?           @relation(fields: [productCategoryId, organizationId], references: [id, organizationId], map: "fk_inventory_items_product_category_org_consistent")

  @@unique([organizationId, code], map: "uq_inventory_items_org_code")
  // Composite-unique support constraint for the movement/receipt/consumption
  // children Slices 7.2 and 7.3 add.
  @@unique([id, organizationId], map: "uq_inventory_items_id_org")
  @@index([organizationId, isActive], map: "idx_inventory_items_org_active")
  @@index([organizationId, productCategoryId], map: "idx_inventory_items_org_category")
  @@map("inventory_items")
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  CONSUMPTION
  REVERSAL
}

enum InventoryReceiptType {
  OPENING
  DIRECT
}

enum InventoryDocumentStatus {
  POSTED
  REVERSED
}

/// The append-only stock ledger (Phase 7.2, ADR-092) — docs/04:463's
/// "movement ledger is authoritative" made literal. One row per stock
/// event, never updated and never deleted; a mistake is corrected by a
/// REVERSAL row, exactly as a posted journal is corrected by a reversing
/// entry rather than an edit (ADR-021/067).
///
/// Each row stores the balance it produced (balanceQuantity /
/// balanceValueAmount / weightedAverageRate) rather than leaving it to be
/// recomputed by replaying the ledger. That is what makes a past
/// consumption's cost permanently reproducible, and it is what makes
/// Phase 7's own exit criterion ("inventory movement reconciles to stock
/// value") true by construction: the sum of every item's latest
/// balanceValueAmount IS the INVENTORY ledger account's balance.
///
/// sequenceNumber is assigned per item inside the same row-locked
/// transaction that computes the balance, so the ledger has one total
/// order even when several movements share a movementDate.
///
/// No journalEntryId here: the journal belongs to the parent document
/// (the vendor bill, the receipt, the consumption), and a movement is
/// never independently posted. Deliberately linked by a real FK per
/// source rather than a polymorphic sourceId — the same choice ADR-088
/// made for RecurringCycle, with a CHECK enforcing exactly one.
model InventoryMovement {
  id                     String                @id @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  inventoryItemId        String                @map("inventory_item_id") @db.Uuid
  movementType           InventoryMovementType @map("movement_type")
  movementDate           DateTime              @map("movement_date") @db.Date
  sequenceNumber         Int                   @map("sequence_number")
  quantityIn             Decimal               @default(0) @map("quantity_in") @db.Decimal(19, 4)
  quantityOut            Decimal               @default(0) @map("quantity_out") @db.Decimal(19, 4)
  /// Per-unit cost this movement was valued at — the purchase cost for a
  /// receipt, the ruling weighted average for a consumption.
  unitCostAmount         Decimal               @map("unit_cost_amount") @db.Decimal(19, 4)
  /// The value this movement moved — the exact figure posted to the
  /// journal, never a rounded display of something else.
  movementValueAmount    Decimal               @map("movement_value_amount") @db.Decimal(19, 4)
  balanceQuantity        Decimal               @map("balance_quantity") @db.Decimal(19, 4)
  balanceValueAmount     Decimal               @map("balance_value_amount") @db.Decimal(19, 4)
  weightedAverageRate    Decimal               @map("weighted_average_rate") @db.Decimal(19, 4)
  vendorBillLineId       String?               @map("vendor_bill_line_id") @db.Uuid
  inventoryReceiptId     String?               @map("inventory_receipt_id") @db.Uuid
  /// Phase 7.3 (ADR-093) — the third and final movement source. Kept as a
  /// real FK per source rather than a polymorphic sourceId, exactly as the
  /// other two are.
  inventoryConsumptionId String?               @map("inventory_consumption_id") @db.Uuid
  reversalOfMovementId   String?               @map("reversal_of_movement_id") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?               @map("created_by") @db.Uuid

  inventoryItem        InventoryItem         @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], map: "fk_inventory_movements_item_org_consistent")
  vendorBillLine       VendorBillLine?       @relation(fields: [vendorBillLineId], references: [id], map: "fk_inventory_movements_vendor_bill_line")
  inventoryReceipt     InventoryReceipt?     @relation(fields: [inventoryReceiptId, organizationId], references: [id, organizationId], map: "fk_inventory_movements_receipt_org_consistent")
  inventoryConsumption InventoryConsumption? @relation(fields: [inventoryConsumptionId, organizationId], references: [id, organizationId], map: "fk_inventory_movements_consumption_org_consistent")
  reversalOf           InventoryMovement?    @relation("InventoryMovementReversal", fields: [reversalOfMovementId], references: [id], map: "fk_inventory_movements_reversal_of")
  reversedBy           InventoryMovement[]   @relation("InventoryMovementReversal")

  @@unique([organizationId, inventoryItemId, sequenceNumber], map: "uq_inventory_movements_item_sequence")
  @@unique([id, organizationId], map: "uq_inventory_movements_id_org")
  @@index([organizationId, inventoryItemId, movementDate], map: "idx_inventory_movements_item_date")
  @@index([vendorBillLineId], map: "idx_inventory_movements_vendor_bill_line")
  @@index([inventoryReceiptId], map: "idx_inventory_movements_receipt")
  @@index([inventoryConsumptionId], map: "idx_inventory_movements_consumption")
  @@map("inventory_movements")
}

/// A stock receipt that does NOT come from a vendor bill (Phase 7.2,
/// ADR-092). The vendor-bill path is the primary one — approving a bill
/// with an inventory line creates its movement atomically and posts the
/// Inventory debit as part of the bill's own journal, so a separate
/// document there would duplicate the liability journal docs/04:464
/// explicitly forbids duplicating.
///
/// This model therefore covers exactly the two cases the bill path cannot:
///   * OPENING — cutover stock that was never purchased through this
///     system. Posts Dr INVENTORY / Cr OPENING_BALANCE_EQUITY, reusing
///     ADR-071's opening-balance mechanism rather than inventing a second.
///   * DIRECT  — stock received against a vendor liability with no bill
///     raised in this system. Posts Dr INVENTORY / Cr ACCOUNTS_PAYABLE_VENDOR.
///
/// Stock adjustments and write-offs are deliberately NOT modelled here —
/// they have no posting rule in docs/06 and are disclosed as deferred
/// rather than invented.
model InventoryReceipt {
  id                     String                  @id @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  legalEntityId          String                  @map("legal_entity_id") @db.Uuid
  receiptNumber          String                  @map("receipt_number")
  receiptType            InventoryReceiptType    @map("receipt_type")
  /// The supplying vendor. Required for DIRECT (it is the credited
  /// payable) and forbidden for OPENING (there is no counterparty) —
  /// enforced by a CHECK, not by convention.
  partyId                String?                 @map("party_id") @db.Uuid
  receivedDate           DateTime                @map("received_date") @db.Date
  invoiceChallanNumber   String?                 @map("invoice_challan_number")
  note                   String?
  status                 InventoryDocumentStatus @default(POSTED)
  totalValueAmount       Decimal                 @map("total_value_amount") @db.Decimal(19, 4)
  journalEntryId         String                  @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?                 @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?               @map("reversed_at") @db.Timestamptz
  reversedBy             String?                 @map("reversed_by") @db.Uuid
  reversalReason         String?                 @map("reversal_reason")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?                 @map("created_by") @db.Uuid
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?                 @map("updated_by") @db.Uuid
  version                Int                     @default(1)

  legalEntity LegalEntity            @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_inventory_receipts_legal_entity_org_consistent")
  party       Party?                 @relation(fields: [partyId, organizationId], references: [id, organizationId], map: "fk_inventory_receipts_party_org_consistent")
  lines       InventoryReceiptLine[]
  movements   InventoryMovement[]

  @@unique([organizationId, receiptNumber], map: "uq_inventory_receipts_org_number")
  @@unique([id, organizationId], map: "uq_inventory_receipts_id_org")
  @@index([organizationId, status], map: "idx_inventory_receipts_org_status")
  @@index([organizationId, receivedDate], map: "idx_inventory_receipts_org_date")
  @@map("inventory_receipts")
}

/// Line table: no version, no lifecycle of its own, cascades with its
/// parent — the same shape as VendorBillLine.
model InventoryReceiptLine {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  inventoryReceiptId String   @map("inventory_receipt_id") @db.Uuid
  inventoryItemId    String   @map("inventory_item_id") @db.Uuid
  sequence           Int
  quantity           Decimal  @db.Decimal(19, 4)
  unitCostAmount     Decimal  @map("unit_cost_amount") @db.Decimal(19, 4)
  lineValueAmount    Decimal  @map("line_value_amount") @db.Decimal(19, 4)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  inventoryReceipt InventoryReceipt @relation(fields: [inventoryReceiptId], references: [id], onDelete: Cascade, map: "fk_inventory_receipt_lines_receipt")
  inventoryItem    InventoryItem    @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], map: "fk_inventory_receipt_lines_item_org_consistent")

  @@index([inventoryReceiptId], map: "idx_inventory_receipt_lines_receipt")
  @@index([inventoryItemId], map: "idx_inventory_receipt_lines_item")
  @@map("inventory_receipt_lines")
}

/// Project consumption of stock (Phase 7.3, ADR-093) — docs/06's
/// "Inventory / Project consumption" rule: Dr Project Material Cost;
/// Cr Inventory, at weighted average.
///
/// This is the counterpart to InventoryReceipt and the only way stock
/// leaves the ledger for a business reason. A project is REQUIRED, not
/// optional: docs/06 names the debit "Project Material Cost" and docs/04
/// §14 requires an "active project" to be validated, so consumption with
/// no project has no posting rule and is therefore not modelled. Stock
/// write-offs and adjustments remain deliberately unbuilt for the same
/// reason (ADR-092 point 8).
///
/// unitCostAmount on each line is the ruling weighted average STAMPED at
/// posting time, never recomputed on read — the same discipline as
/// InventoryMovement's own snapshot. It is what makes a past consumption's
/// cost permanently reproducible even after later receipts move the
/// average.
model InventoryConsumption {
  id                     String                  @id @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  legalEntityId          String                  @map("legal_entity_id") @db.Uuid
  consumptionNumber      String                  @map("consumption_number")
  /// Required — see the model comment. The analytical dimension the
  /// Project Material Cost debit is stamped with on the journal line.
  projectId              String                  @map("project_id") @db.Uuid
  consumedDate           DateTime                @map("consumed_date") @db.Date
  note                   String?
  status                 InventoryDocumentStatus @default(POSTED)
  totalValueAmount       Decimal                 @map("total_value_amount") @db.Decimal(19, 4)
  journalEntryId         String                  @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?                 @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?               @map("reversed_at") @db.Timestamptz
  reversedBy             String?                 @map("reversed_by") @db.Uuid
  reversalReason         String?                 @map("reversal_reason")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?                 @map("created_by") @db.Uuid
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?                 @map("updated_by") @db.Uuid
  version                Int                     @default(1)

  legalEntity LegalEntity                @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_inventory_consumptions_legal_entity_org_consistent")
  project     Project                    @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_inventory_consumptions_project_org_consistent")
  lines       InventoryConsumptionLine[]
  movements   InventoryMovement[]

  @@unique([organizationId, consumptionNumber], map: "uq_inventory_consumptions_org_number")
  @@unique([id, organizationId], map: "uq_inventory_consumptions_id_org")
  @@index([organizationId, status], map: "idx_inventory_consumptions_org_status")
  @@index([organizationId, consumedDate], map: "idx_inventory_consumptions_org_date")
  @@index([organizationId, projectId], map: "idx_inventory_consumptions_org_project")
  @@map("inventory_consumptions")
}

/// Line table: no version, no lifecycle of its own, cascades with its
/// parent — the same shape as InventoryReceiptLine and VendorBillLine.
model InventoryConsumptionLine {
  id                     String   @id @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  inventoryConsumptionId String   @map("inventory_consumption_id") @db.Uuid
  inventoryItemId        String   @map("inventory_item_id") @db.Uuid
  sequence               Int
  quantity               Decimal  @db.Decimal(19, 4)
  /// The ruling weighted average at the moment this line was posted.
  unitCostAmount         Decimal  @map("unit_cost_amount") @db.Decimal(19, 4)
  /// quantity x unitCostAmount, EXCEPT on a full depletion, where it is the
  /// entire residual balance value so no paise is stranded against zero
  /// quantity (ADR-092 point 3). Always the exact figure posted.
  lineValueAmount        Decimal  @map("line_value_amount") @db.Decimal(19, 4)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  inventoryConsumption InventoryConsumption @relation(fields: [inventoryConsumptionId], references: [id], onDelete: Cascade, map: "fk_inventory_consumption_lines_consumption")
  inventoryItem        InventoryItem        @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], map: "fk_inventory_consumption_lines_item_org_consistent")

  @@index([inventoryConsumptionId], map: "idx_inventory_consumption_lines_consumption")
  @@index([inventoryItemId], map: "idx_inventory_consumption_lines_item")
  @@map("inventory_consumption_lines")
}

enum SalaryImportStatus {
  /// Generated but not yet committed — no journal exists yet (ADR-098).
  DRAFT
  POSTED
  REVERSED
}

enum SalaryPaymentStatus {
  POSTED
  REVERSED
}

/// An employee's gross salary, with the period it applies to (Phase 7
/// integration, ADR-098).
///
/// This is the compensation history ADR-047 explicitly deferred "to when
/// Salary Import is built". Before it, `Employee.displayedSalaryAmount` was
/// a single mutable figure with no history, and every month's payroll had
/// to be re-uploaded by hand even when nothing had changed.
///
/// Revising does NOT edit a row: the open revision is closed by setting
/// `effectiveTo`, and a new open row is inserted — the same append-and-
/// supersede posture `RecurringCycle` uses, so the history of what someone
/// earned when is never rewritten.
///
/// At most one OPEN revision per employee, enforced by a hand-added PARTIAL
/// unique index (`WHERE effective_to IS NULL`) — Prisma cannot express a
/// filtered unique, the same reason `uq_financial_years_one_current` and
/// `uq_salary_imports_entity_month_posted` are hand-written.
///
/// `effectiveFrom`/`effectiveTo` rather than the house `startDate`/`endDate`:
/// "effective from" is the domain term for a compensation revision, and the
/// distinction from a mere date range is the point of the model.
model EmployeeSalaryRevision {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  grossAmount    Decimal   @map("gross_amount") @db.Decimal(19, 4)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  /// Null means "current". Set when a later revision supersedes this one.
  effectiveTo    DateTime? @map("effective_to") @db.Date
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  employee Employee @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_employee_salary_revisions_employee_org_consistent")

  @@index([organizationId, employeeId, effectiveFrom], map: "idx_employee_salary_revisions_employee_from")
  @@map("employee_salary_revisions")
}

/// One month's imported gross salary for one legal entity (Phase 7.4,
/// ADR-094) — docs/04 §13's `employee-salary-upload.html`: "Import monthly
/// gross salary only ... preview before atomic commit. Preserve source
/// file/checksum and audit batch."
///
/// This model, not `Employee.displayedSalaryAmount`, is the historical
/// costing authority (docs/16 §7.6: "Imported monthly gross salary is the
/// historical costing source"). The Employee field is a current-state
/// display figure that may be edited at any time; a batch is a permanent
/// record of what a month actually cost, and Slice 7.6's project manpower
/// cost multiplies THIS figure by the allocation percentage.
///
/// Only gross salary is imported. Deductions, net pay, PF/ESI and payslips
/// are out of scope — docs/00 excludes payroll processing outright, and
/// docs/06 gives no posting rule for any of it.
///
/// One POSTED batch per legal entity per month, enforced by a hand-added
/// PARTIAL unique index (WHERE status = 'POSTED') rather than a plain
/// composite unique: reversing a batch must free the month for a corrected
/// re-import, which a total unique index would block forever.
model SalaryImport {
  id                     String             @id @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  legalEntityId          String             @map("legal_entity_id") @db.Uuid
  /// Always the first day of the month being imported — the month is the
  /// identity of the batch, so it is normalised on write rather than
  /// trusted from the client.
  salaryMonth            DateTime           @map("salary_month") @db.Date
  /// The date the cost is recognised, which is normally month-end but is
  /// captured separately because it is what resolves the accounting period.
  accountingDate         DateTime           @map("accounting_date") @db.Date
  /// Provenance of the upload, kept so a posted month can always be traced
  /// back to the file it came from (docs/04 §13). The checksum is of the
  /// parsed rows, so re-uploading the same sheet is detectable even if the
  /// filename changed.
  sourceFileName         String?            @map("source_file_name")
  sourceChecksum         String?            @map("source_checksum")
  employeeCount          Int                @map("employee_count")
  totalGrossAmount       Decimal            @map("total_gross_amount") @db.Decimal(19, 4)
  status                 SalaryImportStatus @default(DRAFT)
  /// Null only while the batch is a DRAFT — committing posts the journal
  /// and stamps it. A CHECK enforces the pairing (ADR-098).
  journalEntryId         String?            @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?            @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?          @map("reversed_at") @db.Timestamptz
  reversedBy             String?            @map("reversed_by") @db.Uuid
  reversalReason         String?            @map("reversal_reason")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?            @map("created_by") @db.Uuid
  updatedAt              DateTime           @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?            @map("updated_by") @db.Uuid
  version                Int                @default(1)

  legalEntity LegalEntity        @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_salary_imports_legal_entity_org_consistent")
  lines       SalaryImportLine[]
  payments    SalaryPayment[]

  @@unique([id, organizationId], map: "uq_salary_imports_id_org")
  @@index([organizationId, salaryMonth], map: "idx_salary_imports_org_month")
  @@index([organizationId, status], map: "idx_salary_imports_org_status")
  @@map("salary_imports")
}

/// One employee's gross salary for the imported month.
///
/// `employeeCodeRaw`/`employeeNameRaw` keep the file's own text alongside
/// the resolved FK. Matching is by employee code, and the raw values are
/// what make an import auditable after the fact — including when an
/// employee is later renamed.
model SalaryImportLine {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  salaryImportId    String   @map("salary_import_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  employeeCodeRaw   String   @map("employee_code_raw")
  employeeNameRaw   String?  @map("employee_name_raw")
  grossSalaryAmount Decimal  @map("gross_salary_amount") @db.Decimal(19, 4)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  salaryImport SalaryImport @relation(fields: [salaryImportId], references: [id], onDelete: Cascade, map: "fk_salary_import_lines_import")
  employee     Employee     @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_salary_import_lines_employee_org_consistent")

  /// One row per employee per batch — the database's own answer to
  /// docs/04 §13's "validate ... duplicates".
  @@unique([salaryImportId, employeeId], map: "uq_salary_import_lines_import_employee")
  @@index([organizationId, employeeId], map: "idx_salary_import_lines_org_employee")
  @@index([salaryImportId], map: "idx_salary_import_lines_import")
  @@map("salary_import_lines")
}

/// Settlement of a posted salary month (ADR-100).
///
/// The import recognises the cost and the liability; nothing in Phase 7
/// discharged it, so `SALARY_PAYABLE` was credit-only and grew forever. This
/// is the debit side: a bank disbursement of the same shape as the vendor
/// and introducer payments that already exist.
///
/// Deliberately per-month, not per-employee. The payable's journal lines
/// carry `employeeId`, so per-employee settlement stays possible later, but
/// salary leaves the bank as one transfer and per-employee entry would be
/// data entry with no decision in it.
///
/// This is settlement, not payroll processing: attendance, leave and the
/// computation of pay remain out of scope per docs/00.
model SalaryPayment {
  id                     String              @id @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  legalEntityId          String              @map("legal_entity_id") @db.Uuid
  /// The month being settled. A payment always discharges one posted import,
  /// which is what makes "how much of this month is still owed" answerable.
  salaryImportId         String              @map("salary_import_id") @db.Uuid
  bankAccountId          String              @map("bank_account_id") @db.Uuid
  paymentNumber          String              @map("payment_number")
  paymentDate            DateTime            @map("payment_date") @db.Date
  paymentModeId          String?             @map("payment_mode_id") @db.Uuid
  referenceNumber        String?             @map("reference_number")
  /// The payable discharged. Always equals tdsAmount + netAmount, enforced by
  /// a CHECK — the two are what left the organization, split by destination.
  grossAmount            Decimal             @map("gross_amount") @db.Decimal(19, 4)
  /// Withheld rather than paid: it stays a liability, moved from Salary
  /// Payable to TDS Payable rather than discharged.
  tdsAmount              Decimal             @default(0) @map("tds_amount") @db.Decimal(19, 4)
  netAmount              Decimal             @map("net_amount") @db.Decimal(19, 4)
  narrative              String?
  status                 SalaryPaymentStatus @default(POSTED)
  journalEntryId         String              @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?             @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?           @map("reversed_at") @db.Timestamptz
  reversedBy             String?             @map("reversed_by") @db.Uuid
  reversalReason         String?             @map("reversal_reason")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?             @map("created_by") @db.Uuid
  updatedAt              DateTime            @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?             @map("updated_by") @db.Uuid
  version                Int                 @default(1)

  legalEntity  LegalEntity  @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_salary_payments_legal_entity_org_consistent")
  salaryImport SalaryImport @relation(fields: [salaryImportId, organizationId], references: [id, organizationId], map: "fk_salary_payments_import_org_consistent")
  bankAccount  BankAccount  @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_salary_payments_bank_account_org_consistent")
  paymentMode  PaymentMode? @relation(fields: [paymentModeId], references: [id], map: "fk_salary_payments_payment_mode")

  lines SalaryPaymentLine[]

  @@unique([organizationId, paymentNumber], map: "uq_salary_payments_org_number")
  @@unique([id, organizationId], map: "uq_salary_payments_id_org")
  @@index([organizationId, status], map: "idx_salary_payments_org_status")
  @@index([salaryImportId], map: "idx_salary_payments_import")
  @@map("salary_payments")
}

/// What one employee was actually paid out of a salary payment (ADR-101).
///
/// Salary does not leave the bank as one anonymous figure -- each person is
/// credited separately and each credit carries its own UTR. The month's
/// import already credits Salary Payable one line PER employee; this is the
/// matching debit, so "what is still owed to this person" is answerable from
/// both sides of the ledger rather than only the credit side.
///
/// `referenceNumber` is per line because that is where a UTR actually
/// belongs. The payment header keeps its own optional reference for the case
/// where one bulk file was uploaded to the bank.
model SalaryPaymentLine {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  salaryPaymentId String   @map("salary_payment_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  /// The payable relieved for this employee. Always tdsAmount plus the net
  /// that actually reached them.
  paidAmount      Decimal  @map("paid_amount") @db.Decimal(19, 4)
  tdsAmount       Decimal  @default(0) @map("tds_amount") @db.Decimal(19, 4)
  referenceNumber String?  @map("reference_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment  SalaryPayment @relation(fields: [salaryPaymentId], references: [id], onDelete: Cascade, map: "fk_salary_payment_lines_payment")
  employee Employee      @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_salary_payment_lines_employee_org_consistent")

  /// One row per (payment, employee) -- two rows would be one person paid
  /// twice in the same transfer, and would double-count against what they
  /// are owed.
  @@unique([salaryPaymentId, employeeId], map: "uq_salary_payment_lines_payment_employee")
  @@index([organizationId, employeeId], map: "idx_salary_payment_lines_org_employee")
  @@index([salaryPaymentId], map: "idx_salary_payment_lines_payment")
  @@map("salary_payment_lines")
}

/// Where an employee's month can go when it is not a project (Phase 7.5,
/// ADR-095) — docs/16 §7.6's "approved internal/bench targets".
///
/// A generic `MasterTypeKey` (the 16th), because it is genuinely flat: code,
/// name, description, sort order, active. It deliberately carries no ledger
/// account and no rate, because allocation posts NO journal at all (docs/06:
/// allocation moves cost "analytically ... without changing total salary
/// expense") — there is nothing for an account on this row to be used for,
/// and adding one would imply a posting that must never happen.
model AllocationTarget {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  allocationLines EmployeeAllocationLine[]

  @@unique([organizationId, code], map: "uq_allocation_targets_org_code")
  @@unique([id, organizationId], map: "uq_allocation_targets_id_org")
  @@map("allocation_targets")
}

enum EmployeeAllocationStatus {
  DRAFT
  SUBMITTED
}

/// One employee's month, allocated across projects and non-project targets
/// (Phase 7.5, ADR-095).
///
/// This is docs/04 §13's MERGE of `employee-effort-entry.html` and
/// `employee-contribution-entry.html` into one record: there is exactly one
/// percentage truth per employee-month, never two.
///
/// **Posts no journal, ever.** docs/06: allocation "moves cost analytically
/// to project/non-project dimensions without changing total salary expense."
/// The total salary expense is the salary import's (ADR-094); this record
/// only says how to attribute it. Project manpower cost is therefore a
/// derived read (imported gross x percentage), never a stored or posted
/// figure — which is also why nothing here is versioned as a posted
/// document with a reversal.
///
/// Lines must total exactly 100% to move to SUBMITTED — Phase 7's own exit
/// criterion, "Submitted employee allocations total 100%". A DRAFT may hold
/// any total, including zero, so a part-filled month can be saved.
model EmployeeMonthlyAllocation {
  id              String                   @id @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  employeeId      String                   @map("employee_id") @db.Uuid
  /// Always the first day of the month, normalised on write — the month is
  /// part of this record's identity.
  allocationMonth DateTime                 @map("allocation_month") @db.Date
  status          EmployeeAllocationStatus @default(DRAFT)
  note            String?
  submittedAt     DateTime?                @map("submitted_at") @db.Timestamptz
  submittedBy     String?                  @map("submitted_by") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?                  @map("created_by") @db.Uuid
  updatedAt       DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?                  @map("updated_by") @db.Uuid
  version         Int                      @default(1)

  employee Employee                 @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_employee_allocations_employee_org_consistent")
  lines    EmployeeAllocationLine[]

  /// One allocation per employee per month — the single percentage truth.
  @@unique([organizationId, employeeId, allocationMonth], map: "uq_employee_allocations_employee_month")
  @@unique([id, organizationId], map: "uq_employee_allocations_id_org")
  @@index([organizationId, allocationMonth], map: "idx_employee_allocations_org_month")
  @@index([organizationId, status], map: "idx_employee_allocations_org_status")
  @@map("employee_monthly_allocations")
}

/// One share of one employee's month.
///
/// A line targets EITHER a project OR a non-project allocation target,
/// never both and never neither — enforced by a CHECK, the same either/or
/// shape `VendorBillLine` uses for expense-vs-inventory (ADR-092).
///
/// `contributionNote` is where `employee-contribution-entry.html`'s useful
/// content lands (docs/04 §13 RETIRE: "merge useful contribution notes/
/// metrics into the canonical monthly allocation screen") — as a note on
/// the row that already owns the percentage, not as a second record with a
/// percentage of its own.
model EmployeeAllocationLine {
  id                          String   @id @db.Uuid
  organizationId              String   @map("organization_id") @db.Uuid
  employeeMonthlyAllocationId String   @map("employee_monthly_allocation_id") @db.Uuid
  projectId                   String?  @map("project_id") @db.Uuid
  allocationTargetId          String?  @map("allocation_target_id") @db.Uuid
  sequence                    Int
  /// 4 decimal places so a three-way split can be expressed exactly enough
  /// to sum to 100; the money rounding that follows from it is handled
  /// deterministically when cost is derived, never here.
  percentage                  Decimal  @db.Decimal(9, 4)
  contributionNote            String?  @map("contribution_note")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz

  allocation       EmployeeMonthlyAllocation @relation(fields: [employeeMonthlyAllocationId], references: [id], onDelete: Cascade, map: "fk_employee_allocation_lines_allocation")
  project          Project?                  @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_employee_allocation_lines_project_org_consistent")
  allocationTarget AllocationTarget?         @relation(fields: [allocationTargetId, organizationId], references: [id, organizationId], map: "fk_employee_allocation_lines_target_org_consistent")

  @@index([employeeMonthlyAllocationId], map: "idx_employee_allocation_lines_allocation")
  @@index([organizationId, projectId], map: "idx_employee_allocation_lines_org_project")
  @@map("employee_allocation_lines")
}

enum IntroducerCommissionBasis {
  PERCENT_OF_PROJECT_VALUE
  FIXED_AMOUNT
}

enum IntroducerDocumentStatus {
  POSTED
  REVERSED
}

/// What one introducer is owed on one project (Phase 7.6, ADR-096) —
/// docs/04 §15's `introducer-fee-add.html`: "define basis/rate/amount
/// explicitly", and "multiple introducers" per project.
///
/// The agreement itself posts NOTHING. docs/06 gives introducer accrual its
/// own journal (Dr Commission Expense; Cr Introducer Payable) and says
/// nothing about an agreement, because an agreement is an entitlement, not
/// an event — the commission becomes a liability when it is accrued, which
/// is a separate, deliberately manual act (confirmed during Phase 7
/// planning, ADR-091).
///
/// Basis is explicit rather than inferred: PERCENT_OF_PROJECT_VALUE carries
/// a rate and derives its entitlement from `Project.value`, FIXED_AMOUNT
/// carries the figure outright. A CHECK enforces that exactly the right one
/// of the two columns is populated, so a percent agreement can never also
/// hold a contradictory fixed figure.
model IntroducerAgreement {
  id             String                    @id @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  introducerId   String                    @map("introducer_id") @db.Uuid
  projectId      String                    @map("project_id") @db.Uuid
  legalEntityId  String                    @map("legal_entity_id") @db.Uuid
  basisType      IntroducerCommissionBasis @map("basis_type")
  /// Set only for PERCENT_OF_PROJECT_VALUE. 4dp because a commission rate
  /// is genuinely quoted in fractions of a percent.
  ratePercent    Decimal?                  @map("rate_percent") @db.Decimal(9, 4)
  /// Set only for FIXED_AMOUNT.
  fixedAmount    Decimal?                  @map("fixed_amount") @db.Decimal(19, 4)
  agreementDate  DateTime                  @map("agreement_date") @db.Date
  remarks        String?
  isActive       Boolean                   @default(true) @map("is_active")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?                   @map("created_by") @db.Uuid
  updatedAt      DateTime                  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?                   @map("updated_by") @db.Uuid
  version        Int                       @default(1)

  introducer  Introducer          @relation(fields: [introducerId, organizationId], references: [id, organizationId], map: "fk_introducer_agreements_introducer_org_consistent")
  project     Project             @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_introducer_agreements_project_org_consistent")
  legalEntity LegalEntity         @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_introducer_agreements_legal_entity_org_consistent")
  accruals    IntroducerAccrual[]

  /// One agreement per introducer per project — several introducers on one
  /// project is expected (docs/04 §15), the same introducer twice on one
  /// project is one entitlement entered twice.
  @@unique([organizationId, projectId, introducerId], map: "uq_introducer_agreements_project_introducer")
  @@unique([id, organizationId], map: "uq_introducer_agreements_id_org")
  @@index([organizationId, introducerId], map: "idx_introducer_agreements_org_introducer")
  @@map("introducer_agreements")
}

/// Recognising commission as a liability — docs/06's "Introducer / Accrual":
/// Dr Introducer Commission Expense; Cr Introducer Payable.
///
/// Deliberately a separate manual act rather than an automatic consequence
/// of the agreement: the point at which commission is earned is a business
/// judgement (work order, first receipt, completion) that docs/00 does not
/// fix, so inventing a trigger would invent an accounting policy. Several
/// accruals may be posted against one agreement — a staged commission is
/// normal — and the service caps their cumulative total at the agreement's
/// entitlement whenever that is derivable.
///
/// Append-only in the same sense as every other posted document here: a
/// mistake is corrected by reversal, never by edit.
model IntroducerAccrual {
  id                     String                   @id @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  introducerAgreementId  String                   @map("introducer_agreement_id") @db.Uuid
  accrualNumber          String                   @map("accrual_number")
  accrualDate            DateTime                 @map("accrual_date") @db.Date
  amount                 Decimal                  @db.Decimal(19, 4)
  narrative              String?
  status                 IntroducerDocumentStatus @default(POSTED)
  journalEntryId         String                   @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?                  @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?                @map("reversed_at") @db.Timestamptz
  reversedBy             String?                  @map("reversed_by") @db.Uuid
  reversalReason         String?                  @map("reversal_reason")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?                  @map("created_by") @db.Uuid
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?                  @map("updated_by") @db.Uuid
  version                Int                      @default(1)

  agreement   IntroducerAgreement           @relation(fields: [introducerAgreementId, organizationId], references: [id, organizationId], map: "fk_introducer_accruals_agreement_org_consistent")
  allocations IntroducerPaymentAllocation[]

  @@unique([organizationId, accrualNumber], map: "uq_introducer_accruals_org_number")
  @@unique([id, organizationId], map: "uq_introducer_accruals_id_org")
  @@index([organizationId, status], map: "idx_introducer_accruals_org_status")
  @@index([introducerAgreementId], map: "idx_introducer_accruals_agreement")
  @@map("introducer_accruals")
}

/// Settling an introducer — docs/04 §15's `introducer-fee-payment.html`:
/// "select payment source by mode, record TDS and allocate one/more
/// accruals. Excess becomes unallocated introducer advance, not negative
/// payable."
///
/// That last clause is the load-bearing one. Paying more than is currently
/// accrued is a real and ordinary thing; representing it by driving the
/// payable negative would make "what do we owe introducers" wrong for every
/// reader. It is instead debited to Introducer Advance Receivable, exactly
/// as docs/06 requires ("excess payment posts to Introducer Advance
/// Receivable") and mirroring how EmployeeAdvance is already handled.
///
/// The journal is a vendor-style payable settlement:
///   Dr Introducer Payable            (total allocated to accruals)
///   Dr Introducer Advance Receivable (unallocated excess, if any)
///     Cr TDS Payable                 (tax withheld, if any)
///     Cr Bank                        (net actually paid)
model IntroducerPayment {
  id                     String                   @id @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  introducerId           String                   @map("introducer_id") @db.Uuid
  legalEntityId          String                   @map("legal_entity_id") @db.Uuid
  bankAccountId          String                   @map("bank_account_id") @db.Uuid
  paymentNumber          String                   @map("payment_number")
  paymentDate            DateTime                 @map("payment_date") @db.Date
  paymentModeId          String?                  @map("payment_mode_id") @db.Uuid
  referenceNumber        String?                  @map("reference_number")
  /// The full amount settled: allocations plus any advance. Always equals
  /// tdsAmount + netAmount.
  grossAmount            Decimal                  @map("gross_amount") @db.Decimal(19, 4)
  tdsAmount              Decimal                  @default(0) @map("tds_amount") @db.Decimal(19, 4)
  netAmount              Decimal                  @map("net_amount") @db.Decimal(19, 4)
  /// The part of gross that matched no accrual — becomes a receivable, never
  /// a negative payable.
  advanceAmount          Decimal                  @default(0) @map("advance_amount") @db.Decimal(19, 4)
  narrative              String?
  status                 IntroducerDocumentStatus @default(POSTED)
  journalEntryId         String                   @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?                  @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?                @map("reversed_at") @db.Timestamptz
  reversedBy             String?                  @map("reversed_by") @db.Uuid
  reversalReason         String?                  @map("reversal_reason")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?                  @map("created_by") @db.Uuid
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?                  @map("updated_by") @db.Uuid
  version                Int                      @default(1)

  introducer  Introducer                    @relation(fields: [introducerId, organizationId], references: [id, organizationId], map: "fk_introducer_payments_introducer_org_consistent")
  legalEntity LegalEntity                   @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_introducer_payments_legal_entity_org_consistent")
  bankAccount BankAccount                   @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_introducer_payments_bank_account_org_consistent")
  paymentMode PaymentMode?                  @relation(fields: [paymentModeId], references: [id], map: "fk_introducer_payments_payment_mode")
  allocations IntroducerPaymentAllocation[]

  @@unique([organizationId, paymentNumber], map: "uq_introducer_payments_org_number")
  @@unique([id, organizationId], map: "uq_introducer_payments_id_org")
  @@index([organizationId, status], map: "idx_introducer_payments_org_status")
  @@index([organizationId, introducerId], map: "idx_introducer_payments_org_introducer")
  @@map("introducer_payments")
}

/// How much of one payment settled one accrual. The same shape
/// VendorPaymentAllocation uses: a payment may settle several accruals and
/// an accrual may be settled by several payments.
model IntroducerPaymentAllocation {
  id                  String   @id @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  introducerPaymentId String   @map("introducer_payment_id") @db.Uuid
  introducerAccrualId String   @map("introducer_accrual_id") @db.Uuid
  allocatedAmount     Decimal  @map("allocated_amount") @db.Decimal(19, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment IntroducerPayment @relation(fields: [introducerPaymentId], references: [id], onDelete: Cascade, map: "fk_introducer_payment_allocations_payment")
  accrual IntroducerAccrual @relation(fields: [introducerAccrualId, organizationId], references: [id, organizationId], map: "fk_introducer_payment_allocations_accrual_org_consistent")

  /// One row per (payment, accrual) pair — two rows would be one allocation
  /// entered twice, and would double-count against the accrual's balance.
  @@unique([introducerPaymentId, introducerAccrualId], map: "uq_introducer_payment_allocations_payment_accrual")
  @@index([introducerAccrualId], map: "idx_introducer_payment_allocations_accrual")
  @@map("introducer_payment_allocations")
}

/// Organization-scoped flat lookup master, Administrator-created, flat.
/// basisType is a plain text/enum field (no ledger-account linkage in
/// Phase 2), which is why this table is NOT part of the generic masters API
/// — it carries one field beyond the shared common baseline. Phase 5.2
/// (Receipt) adds accepted/disputed ledger-account overrides — both
/// nullable, per docs/04's master-penalty-category.html note ("accepted/
/// disputed accounting accounts are configured separately"); ReceiptsService
/// falls back to a default account when a category leaves either unset,
/// same nullable-with-fallback shape as SecurityInstrumentPurpose's own
/// defaultRecoverableLedgerAccountId (Slice 4.5).
model PenaltyCategory {
  id                      String    @id @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  code                    String
  name                    String
  description             String?
  basisType               String?   @map("basis_type")
  acceptedLedgerAccountId String?   @map("accepted_ledger_account_id") @db.Uuid
  disputedLedgerAccountId String?   @map("disputed_ledger_account_id") @db.Uuid
  sortOrder               Int       @default(0) @map("sort_order")
  isActive                Boolean   @default(true) @map("is_active")
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy               String?   @map("deleted_by") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy               String?   @map("created_by") @db.Uuid
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy               String?   @map("updated_by") @db.Uuid
  version                 Int       @default(1)

  acceptedLedgerAccount LedgerAccount?        @relation("PenaltyCategoryAcceptedLedgerAccount", fields: [acceptedLedgerAccountId, organizationId], references: [id, organizationId], map: "fk_penalty_categories_accepted_ledger_account_org_consistent")
  disputedLedgerAccount LedgerAccount?        @relation("PenaltyCategoryDisputedLedgerAccount", fields: [disputedLedgerAccountId, organizationId], references: [id, organizationId], map: "fk_penalty_categories_disputed_ledger_account_org_consistent")
  allocationDeductions  AllocationDeduction[]

  @@unique([organizationId, code], map: "uq_penalty_categories_org_code")
  @@unique([id, organizationId], map: "uq_penalty_categories_id_org")
  @@map("penalty_categories")
}

/// System-seeded, global catalogue — no organization_id. Administrator edits
/// are limited to label/sort_order/is_active; `code` is immutable once a
/// later-phase table references it (app-layer enforced — no such reference
/// exists yet in Phase 2). No created_by/updated_by: system-seeded, and
/// admin edits are tracked via audit_events instead.
model PaymentMode {
  id                      String              @id @db.Uuid
  code                    String              @unique(map: "uq_payment_modes_code")
  label                   String
  sortOrder               Int                 @default(0) @map("sort_order")
  isActive                Boolean             @default(true) @map("is_active")
  requiresReferenceNumber Boolean             @default(false) @map("requires_reference_number")
  requiresBankSource      Boolean             @default(false) @map("requires_bank_source")
  requiresCardSource      Boolean             @default(false) @map("requires_card_source")
  isCashLike              Boolean             @default(false) @map("is_cash_like")
  isElectronic            Boolean             @default(false) @map("is_electronic")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @default(now()) @map("updated_at") @db.Timestamptz
  version                 Int                 @default(1)
  clientReceipts          ClientReceipt[]
  vendorPayments          VendorPayment[]
  employeeAdvances        EmployeeAdvance[]
  directExpenses          DirectExpense[]
  introducerPayments      IntroducerPayment[]
  salaryPayments          SalaryPayment[]

  @@map("payment_modes")
}

/// System-managed — created via the upload flow (initiateUpload creates this
/// row PENDING_UPLOAD with the client-declared size/checksum; confirmUpload
/// flips it to UPLOADED once the client reports the presigned PUT
/// succeeded). document_group_id is self-generated on first upload and
/// groups later versions of "the same logical file" (a new document row per
/// version, not an update to this one — this row's own `version` column is
/// plain optimistic concurrency on THIS row, unrelated to file versioning).
/// documentCategoryId classifies the document itself (e.g. "Tender Notice",
/// "GST Certificate"); DocumentLink.entityType is the separate concern of
/// which business entity the document is attached to. A link's entityType
/// must be validated (in the service layer) against
/// document_category_entity_types for the document's category — no row for
/// that category means it applies to every entity type.
model Document {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  documentCategoryId String?   @map("document_category_id") @db.Uuid
  documentGroupId    String    @map("document_group_id") @db.Uuid
  storageKey         String    @unique(map: "uq_documents_storage_key") @map("storage_key")
  originalFilename   String    @map("original_filename")
  contentType        String    @map("content_type")
  sizeBytes          BigInt    @map("size_bytes")
  checksum           String
  uploadedBy         String    @map("uploaded_by") @db.Uuid
  uploadedAt         DateTime? @map("uploaded_at") @db.Timestamptz
  status             String    @default("PENDING_UPLOAD")
  // Client-side AES-256-GCM encryption (Web Crypto API) — the server never
  // receives, stores, or verifies the password. isEncrypted just means the
  // S3 object body is ciphertext; encryptionSalt/encryptionIv are the
  // (non-secret) PBKDF2 salt and AES-GCM IV needed to re-derive the same
  // key given the correct password. A wrong password fails GCM's auth-tag
  // check client-side — that failure IS the password verification; there
  // is no server-side recovery path, ever, for anyone, by design.
  isEncrypted        Boolean   @default(false) @map("is_encrypted")
  encryptionSalt     String?   @map("encryption_salt")
  encryptionIv       String?   @map("encryption_iv")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  version            Int       @default(1)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy          String?   @map("deleted_by") @db.Uuid

  // Composite FK (document_category_id, organization_id) ->
  // document_categories(id, organization_id): when a category is selected,
  // it must belong to the SAME organization as this document. Trivially
  // satisfied when documentCategoryId is NULL (no category selected yet).
  documentCategory DocumentCategory? @relation(fields: [documentCategoryId, organizationId], references: [id, organizationId], map: "fk_documents_category_org_consistent")
  links            DocumentLink[]

  // Composite-unique support constraint letting document_links enforce
  // organization consistency via a real composite FK.
  @@unique([id, organizationId], map: "uq_documents_id_org")
  @@index([documentGroupId], map: "idx_documents_document_group_id")
  @@map("documents")
}

/// System-managed. entity_type is a real FK to entity_types.code (typed,
/// not free text).
model DocumentLink {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  linkType       String?  @map("link_type")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  // Composite FK enforces the linked document belongs to this organization.
  // entityTypeRef stays a plain FK — EntityType is a global fixed reference
  // with no organization_id to cross-check.
  document      Document   @relation(fields: [documentId, organizationId], references: [id, organizationId], map: "fk_document_links_document_org_consistent")
  entityTypeRef EntityType @relation(fields: [entityType], references: [code], map: "document_links_entity_type_fkey")

  @@index([entityType, entityId], map: "idx_document_links_entity")
  @@index([documentId], map: "idx_document_links_document_id")
  @@map("document_links")
}

model IdempotencyKey {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  commandType      String   @map("command_type")
  idempotencyKey   String   @map("idempotency_key")
  requestHash      String   @map("request_hash")
  sourceRecordType String?  @map("source_record_type")
  sourceRecordId   String?  @map("source_record_id") @db.Uuid
  resultReference  Json?    @map("result_reference")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, commandType, idempotencyKey], map: "uq_idempotency_keys_org_command_key")
  @@map("idempotency_keys")
}

// Phase 3 sub-phase 3.1 — CRM: Party/Client foundation. See
// docs/12-decisions-log.md ADR-053 for the Party/ClientProfile split
// rationale and the ClientType-vs-GovernmentBodyType decision.

/// Organization-scoped flat lookup master, Administrator-created. Distinct
/// from GovernmentBodyType (classifies government bodies generically,
/// used elsewhere) — ClientType classifies the client *relationship*,
/// including non-government "Private" clients.
model ClientType {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  clientProfiles ClientProfile[]

  @@unique([organizationId, code], map: "uq_client_types_org_code")
  @@map("client_types")
}

/// Generic counterparty identity, layered by role-specific profiles
/// (ClientProfile, VendorProfile — Phase 6.1; a future IntroducerProfile
/// could layer on too). A Party may hold more than one active profile at
/// once (e.g. both a Client and a Vendor) — each profile's own isActive is
/// independent; Party.isActive is a separate, rarely-touched party-level
/// master switch, never flipped as a side effect of a single profile's own
/// setActive (see VendorProfile's doc comment). Holds a single embedded
/// address, matching client-add.html exactly (no multi-address UI exists
/// yet).
model Party {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  shortCode      String?   @map("short_code")
  stateId        String?   @map("state_id") @db.Uuid
  districtId     String?   @map("district_id") @db.Uuid
  cityId         String?   @map("city_id") @db.Uuid
  pinCode        String?   @map("pin_code")
  officeAddress  String?   @map("office_address")
  internalNote   String?   @map("internal_note")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  state                         State?               @relation(fields: [stateId], references: [id])
  district                      District?            @relation(fields: [districtId], references: [id])
  city                          City?                @relation(fields: [cityId], references: [id])
  clientProfile                 ClientProfile?
  vendorProfile                 VendorProfile?
  vendorBillsAsVendor           VendorBill[]
  paymentRequestsAsVendor       PaymentRequest[]
  directExpensesAsVendor        DirectExpense[]
  contacts                      Contact[]
  leads                         Lead[]
  tenders                       Tender[]
  projects                      Project[]
  journalLines                  JournalLine[]
  fundedSecurityInstruments     SecurityInstrument[] @relation("SecurityInstrumentFundingParty")
  returnedToSecurityInstruments SecurityInstrument[] @relation("SecurityInstrumentReturnParty")
  inventoryReceipts             InventoryReceipt[]
  tdsCertificates               TdsCertificate[]

  // Composite-unique support constraint letting client_profiles/contacts
  // enforce organization consistency via real composite FKs.
  @@unique([id, organizationId], map: "uq_parties_id_org")
  @@index([organizationId], map: "idx_parties_organization_id")
  @@map("parties")
}

/// Client-specific attributes layered on a Party. 1:1 today (only Client
/// profiles exist); the split keeps Party reusable for a future Vendor or
/// Introducer profile without a migration. A client's GSTIN is optional
/// text, stored as entered (ADR-130).
model ClientProfile {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  partyId        String    @map("party_id") @db.Uuid
  clientTypeId   String?   @map("client_type_id") @db.Uuid
  department     String?
  gstin          String?
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  party      Party       @relation(fields: [partyId, organizationId], references: [id, organizationId], map: "fk_client_profiles_party_org_consistent")
  clientType ClientType? @relation(fields: [clientTypeId], references: [id])

  @@unique([partyId, organizationId], map: "uq_client_profiles_party_id_org")
  @@index([organizationId], map: "idx_client_profiles_organization_id")
  @@map("client_profiles")
}

/// Fixed payment-term options offered on a vendor (master-vendor.html) —
/// a controlled enum, not free text, per Phase 6.1 (ADR).
enum VendorPaymentTerms {
  ADVANCE
  NET_15
  NET_30
  NET_45
}

/// Vendor-specific attributes layered on a Party — the second profile type
/// ClientProfile's own doc comment anticipated. A Party may now hold both an
/// active ClientProfile and an active VendorProfile independently: isActive
/// here governs ONLY the vendor role. Party.isActive is a separate,
/// party-level master switch, never flipped as a side effect of a single
/// profile's own setActive (Phase 6.1 fix — see VendorsService/
/// ClientsService). Selectability as a vendor requires
/// party.isActive AND vendorProfile.isActive, checked together everywhere
/// this profile is read. gstin/panNumber are normalized (uppercased,
/// trimmed) before every write and comparison — chk_vendor_profiles_gstin_
/// format/chk_vendor_profiles_pan_format (statutory GSTIN regex and a
/// 10-char PAN pattern) and the partial-unique
/// uq_vendor_profiles_org_gstin (WHERE gstin IS NOT NULL AND
/// deleted_at IS NULL) are hand-added in the migration SQL.
model VendorProfile {
  id             String              @id @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  partyId        String              @map("party_id") @db.Uuid
  gstin          String?
  panNumber      String?             @map("pan_number")
  paymentTerms   VendorPaymentTerms? @map("payment_terms")
  isActive       Boolean             @default(true) @map("is_active")
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz
  deletedBy      String?             @map("deleted_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?             @map("created_by") @db.Uuid
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?             @map("updated_by") @db.Uuid
  version        Int                 @default(1)

  party Party @relation(fields: [partyId, organizationId], references: [id, organizationId], map: "fk_vendor_profiles_party_org_consistent")

  @@unique([partyId, organizationId], map: "uq_vendor_profiles_party_id_org")
  @@index([organizationId], map: "idx_vendor_profiles_organization_id")
  @@map("vendor_profiles")
}

/// Repeatable contact person on a Party (client-add.html's "add another
/// contact" rows). No independent lifecycle beyond its parent Party — no
/// soft-delete/version, edited as a set within the parent's own update.
model Contact {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  partyId        String   @map("party_id") @db.Uuid
  name           String
  designation    String?
  phone          String?
  email          String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid

  party Party @relation(fields: [partyId, organizationId], references: [id, organizationId], map: "fk_contacts_party_org_consistent")

  @@index([partyId], map: "idx_contacts_party_id")
  @@map("contacts")
}

/// Minimal, deliberately bare introducer identity for Phase 3 Slice 2
/// (Leads) to hang a real FK off — not the full Party+IntroducerProfile
/// entity (PAN, payout mode/detail, masked sensitive values) that
/// 09-introducer-fee/master-introducer.html and Phase 7's introducer
/// agreement/accrual/payment work will build. When Phase 7 builds that
/// real entity, this table's rows are promoted into it and
/// Lead.introducerId is repointed at the new Party.id — an accepted,
/// disclosed follow-up migration, not an oversight (see docs/12 decisions
/// log, Phase 3.2 Leads ADR).
model Introducer {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid
  version        Int      @default(1)

  leads      Lead[]
  projects   Project[]
  agreements IntroducerAgreement[]
  payments   IntroducerPayment[]

  // Supports the composite FK from Lead.introducerId.
  @@unique([id, organizationId], map: "uq_introducers_id_org")
  @@index([organizationId], map: "idx_introducers_organization_id")
  @@map("introducers")
}

/// CRM opportunity against a Client (a Party with a non-null
/// clientProfile — enforced at the application layer, not by this FK,
/// since a plain composite FK can't express "and has a client_profile
/// row"). No soft-delete/deactivate lifecycle this slice — a Lead simply
/// progresses through `stage` until TENDER_WON/TENDER_LOST (terminal);
/// lead-list.html's row actions are View/Edit only, unlike Client's
/// Deactivate/Reactivate. `stage` is validated as one of 7 values at the
/// application layer (Zod enum in the router), not a DB CHECK constraint —
/// consistent with how Document.status/Notification.status are handled
/// elsewhere in this schema. `estimatedValue` is explicitly non-accounting
/// data per docs/04's own contract text for lead-add.html.
model Lead {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  clientId             String    @map("client_id") @db.Uuid
  leadTypeId           String    @map("lead_type_id") @db.Uuid
  leadSourceId         String    @map("lead_source_id") @db.Uuid
  introducerId         String?   @map("introducer_id") @db.Uuid
  assignedToEmployeeId String?   @map("assigned_to_employee_id") @db.Uuid
  title                String
  description          String?
  stage                String    @default("PROPOSAL_SENT")
  estimatedValue       Decimal?  @map("estimated_value") @db.Decimal(19, 4)
  leadDate             DateTime  @map("lead_date") @db.Date
  expectedCloseDate    DateTime? @map("expected_close_date") @db.Date
  expectedTenderDate   DateTime? @map("expected_tender_date") @db.Date
  tenderNumber         String?   @map("tender_number")
  tenderDate           DateTime? @map("tender_date") @db.Date
  submissionDeadline   DateTime? @map("submission_deadline") @db.Date
  reminderOffset       String?   @map("reminder_offset")
  internalNote         String?   @map("internal_note")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String?   @map("created_by") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy            String?   @map("updated_by") @db.Uuid
  version              Int       @default(1)

  client             Party        @relation(fields: [clientId, organizationId], references: [id, organizationId], map: "fk_leads_client_org_consistent")
  leadType           LeadType     @relation(fields: [leadTypeId, organizationId], references: [id, organizationId], map: "fk_leads_lead_type_org_consistent")
  leadSource         LeadSource   @relation(fields: [leadSourceId, organizationId], references: [id, organizationId], map: "fk_leads_lead_source_org_consistent")
  introducer         Introducer?  @relation(fields: [introducerId, organizationId], references: [id, organizationId], map: "fk_leads_introducer_org_consistent")
  assignedToEmployee Employee?    @relation("LeadAssignedToEmployee", fields: [assignedToEmployeeId, organizationId], references: [id, organizationId], map: "fk_leads_assigned_employee_org_consistent")
  updates            LeadUpdate[]
  tenders            Tender[]
  projects           Project[]

  // Supports the composite FK from LeadUpdate.leadId and Documents'
  // entityType/entityId pairing (entityType='LEAD', already seeded).
  @@unique([id, organizationId], map: "uq_leads_id_org")
  @@index([organizationId], map: "idx_leads_organization_id")
  @@index([clientId], map: "idx_leads_client_id")
  @@map("leads")
}

/// Append-only timeline entry on a Lead (lead-view-updates.html). No
/// edit/delete path — corrections are new entries, matching audit_events'
/// own append-only philosophy and docs/04's "Corrections remain auditable"
/// contract text.
model LeadUpdate {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  title          String
  note           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  createdByEmail String?  @map("created_by_email")

  lead Lead @relation(fields: [leadId, organizationId], references: [id, organizationId], map: "fk_lead_updates_lead_org_consistent")

  @@index([leadId], map: "idx_lead_updates_lead_id")
  @@map("lead_updates")
}

/// Independent government-tender record against a Client (a Party with a
/// non-null clientProfile — same application-layer rule as Lead). Lead and
/// Tender are deliberately separate upstream records (ADR-006/docs/01) —
/// `leadId` is an optional, one-way origin reference, not a shared
/// lifecycle. Unlike Lead's single collapsed `stage`, this has two
/// orthogonal fields (mirrors Project's Stage/Operational-Status split,
/// ADR-007): `submissionStatus` is the bid-preparation pipeline,`result` is
/// the outcome. Both are Zod-enum-validated at the router layer, not a DB
/// CHECK constraint, matching Lead.stage's own precedent. No soft-delete/
/// deactivate lifecycle, mirroring Lead exactly — a Tender simply
/// progresses until a terminal result.
model Tender {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  clientId             String    @map("client_id") @db.Uuid
  leadId               String?   @map("lead_id") @db.Uuid
  tenderPortalId       String?   @map("tender_portal_id") @db.Uuid
  assignedToEmployeeId String?   @map("assigned_to_employee_id") @db.Uuid
  tenderNumber         String    @map("tender_number")
  title                String
  description          String?
  submissionStatus     String    @default("IDENTIFIED") @map("submission_status")
  result               String    @default("PENDING")
  estimatedValue       Decimal?  @map("estimated_value") @db.Decimal(19, 4)
  tenderDate           DateTime  @map("tender_date") @db.Date
  submissionDeadline   DateTime? @map("submission_deadline") @db.Date
  submittedDate        DateTime? @map("submitted_date") @db.Date
  resultDate           DateTime? @map("result_date") @db.Date
  reminderOffset       String?   @map("reminder_offset")
  internalNote         String?   @map("internal_note")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String?   @map("created_by") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy            String?   @map("updated_by") @db.Uuid
  version              Int       @default(1)

  client              Party                @relation(fields: [clientId, organizationId], references: [id, organizationId], map: "fk_tenders_client_org_consistent")
  lead                Lead?                @relation(fields: [leadId, organizationId], references: [id, organizationId], map: "fk_tenders_lead_org_consistent")
  tenderPortal        TenderPortal?        @relation(fields: [tenderPortalId, organizationId], references: [id, organizationId], map: "fk_tenders_tender_portal_org_consistent")
  assignedToEmployee  Employee?            @relation("TenderAssignedToEmployee", fields: [assignedToEmployeeId, organizationId], references: [id, organizationId], map: "fk_tenders_assigned_employee_org_consistent")
  updates             TenderUpdate[]
  projects            Project[]
  securityInstruments SecurityInstrument[]

  // Supports the composite FK from TenderUpdate.tenderId and Documents'
  // entityType/entityId pairing (entityType='TENDER', already seeded).
  @@unique([id, organizationId], map: "uq_tenders_id_org")
  @@index([organizationId], map: "idx_tenders_organization_id")
  @@index([clientId], map: "idx_tenders_client_id")
  @@map("tenders")
}

/// Append-only timeline entry on a Tender, identical shape/philosophy to
/// LeadUpdate. No edit/delete path — corrections are new entries.
model TenderUpdate {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tenderId       String   @map("tender_id") @db.Uuid
  title          String
  note           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  createdByEmail String?  @map("created_by_email")

  tender Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], map: "fk_tender_updates_tender_org_consistent")

  @@index([tenderId], map: "idx_tender_updates_tender_id")
  @@map("tender_updates")
}

/// A Project is created at WORK_STARTED. `stage` and
/// `operationalStatus` are deliberately separate orthogonal fields
/// (docs/05-workflows-state-machines.md), changed only via dedicated
/// changeStage/changeStatus commands (never the plain update mutation) —
/// unlike Lead/Tender's plain-field stage, backward stage movement and
/// cancellation require a `reason`, validated and audited by the service,
/// not a DB CHECK constraint. May reference a Lead, a Tender, or both
/// (independently nullable, no requirement that either be set). No soft-
/// delete/deactivate — retirement happens via the CANCELLED/CLOSED
/// terminal operationalStatus values, mirroring Lead/Tender's own
/// no-delete precedent.
model Project {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  legalEntityId     String    @map("legal_entity_id") @db.Uuid
  leadId            String?   @map("lead_id") @db.Uuid
  tenderId          String?   @map("tender_id") @db.Uuid
  projectManagerId  String?   @map("project_manager_id") @db.Uuid
  salesManagerId    String?   @map("sales_manager_id") @db.Uuid
  introducerId      String?   @map("introducer_id") @db.Uuid
  projectTypeId     String?   @map("project_type_id") @db.Uuid
  name              String
  description       String?
  stage             String    @default("WORK_STARTED")
  operationalStatus String    @default("ACTIVE") @map("operational_status")
  value             Decimal?  @db.Decimal(19, 4)
  budget            Decimal?  @db.Decimal(19, 4)
  gstApplicable     Boolean   @default(true) @map("gst_applicable")
  workOrderNumber   String?   @map("work_order_number")
  workOrderDate     DateTime? @map("work_order_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy         String?   @map("updated_by") @db.Uuid
  version           Int       @default(1)

  client                Party                    @relation(fields: [clientId, organizationId], references: [id, organizationId], map: "fk_projects_client_org_consistent")
  legalEntity           LegalEntity              @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_projects_legal_entity_org_consistent")
  lead                  Lead?                    @relation(fields: [leadId, organizationId], references: [id, organizationId], map: "fk_projects_lead_org_consistent")
  tender                Tender?                  @relation(fields: [tenderId, organizationId], references: [id, organizationId], map: "fk_projects_tender_org_consistent")
  projectManager        Employee?                @relation("ProjectManager", fields: [projectManagerId, organizationId], references: [id, organizationId], map: "fk_projects_manager_org_consistent")
  salesManager          Employee?                @relation("SalesManager", fields: [salesManagerId, organizationId], references: [id, organizationId], map: "fk_projects_sales_manager_org_consistent")
  introducer            Introducer?              @relation(fields: [introducerId, organizationId], references: [id, organizationId], map: "fk_projects_introducer_org_consistent")
  projectType           ProjectType?             @relation(fields: [projectTypeId, organizationId], references: [id, organizationId], map: "fk_projects_project_type_org_consistent")
  teamMembers           ProjectTeamMember[]
  progressEntries       ProjectProgress[]
  milestones            ProjectMilestone[]
  paymentAlerts         PaymentAlert[]
  journalLines          JournalLine[]
  securityInstruments   SecurityInstrument[]
  invoices              Invoice[]
  creditDebitNotes      CreditDebitNote[]
  vendorBills           VendorBill[]
  employeeAdvances      EmployeeAdvance[]
  employeeExpenseClaims EmployeeExpenseClaim[]
  directExpenses        DirectExpense[]
  inventoryConsumptions InventoryConsumption[]
  allocationLines       EmployeeAllocationLine[]
  introducerAgreements  IntroducerAgreement[]

  // Documents attach via the entity-agnostic Documents module
  // (entityType='PROJECT', already seeded) — no dedicated FK table needed.
  @@unique([id, organizationId], map: "uq_projects_id_org")
  @@index([organizationId], map: "idx_projects_organization_id")
  @@index([clientId], map: "idx_projects_client_id")
  @@map("projects")
}

/// Project-scoped roster, additive to Project.projectManagerId (not a
/// replacement). Shape mirrors UserRole's own precedent — a simple grant/
/// revoke join row, no soft-delete, no version; removal is a hard delete.
/// `role` is a free-text label on this project (e.g. "Site Engineer"), not
/// a fixed enum — it doesn't affect scoping. Membership here (or being
/// projectManagerId) is what "assigned to a project" means for
/// ProjectsService's Project-Manager-scoping logic — see ADR-058.
model ProjectTeamMember {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  role           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  project  Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_project_team_members_project_org_consistent")
  employee Employee @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_project_team_members_employee_org_consistent")

  @@unique([projectId, employeeId], map: "uq_project_team_members_project_employee")
  @@index([projectId], map: "idx_project_team_members_project_id")
  @@map("project_team_members")
}

/// Append-only physical-progress timeline. Shaped like LeadUpdate/
/// TenderUpdate (title/note/createdBy/createdByEmail) plus a `percentage`
/// column. There is no denormalized "current %" on Project — current
/// progress is derived by reading the latest (highest-percentage) row,
/// same "read model derives from an append-only table" precedent
/// LeadUpdate/TenderUpdate already set. `percentage` can only increase
/// between rows for the same project (enforced in ProjectsService, not the
/// database — see ADR-061).
model ProjectProgress {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  title          String
  percentage     Int
  note           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  createdByEmail String?  @map("created_by_email")

  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_project_progress_project_org_consistent")

  @@index([projectId], map: "idx_project_progress_project_id")
  @@map("project_progress")
}

/// The standard double-entry classification — not an invented business
/// state. Fixes each group's normalBalance: ASSET/EXPENSE -> DEBIT,
/// LIABILITY/EQUITY/INCOME -> CREDIT (enforced in ChartOfAccountsService,
/// never independently chosen by a caller).
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

/// Organization-wide Chart of Accounts grouping (ADR-062) — not
/// legal-entity-scoped; future journal lines carry the legal-entity
/// dimension per document, not the ledger account itself. The five system
/// roots (Assets/Liabilities/Equity/Income/Expenses, isSystemDefined=true)
/// are seeded directly; every other row is created via the API and always
/// requires an active parent. `accountType`/`normalBalance` are stored on
/// every row (not derived by a tree-walk) — a custom group copies them
/// from its parent at creation and can only ever be re-parented to another
/// group with the same stored accountType/normalBalance, so classification
/// never needs to cascade to children. `code`, `accountType`,
/// `normalBalance`, and a null `parentGroupId` are immutable after
/// creation for every group; `parentGroupId` is additionally immutable
/// for system-defined roots specifically (never re-parented at all).
model AccountGroup {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  code            String
  name            String
  description     String?
  accountType     AccountType   @map("account_type")
  normalBalance   NormalBalance @map("normal_balance")
  parentGroupId   String?       @map("parent_group_id") @db.Uuid
  isSystemDefined Boolean       @default(false) @map("is_system_defined")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?       @map("created_by") @db.Uuid
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?       @map("updated_by") @db.Uuid
  version         Int           @default(1)

  parentGroup    AccountGroup?   @relation("AccountGroupParent", fields: [parentGroupId, organizationId], references: [id, organizationId], map: "fk_account_groups_parent_org_consistent")
  childGroups    AccountGroup[]  @relation("AccountGroupParent")
  ledgerAccounts LedgerAccount[]

  @@unique([organizationId, code], map: "uq_account_groups_org_code")
  @@unique([id, organizationId], map: "uq_account_groups_id_org")
  @@index([organizationId], map: "idx_account_groups_organization_id")
  @@index([parentGroupId], map: "idx_account_groups_parent_group_id")
  @@map("account_groups")
}

/// Leaf account referenced by future journal lines (ADR-062). Carries no
/// accountType/normalBalance of its own — always derived via the
/// accountGroup relation, since a ledger account has exactly one group and
/// deriving via a join is trivial (no tree to walk, unlike AccountGroup).
/// `allowManualPosting` flags whether this account may receive
/// hand-entered journal lines once the posting engine exists (default
/// true — most leaf accounts are postable). Moving an account
/// (accountGroupId) is only permitted to another active group with the
/// same derived accountType/normalBalance; once journals exist, an
/// account with any journal usage must additionally be prohibited from
/// moving at all (not enforced yet — nothing to check against).
model LedgerAccount {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  accountGroupId     String   @map("account_group_id") @db.Uuid
  code               String
  name               String
  description        String?
  allowManualPosting Boolean  @default(true) @map("allow_manual_posting")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String?  @map("created_by") @db.Uuid
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy          String?  @map("updated_by") @db.Uuid
  version            Int      @default(1)

  accountGroup               AccountGroup                @relation(fields: [accountGroupId, organizationId], references: [id, organizationId], map: "fk_ledger_accounts_group_org_consistent")
  journalLines               JournalLine[]
  securityInstrumentPurposes SecurityInstrumentPurpose[]
  securityInstruments        SecurityInstrument[]
  bankAccounts               BankAccount[]
  otherDeductions            AllocationDeduction[]
  acceptedForCategories      PenaltyCategory[]           @relation("PenaltyCategoryAcceptedLedgerAccount")
  disputedForCategories      PenaltyCategory[]           @relation("PenaltyCategoryDisputedLedgerAccount")
  ledgerOpeningBalances      LedgerOpeningBalance[]
  expenseCategories          ExpenseCategory[]
  cardAccounts               CardAccount[]

  @@unique([organizationId, code], map: "uq_ledger_accounts_org_code")
  @@unique([id, organizationId], map: "uq_ledger_accounts_id_org")
  @@index([organizationId], map: "idx_ledger_accounts_organization_id")
  @@index([accountGroupId], map: "idx_ledger_accounts_account_group_id")
  @@map("ledger_accounts")
}

enum LedgerOpeningBalanceStatus {
  ACTIVE
  VOID
}

/// Ledger opening balance (Phase 5, docs/11 "a starting Dr/Cr figure as of
/// a given date per legal entity/ledger account"). Not a second balance-
/// computation code path -- setting one simply posts a normal
/// Dr/Cr journal entry (via the existing postJournal, dated asOfDate)
/// against the fixed OPENING_BALANCE_EQUITY account, so
/// PostingService.getLedgerActivity's existing sum-of-journal-lines
/// formula picks it up automatically with zero changes. `amount` is
/// signed exactly like LedgerActivityRow.runningBalance already is:
/// positive = the account's own normal-balance side, negative = the
/// abnormal side (e.g. an overdrawn bank account). At most one ACTIVE row
/// per (legalEntityId, ledgerAccountId) -- correcting one means voiding
/// (which reverses the journal, same as Invoice/CreditDebitNote's own
/// void-via-reversal) then setting a fresh one. No update path -- this
/// mirrors EMD/SD's lodge-then-return shape, not Invoice's draft/edit
/// shape, since there is no draft concept here at all.
model LedgerOpeningBalance {
  id              String                     @id @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  legalEntityId   String                     @map("legal_entity_id") @db.Uuid
  ledgerAccountId String                     @map("ledger_account_id") @db.Uuid
  asOfDate        DateTime                   @map("as_of_date") @db.Date
  amount          Decimal                    @db.Decimal(19, 4)
  status          LedgerOpeningBalanceStatus @default(ACTIVE)

  journalEntryId     String    @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?   @map("void_journal_entry_id") @db.Uuid
  voidReason         String?   @map("void_reason")
  voidedBy           String?   @map("voided_by") @db.Uuid
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  legalEntity      LegalEntity   @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_ledger_opening_balances_legal_entity_org_consistent")
  ledgerAccount    LedgerAccount @relation(fields: [ledgerAccountId, organizationId], references: [id, organizationId], map: "fk_ledger_opening_balances_account_org_consistent")
  journalEntry     JournalEntry  @relation("LedgerOpeningBalanceSetJournalEntry", fields: [journalEntryId], references: [id], map: "fk_ledger_opening_balances_journal_entry")
  voidJournalEntry JournalEntry? @relation("LedgerOpeningBalanceVoidJournalEntry", fields: [voidJournalEntryId], references: [id], map: "fk_ledger_opening_balances_void_journal_entry")

  // Hand-added in the migration SQL (Prisma's @@unique cannot express a
  // WHERE clause), matching uq_invoices_source_event_active's precedent:
  //   UNIQUE (organization_id, legal_entity_id, ledger_account_id) WHERE status != 'VOID'
  @@index([ledgerAccountId, legalEntityId], map: "idx_ledger_opening_balances_account_entity")
  @@map("ledger_opening_balances")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Journal header (ADR-065, docs/06; reversal added in ADR-067). DRAFT
/// remains unreachable (no manual-entry/draft workflow exists). POSTED and
/// REVERSED are both reachable: reverseJournal (ADR-067) creates a new,
/// opposite-signed POSTED entry (reversalOfJournalEntryId set on the new
/// entry, pointing at the original) and flips the original to REVERSED
/// (reversalReason/reversedBy/reversedAt), atomically — the original's own
/// lines are never edited, matching docs/06's "posted journal entries are
/// immutable... reversal entries reference the original entry."
/// accountingPeriodId is a snapshot resolved at post time, not derived live
/// — a posting's period is a permanent historical fact even if that period
/// is later locked/reopened. The (organizationId, sourceType, sourceId)
/// unique is a second, belt-and-braces duplicate-posting guard beyond the
/// IdempotencyKey registry — "each source event has one unique posting
/// key" (docs/06) means one journal entry per source event, full stop; a
/// reversal's own sourceType ('journal_entry_reversal') + sourceId (the
/// original's id) means this same constraint also caps each entry at one
/// reversal, for free.
model JournalEntry {
  id                       String             @id @db.Uuid
  organizationId           String             @map("organization_id") @db.Uuid
  legalEntityId            String             @map("legal_entity_id") @db.Uuid
  accountingDate           DateTime           @map("accounting_date") @db.Date
  financialYearId          String             @map("financial_year_id") @db.Uuid
  accountingPeriodId       String             @map("accounting_period_id") @db.Uuid
  sourceType               String             @map("source_type")
  sourceId                 String             @map("source_id") @db.Uuid
  postingEvent             String             @map("posting_event")
  idempotencyKey           String             @map("idempotency_key")
  description              String?
  status                   JournalEntryStatus @default(POSTED)
  postedBy                 String?            @map("posted_by") @db.Uuid
  postedAt                 DateTime           @default(now()) @map("posted_at") @db.Timestamptz
  reversalOfJournalEntryId String?            @unique @map("reversal_of_journal_entry_id") @db.Uuid
  reversalReason           String?            @map("reversal_reason")
  reversedBy               String?            @map("reversed_by") @db.Uuid
  reversedAt               DateTime?          @map("reversed_at") @db.Timestamptz
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz

  legalEntity                               LegalEntity            @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_journal_entries_legal_entity_org_consistent")
  accountingPeriod                          AccountingPeriod       @relation(fields: [accountingPeriodId, organizationId], references: [id, organizationId], map: "fk_journal_entries_period_org_consistent")
  lines                                     JournalLine[]
  lodgedForSecurityInstruments              SecurityInstrument[]   @relation("SecurityInstrumentLodgeJournalEntry")
  returnedForSecurityInstruments            SecurityInstrument[]   @relation("SecurityInstrumentReturnJournalEntry")
  reversalOf                                JournalEntry?          @relation("JournalEntryReversal", fields: [reversalOfJournalEntryId], references: [id])
  reversedByEntry                           JournalEntry?          @relation("JournalEntryReversal")
  finalizedForInvoices                      Invoice[]              @relation("InvoiceFinalizeJournalEntry")
  voidedForInvoices                         Invoice[]              @relation("InvoiceVoidJournalEntry")
  finalizedForVendorBills                   VendorBill[]           @relation("VendorBillFinalizeJournalEntry")
  voidedForVendorBills                      VendorBill[]           @relation("VendorBillVoidJournalEntry")
  finalizedForCreditDebitNotes              CreditDebitNote[]      @relation("CreditDebitNoteFinalizeJournalEntry")
  voidedForCreditDebitNotes                 CreditDebitNote[]      @relation("CreditDebitNoteVoidJournalEntry")
  postedForReceipts                         ClientReceipt[]        @relation("ReceiptPostJournalEntry")
  reversedForReceipts                       ClientReceipt[]        @relation("ReceiptReversalJournalEntry")
  deductionReleases                         DeductionRelease[]
  setForLedgerOpeningBalances               LedgerOpeningBalance[] @relation("LedgerOpeningBalanceSetJournalEntry")
  voidedForLedgerOpeningBalances            LedgerOpeningBalance[] @relation("LedgerOpeningBalanceVoidJournalEntry")
  postedForVendorPayments                   VendorPayment[]        @relation("VendorPaymentPostJournalEntry")
  reversedForVendorPayments                 VendorPayment[]        @relation("VendorPaymentReversalJournalEntry")
  postedForEmployeeAdvances                 EmployeeAdvance[]      @relation("EmployeeAdvancePostJournalEntry")
  reversedForEmployeeAdvances               EmployeeAdvance[]      @relation("EmployeeAdvanceReversalJournalEntry")
  approvedForEmployeeExpenseClaims          EmployeeExpenseClaim[] @relation("EmployeeExpenseClaimApproveJournalEntry")
  reimbursedForEmployeeExpenseClaims        EmployeeExpenseClaim[] @relation("EmployeeExpenseClaimReimburseJournalEntry")
  reimburseReversedForEmployeeExpenseClaims EmployeeExpenseClaim[] @relation("EmployeeExpenseClaimReimburseReversalJournalEntry")
  postedForDirectExpenses                   DirectExpense[]        @relation("DirectExpensePostJournalEntry")
  reversedForDirectExpenses                 DirectExpense[]        @relation("DirectExpenseReversalJournalEntry")
  postedForTdsDeposits                      TdsDeposit[]           @relation("TdsDepositPostJournalEntry")
  reversedForTdsDeposits                    TdsDeposit[]           @relation("TdsDepositReversalJournalEntry")
  cardSettlements                           CardSettlement[]

  @@unique([organizationId, sourceType, sourceId], map: "uq_journal_entries_org_source")
  @@index([legalEntityId, accountingDate], map: "idx_journal_entries_legal_entity_date")
  @@index([accountingPeriodId], map: "idx_journal_entries_accounting_period_id")
  @@map("journal_entries")
}

/// Journal line (ADR-065, docs/06). Every dimension docs/06 names is
/// present, even though no current caller populates project/party/
/// employee/gstRegistration/taxCode yet — implementing an already-frozen
/// external spec verbatim, not speculative scaffolding. Exactly one of
/// debitAmount/creditAmount is > 0 and the other is exactly 0 — CHECK-
/// enforced in the migration (Prisma's DSL can't express it).
model JournalLine {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  journalEntryId    String   @map("journal_entry_id") @db.Uuid
  ledgerAccountId   String   @map("ledger_account_id") @db.Uuid
  debitAmount       Decimal  @default(0) @map("debit_amount") @db.Decimal(19, 4)
  creditAmount      Decimal  @default(0) @map("credit_amount") @db.Decimal(19, 4)
  projectId         String?  @map("project_id") @db.Uuid
  partyId           String?  @map("party_id") @db.Uuid
  employeeId        String?  @map("employee_id") @db.Uuid
  gstRegistrationId String?  @map("gst_registration_id") @db.Uuid
  taxCode           String?  @map("tax_code")
  narrative         String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  journalEntry              JournalEntry              @relation(fields: [journalEntryId], references: [id], onDelete: Cascade, map: "fk_journal_lines_journal_entry")
  ledgerAccount             LedgerAccount             @relation(fields: [ledgerAccountId, organizationId], references: [id, organizationId], map: "fk_journal_lines_ledger_account_org_consistent")
  project                   Project?                  @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_journal_lines_project_org_consistent")
  party                     Party?                    @relation(fields: [partyId, organizationId], references: [id, organizationId], map: "fk_journal_lines_party_org_consistent")
  employee                  Employee?                 @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_journal_lines_employee_org_consistent")
  gstRegistration           GstRegistration?          @relation(fields: [gstRegistrationId, organizationId], references: [id, organizationId], map: "fk_journal_lines_gst_registration_org_consistent")
  bankReconciliationMatches BankReconciliationMatch[]

  @@index([journalEntryId], map: "idx_journal_lines_journal_entry_id")
  @@index([ledgerAccountId], map: "idx_journal_lines_ledger_account_id")
  @@map("journal_lines")
}

enum SecurityInstrumentStatus {
  LODGED
  RETURNED
}

/// EMD/SD (Phase 4.5, ADR-066, docs/06). May reference a Tender, a Project,
/// or both (independently nullable — app-validated to require at least one,
/// not a DB CHECK, mirroring Project's own Lead/Tender pattern); ADR-020.
/// Immutable after creation except through recordReturn — no update/delete
/// endpoint, same "financial record, correction workflows are a future
/// concern" reasoning as JournalEntry's own no-edit-after-posting rule.
/// lodgeJournalEntryId/returnJournalEntryId are populated only when the
/// instrument's SecurityInstrumentType.requiresCashPosting is true —
/// guarantee-type instruments (bank guarantee, insurance surety bond) never
/// post a journal, their principal is tracked only as this row itself
/// (docs/06: "contingent exposure"). The fundedBy- and returnedTo-prefixed
/// fields are informational only (decision 9) — no journal posting reflects who
/// funded or receives the instrument, since docs/06 defines no
/// inter-company payable/receivable treatment. recordReturn only succeeds
/// when returnedAmount equals amount exactly — penalty-deducted (partial)
/// returns are deferred, not silently accepted or partially posted.
model SecurityInstrument {
  id                           String                   @id @db.Uuid
  organizationId               String                   @map("organization_id") @db.Uuid
  legalEntityId                String                   @map("legal_entity_id") @db.Uuid
  projectId                    String?                  @map("project_id") @db.Uuid
  tenderId                     String?                  @map("tender_id") @db.Uuid
  purposeId                    String                   @map("purpose_id") @db.Uuid
  typeId                       String                   @map("type_id") @db.Uuid
  amount                       Decimal                  @db.Decimal(19, 4)

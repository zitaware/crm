// Phase 2 sub-phase 2.0 — cross-cutting infrastructure only (organizations,
// audit trail, outbox, idempotency, job observability, notifications).
// See docs/07-database-conventions.md for naming/typing conventions and
// docs/12-decisions-log.md (ADR-035+) for the design decisions behind this
// shape. IDs are application-generated (UUID v7 via packages/database's
// generateId()), never DB-generated — do not add @default(uuid()) anywhere.

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // A genuinely separate, disposable database (never the same connection as
  // DATABASE_URL) that Prisma uses as scratch space for `migrate dev` and
  // `migrate diff`. Declaring it here means every Prisma CLI invocation that
  // needs shadow-database scratch space uses THIS one automatically,
  // without requiring (or permitting a mistaken) --shadow-database-url flag
  // on the command line. See docs/07-database-conventions.md "Migration
  // development procedure" for the incident this prevents.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NOTE on created_by/updated_by columns throughout this file: these are
// plain `uuid` audit-stamp columns (the actor's user id), intentionally
// WITHOUT a Prisma @relation/FK to User. Enforcing a real FK here would
// require every one of the ~25 organization-scoped tables to carry a back-
// relation array on User, and creates a bootstrap problem (the very first
// organization/user rows have no prior actor). The column still stores a
// real user id for audit purposes; see docs/07-database-conventions.md.

model Organization {
  id        String   @id @db.Uuid
  name      String
  code      String   @unique(map: "uq_organizations_code")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  users User[]

  @@map("organizations")
}

/// Append-only audit trail. No update/delete path exists in the app layer,
/// and the runtime DB role's UPDATE/DELETE grants on this table are
/// revoked by a raw-SQL migration (phase2_00b_audit_events_grants).
model AuditEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  legalEntityId  String?  @map("legal_entity_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  action         String
  actorId        String?  @map("actor_id") @db.Uuid
  actorEmail     String?  @map("actor_email")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  commandPayload Json?    @map("command_payload")
  reason         String?
  correlationId  String   @map("correlation_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Composite FK enforces the (optional) legal entity belongs to this
  // organization. Trivially satisfied when legalEntityId is NULL. Unlike
  // actorId/createdBy/updatedBy (audit-stamp columns intentionally left as
  // plain uuid — see this file's top-of-file note), legalEntityId is a
  // genuine business reference, not an actor stamp, so it gets a real FK.
  legalEntity LegalEntity? @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_audit_events_legal_entity_org_consistent")

  @@index([organizationId, createdAt, id], map: "idx_audit_events_org_created_at")
  @@index([entityType, entityId], map: "idx_audit_events_entity")
  @@index([actorId], map: "idx_audit_events_actor")
  @@map("audit_events")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt    DateTime? @map("processed_at") @db.Timestamptz

  notification Notification?

  // Composite-unique support constraint letting notifications enforce
  // organization consistency via a real composite FK.
  @@unique([id, organizationId], map: "uq_outbox_events_id_org")
  @@index([status, nextAttemptAt], map: "idx_outbox_events_status_next_attempt")
  @@index([aggregateType, aggregateId], map: "idx_outbox_events_aggregate")
  @@map("outbox_events")
}

model Notification {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  recipientUserId     String?   @map("recipient_user_id") @db.Uuid
  recipientEmail      String    @map("recipient_email")
  channel             String    @default("EMAIL")
  template            String
  payload             Json
  status              String    @default("PENDING")
  providerMessageId   String?   @map("provider_message_id")
  sourceOutboxEventId String    @unique(map: "uq_notifications_source_outbox_event_id") @map("source_outbox_event_id") @db.Uuid
  sentAt              DateTime? @map("sent_at") @db.Timestamptz
  failedReason        String?   @map("failed_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Composite FKs enforce that both the source outbox event and the
  // (optional) recipient user belong to this organization. The recipient
  // FK is trivially satisfied when recipientUserId is NULL (e.g. a
  // notification sent to a raw email address with no platform user).
  sourceOutboxEvent OutboxEvent @relation(fields: [sourceOutboxEventId, organizationId], references: [id, organizationId], map: "fk_notifications_outbox_event_org_consistent")
  recipientUser     User?       @relation(fields: [recipientUserId, organizationId], references: [id, organizationId], map: "fk_notifications_recipient_user_org_consistent")

  // Required by Prisma for the 1:1 composite relation above — sourceOutboxEventId
  // is already globally unique alone (uq_notifications_source_outbox_event_id);
  // this composite tuple is trivially also unique, just declared explicitly
  // since Prisma requires the exact field tuple used in a 1:1 @relation to
  // carry its own uniqueness constraint.
  @@unique([sourceOutboxEventId, organizationId], map: "uq_notifications_source_outbox_event_org")
  @@index([recipientUserId], map: "idx_notifications_recipient_user_id")
  @@index([status], map: "idx_notifications_status")
  @@map("notifications")
}

model JobRun {
  id             String    @id @db.Uuid
  jobName        String    @map("job_name")
  status         String    @default("RUNNING")
  itemsProcessed Int       @default(0) @map("items_processed")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz
  error          String?

  @@index([jobName, startedAt], map: "idx_job_runs_job_name_started_at")
  @@map("job_runs")
}

model User {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  email               String
  passwordHash        String?   @map("password_hash")
  displayName         String    @map("display_name")
  status              String    @default("INVITED")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  invitedAt           DateTime? @map("invited_at") @db.Timestamptz
  invitedBy           String?   @map("invited_by") @db.Uuid
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz
  disabledBy          String?   @map("disabled_by") @db.Uuid
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)

  organization            Organization             @relation(fields: [organizationId], references: [id])
  invitations             UserInvitation[]
  resetTokens             PasswordResetToken[]
  sessions                Session[]
  employees               Employee[]
  userRoles               UserRole[]
  userPermissionOverrides UserPermissionOverride[]
  notifications           Notification[]

  // uq_users_org_email is a normalized (lower(email)) functional unique
  // index, added by hand in the migration SQL — Prisma's @@unique can only
  // express plain-column uniqueness, so it is intentionally NOT declared
  // here to avoid schema/migration drift. See migration phase2_01_identity_auth.
  //
  // uq_users_id_org is a composite-unique support constraint (not a real
  // additional uniqueness rule beyond the PK — id is already globally
  // unique) that lets Employee.userId enforce organization consistency via
  // a real composite FK, the same technique used for districts/cities.
  @@unique([id, organizationId], map: "uq_users_id_org")
  @@map("users")
}

model UserInvitation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique(map: "uq_user_invitations_token_hash") @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid

  user User @relation(fields: [userId, organizationId], references: [id, organizationId], map: "fk_user_invitations_user_org_consistent")

  @@index([userId], map: "idx_user_invitations_user_id")
  @@map("user_invitations")
}

model PasswordResetToken {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  usedAt         DateTime? @map("used_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId, organizationId], references: [id, organizationId], map: "fk_password_reset_tokens_user_org_consistent")

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

model Session {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique(map: "uq_sessions_refresh_token_hash") @map("refresh_token_hash")
  refreshTokenFamilyId String    @map("refresh_token_family_id") @db.Uuid
  // Nullable-unique: Postgres allows unlimited NULLs (most sessions were
  // never produced by a rotation) but enforces uniqueness among non-null
  // values — at most one successor session can ever claim a given
  // predecessor. Defense-in-depth alongside the guarded updateMany in
  // IdentityService.refresh() that prevents two concurrent refresh calls
  // from both minting a successor for the same token.
  rotatedFromSessionId String?   @unique(map: "uq_sessions_rotated_from_session_id") @map("rotated_from_session_id") @db.Uuid
  ipAddress            String?   @map("ip_address")
  userAgent            String?   @map("user_agent")
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason        String?   @map("revoked_reason")
  /// ADR-174: set when an Admin is viewing as this user. The Admin, and the
  /// Admin's own session to return to; carried over on every refresh.
  impersonatorUserId    String?  @map("impersonator_user_id") @db.Uuid
  impersonatorSessionId String?  @map("impersonator_session_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Composite FK (user_id, organization_id) -> users(id, organization_id):
  // the session's user must belong to the same organization as the session.
  user User @relation(fields: [userId, organizationId], references: [id, organizationId], map: "fk_sessions_user_org_consistent")

  @@index([userId], map: "idx_sessions_user_id")
  @@index([refreshTokenFamilyId], map: "idx_sessions_refresh_token_family_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model Role {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean  @default(true) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?  @map("updated_by") @db.Uuid
  version        Int      @default(1)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name], map: "uq_roles_org_name")
  // Composite-unique support constraint (id is already globally unique via
  // the PK) letting UserRole enforce organization consistency via a real
  // composite FK.
  @@unique([id, organizationId], map: "uq_roles_id_org")
  @@map("roles")
}

/// Global catalog, no organization scoping — every org shares the same
/// permission vocabulary. System-seeded, never end-user CRUD.
model Permission {
  id          String  @id @db.Uuid
  key         String  @unique(map: "uq_permissions_key")
  resource    String
  action      String
  description String?

  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId], map: "uq_role_permissions_role_permission")
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  // Composite FKs enforce that both the user and the role belong to the
  // SAME organization as this grant.
  user User @relation(fields: [userId, organizationId], references: [id, organizationId], map: "fk_user_roles_user_org_consistent")
  role Role @relation(fields: [roleId, organizationId], references: [id, organizationId], map: "fk_user_roles_role_org_consistent")

  @@unique([userId, roleId], map: "uq_user_roles_user_role")
  @@map("user_roles")
}

model UserPermissionOverride {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  permissionId   String   @map("permission_id") @db.Uuid
  effect         String
  scopeType      String?  @map("scope_type")
  scopeId        String?  @map("scope_id") @db.Uuid
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  // Composite FK enforces the overridden user belongs to this organization.
  // permissionId stays a plain FK — Permission is a global catalog with no
  // organization_id to cross-check.
  user       User       @relation(fields: [userId, organizationId], references: [id, organizationId], map: "fk_user_permission_overrides_user_org_consistent")
  permission Permission @relation(fields: [permissionId], references: [id])

  @@map("user_permission_overrides")
}

/// Global, statutory reference data — no organization_id. System-seeded.
model State {
  id           String    @id @db.Uuid
  name         String    @unique(map: "uq_states_name")
  code         String    @unique(map: "uq_states_code")
  gstStateCode String    @unique(map: "uq_states_gst_state_code") @map("gst_state_code")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy    String?   @map("deleted_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)

  districts        District[]
  gstRegistrations GstRegistration[]
  parties          Party[]

  @@map("states")
}

/// Global, statutory reference data — no organization_id. System-seeded.
model District {
  id        String    @id @db.Uuid
  stateId   String    @map("state_id") @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)

  state   State   @relation(fields: [stateId], references: [id])
  cities  City[]
  parties Party[]

  // uq_districts_state_normalized_name (state_id, lower(trim(name))) and
  // uq_districts_id_state_id UNIQUE(id, state_id) — the latter a composite-
  // unique support constraint letting `cities` enforce state_id consistency
  // via a real composite FK — are both hand-added in the migration SQL;
  // Prisma cannot express a normalized functional index or a non-PK
  // composite-unique target here without schema/migration drift.
  @@index([stateId], map: "idx_districts_state_id")
  @@map("districts")
}

/// Global, statutory reference data — no organization_id. System-seeded.
model City {
  id         String    @id @db.Uuid
  districtId String    @map("district_id") @db.Uuid
  stateId    String    @map("state_id") @db.Uuid
  name       String
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy  String?   @map("deleted_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)

  district District @relation(fields: [districtId], references: [id])
  parties  Party[]

  // uq_cities_district_normalized_name (district_id, lower(trim(name))) and
  // chk_cities_state_matches_district FOREIGN KEY (district_id, state_id)
  // REFERENCES districts(id, state_id) are both hand-added in the migration
  // SQL — the latter is the DB-level guarantee that a city's denormalized
  // state_id actually matches its district's state_id (not merely an
  // app-layer check).
  @@index([districtId], map: "idx_cities_district_id")
  @@map("cities")
}

/// Common baseline for organization-scoped flat lookup masters (HR/CRM/
/// tender/project/document/finance-support masters share this exact shape).
/// Administrator-created, no hierarchy. `code` becomes immutable once a
/// later-phase record references it (enforced in the app layer at that
/// point — no such reference exists yet in Phase 2).
model InternalDepartment {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  employees Employee[]

  // uq_internal_departments_org_normalized_name (organization_id,
  // lower(trim(name))) is hand-added in the migration SQL (see
  // schema.prisma note on functional indexes elsewhere in this file).
  @@unique([organizationId, code], map: "uq_internal_departments_org_code")
  // Composite-unique support constraint letting Employee enforce
  // organization consistency via a real composite FK.
  @@unique([id, organizationId], map: "uq_internal_departments_id_org")
  @@map("internal_departments")
}

model Designation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  employees Employee[]

  @@unique([organizationId, code], map: "uq_designations_org_code")
  @@unique([id, organizationId], map: "uq_designations_id_org")
  @@map("designations")
}

model EmploymentType {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  employees Employee[]

  @@unique([organizationId, code], map: "uq_employment_types_org_code")
  @@unique([id, organizationId], map: "uq_employment_types_id_org")
  @@map("employment_types")
}

/// Organization-scoped flat lookup master, Administrator-created. Common
/// baseline (see InternalDepartment's doc comment above).
model GovernmentBodyType {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)

  @@unique([organizationId, code], map: "uq_government_body_types_org_code")

  type                  SecurityInstrumentType    @relation(fields: [typeId, organizationId], references: [id, organizationId], map: "fk_security_instruments_type_org_consistent")
  bankLedgerAccount     LedgerAccount?            @relation(fields: [bankLedgerAccountId, organizationId], references: [id, organizationId], map: "fk_security_instruments_bank_ledger_account_org_consistent")
  lodgeJournalEntry     JournalEntry?             @relation("SecurityInstrumentLodgeJournalEntry", fields: [lodgeJournalEntryId], references: [id], map: "fk_security_instruments_lodge_journal_entry")
  returnJournalEntry    JournalEntry?             @relation("SecurityInstrumentReturnJournalEntry", fields: [returnJournalEntryId], references: [id], map: "fk_security_instruments_return_journal_entry")

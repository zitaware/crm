  fundedByParty         Party?                    @relation("SecurityInstrumentFundingParty", fields: [fundedByPartyId, organizationId], references: [id, organizationId], map: "fk_security_instruments_funded_by_party_org_consistent")
  returnedToLegalEntity LegalEntity?              @relation("SecurityInstrumentReturnLegalEntity", fields: [returnedToLegalEntityId, organizationId], references: [id, organizationId], map: "fk_security_instruments_returned_to_legal_entity_org_consistent")
  returnedToParty       Party?                    @relation("SecurityInstrumentReturnParty", fields: [returnedToPartyId, organizationId], references: [id, organizationId], map: "fk_security_instruments_returned_to_party_org_consistent")

  @@index([organizationId, status, returnDueOn], map: "idx_security_instruments_org_status_return_due")
  @@index([projectId], map: "idx_security_instruments_project_id")
  @@index([tenderId], map: "idx_security_instruments_tender_id")
  @@map("security_instruments")
}

enum MilestoneType {
  CAPEX
  OPEX
}

enum MilestoneAchievementStatus {
  PLANNED
  IN_PROGRESS
  ACHIEVED
  CANCELLED
}

enum InstallmentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InstallmentStatus {
  PLANNED
  SKIPPED
  CANCELLED
  INVOICE_DRAFT
  INVOICED
}

enum AlertRecipient {
  ACCOUNT_TEAM
  PROJECT_MANAGER
  BOTH
}

/// CAPEX pool or OPEX billing item (ADR-063). CAPEX always has one or more
/// child MilestoneEvent rows (the prototype's own Add-Capex flow always
/// creates a pool + events, never a bare single-row milestone); achievement
/// state lives on each event, not the pool. OPEX has its own achievement
/// state directly (one continuous recurring service) and generates
/// MilestoneInstallment rows deterministically at creation. Schedule
/// generation never creates any accounting entry — see docs/01/05.
/// approvedAmount/frequency/installmentCount/scheduleStartDate/
/// firstInvoiceDate/achievementStatus are CAPEX-or-OPEX-only fields,
/// CHECK-enforced by type (see migration).
model ProjectMilestone {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  type            MilestoneType
  code            String
  name            String
  approvedAmount  Decimal       @map("approved_amount") @db.Decimal(19, 4)
  referenceNumber String?       @map("reference_number")
  approvalDate    DateTime?     @map("approval_date") @db.Date
  description     String?

  // OPEX-only — CHECK-enforced null/not-null by `type`
  achievementStatus MilestoneAchievementStatus? @map("achievement_status")
  frequency         InstallmentFrequency?
  installmentCount  Int?                        @map("installment_count")
  scheduleStartDate DateTime?                   @map("schedule_start_date") @db.Date
  firstInvoiceDate  DateTime?                   @map("first_invoice_date") @db.Date

  alertRecipient     AlertRecipient @default(ACCOUNT_TEAM) @map("alert_recipient")
  reminderOffsetDays Int            @default(3) @map("reminder_offset_days")

  achievedOn   DateTime? @map("achieved_on") @db.Date
  achievedBy   String?   @map("achieved_by") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  project      Project                @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_project_milestones_project_org_consistent")
  events       MilestoneEvent[]
  installments MilestoneInstallment[]

  @@unique([projectId, code], map: "uq_project_milestones_project_code")
  @@unique([id, organizationId], map: "uq_project_milestones_id_org")
  @@unique([id, organizationId, type], map: "uq_project_milestones_id_org_type")
  @@index([projectId], map: "idx_project_milestones_project_id")
  @@map("project_milestones")
}

/// CAPEX billing event, independently achievable/cancellable. `milestoneType`
/// is always 'CAPEX' (CHECK-locked) — the FK targets ProjectMilestone's
/// [id, organizationId, type] composite unique, so an event can never
/// physically reference an OPEX milestone. `percentOfPool` is always
/// derived from amount/approvedAmount, never independently entered.
model MilestoneEvent {
  id                String                     @id @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  milestoneId       String                     @map("milestone_id") @db.Uuid
  milestoneType     MilestoneType              @default(CAPEX) @map("milestone_type")
  code              String
  name              String
  percentOfPool     Decimal                    @map("percent_of_pool") @db.Decimal(5, 2)
  amount            Decimal                    @db.Decimal(19, 4)
  dueDate           DateTime                   @map("due_date") @db.Date
  achievementStatus MilestoneAchievementStatus @default(PLANNED) @map("achievement_status")
  achievedOn        DateTime?                  @map("achieved_on") @db.Date
  achievedBy        String?                    @map("achieved_by") @db.Uuid
  cancelledAt       DateTime?                  @map("cancelled_at") @db.Timestamptz
  cancelledBy       String?                    @map("cancelled_by") @db.Uuid
  cancelReason      String?                    @map("cancel_reason")
  sequence          Int
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?                    @map("created_by") @db.Uuid
  updatedAt         DateTime                   @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy         String?                    @map("updated_by") @db.Uuid
  version           Int                        @default(1)

  milestone            ProjectMilestone     @relation(fields: [milestoneId, organizationId, milestoneType], references: [id, organizationId, type], map: "fk_milestone_events_milestone_org_type_consistent")
  paymentAlert         PaymentAlert?
  invoices             Invoice[]
  invoiceLines         InvoiceLine[]
  invoiceCapexSources  InvoiceCapexSource[]
  receiptAllocations   ReceiptAllocation[]

  @@unique([milestoneId, code], map: "uq_milestone_events_milestone_code")
  @@index([milestoneId], map: "idx_milestone_events_milestone_id")
  @@map("milestone_events")
}

/// Generated OPEX billing schedule row, deterministic at creation.
/// `milestoneType` is always 'OPEX' (CHECK-locked), same type-safe FK
/// pattern as MilestoneEvent. PLANNED->SKIPPED and PLANNED/IN_PROGRESS
/// cascaded ->CANCELLED (via parent milestone cancellation) were reachable
/// from Slice 4.2 onward. INVOICE_DRAFT/INVOICED were added in Phase 5
/// Slice 5.1 (InvoicesService.createDraftFromAlert/finalize) — voiding a
/// finalized invoice reverts status back to PLANNED (not a dedicated
/// REPLACEMENT_REQUIRED value; derivable from status + plannedInvoiceDate
/// without one). ALERT_OPEN was never added as a status value here at
/// all — that state is represented by the existence of an OPEN
/// PaymentAlert row instead, not duplicated onto this column.
model MilestoneInstallment {
  id                 String            @id @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  milestoneId        String            @map("milestone_id") @db.Uuid
  milestoneType      MilestoneType     @default(OPEX) @map("milestone_type")
  sequenceNumber     Int               @map("sequence_number")
  servicePeriodStart DateTime          @map("service_period_start") @db.Date
  servicePeriodEnd   DateTime          @map("service_period_end") @db.Date
  plannedInvoiceDate DateTime          @map("planned_invoice_date") @db.Date
  scheduledAmount    Decimal           @map("scheduled_amount") @db.Decimal(19, 4)
  status             InstallmentStatus @default(PLANNED)
  skipReason         String?           @map("skip_reason")
  cancelReason       String?           @map("cancel_reason")
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz
  closedBy           String?           @map("closed_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String?           @map("created_by") @db.Uuid
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy          String?           @map("updated_by") @db.Uuid
  version            Int               @default(1)

  milestone    ProjectMilestone @relation(fields: [milestoneId, organizationId, milestoneType], references: [id, organizationId, type], map: "fk_milestone_installments_milestone_org_type_consistent")
  paymentAlert PaymentAlert?
  invoices     Invoice[]

  @@unique([milestoneId, sequenceNumber], map: "uq_milestone_installments_milestone_sequence")
  @@index([milestoneId], map: "idx_milestone_installments_milestone_id")
  @@map("milestone_installments")
}

/// Minimally-scoped idempotency record for milestone creation only (ADR-063)
/// — not the generic cross-cutting Idempotency Registry that remains its
/// own, later Phase 4 deliverable; this is the smallest viable version
/// scoped to the one command that needed it this slice.
model MilestoneCreationRequest {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  idempotencyKey    String   @map("idempotency_key")
  resultMilestoneId String   @map("result_milestone_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, idempotencyKey], map: "uq_milestone_creation_requests_org_key")
  @@map("milestone_creation_requests")
}

enum PaymentAlertSourceType {
  CAPEX_EVENT
  OPEX_INSTALLMENT
}

enum PaymentAlertStatus {
  OPEN
  SNOOZED
  CLOSED
}

/// Payment Alert (ADR-064/Slice 4.3; CLOSED added in Phase 5 Slice 5.1) —
/// one row per CAPEX event or OPEX installment, ever, for its entire
/// billing lifetime (sourceEventId/sourceInstallmentId are hard-unique,
/// not composite-unique: a source is billed once). Opened/reopened by the
/// worker's daily-equivalent alert-opener job for OPEN/SNOOZED
/// transitions; CLOSED is set by InvoicesService.finalize (the source's
/// invoice finalized — "only finalized invoice closes the alert," docs/04
/// §11.3) and reverted back to OPEN by InvoicesService.void when a
/// finalized invoice is voided — the *same* row is reopened, never a new
/// one, since the source-id columns are hard-unique. Amount/due date are
/// intentionally NOT stored here — always read live via the
/// sourceEvent/sourceInstallment relation, so an in-flight updateEvent
/// correction is automatically reflected. Rows are physically deleted
/// (the sole exception to this codebase's no-physical-deletion rule) when
/// their source is cancelled or skipped — see
/// MilestonesService.cancelEvent/cancelMilestone/skipInstallment —
/// because a dead alert for a billing event that will never happen is not
/// a financial record worth retaining.
model PaymentAlert {
  id                  String                 @id @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  projectId           String                 @map("project_id") @db.Uuid
  sourceType          PaymentAlertSourceType @map("source_type")
  sourceEventId       String?                @unique(map: "uq_payment_alerts_source_event_id") @map("source_event_id") @db.Uuid
  sourceInstallmentId String?                @unique(map: "uq_payment_alerts_source_installment_id") @map("source_installment_id") @db.Uuid
  status              PaymentAlertStatus     @default(OPEN)
  openedAt            DateTime               @default(now()) @map("opened_at") @db.Timestamptz
  snoozedUntil        DateTime?              @map("snoozed_until") @db.Date
  snoozedAt           DateTime?              @map("snoozed_at") @db.Timestamptz
  snoozedBy           String?                @map("snoozed_by") @db.Uuid
  snoozeNote          String?                @map("snooze_note")
  invoiceId           String?                @map("invoice_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamptz
  version             Int                    @default(1)

  project            Project               @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_payment_alerts_project_org_consistent")
  sourceEvent        MilestoneEvent?       @relation(fields: [sourceEventId], references: [id], map: "fk_payment_alerts_source_event")
  sourceInstallment  MilestoneInstallment? @relation(fields: [sourceInstallmentId], references: [id], map: "fk_payment_alerts_source_installment")
  invoice            Invoice?              @relation("PaymentAlertClosingInvoice", fields: [invoiceId], references: [id], map: "fk_payment_alerts_invoice")
  originatedInvoices Invoice[]             @relation("InvoiceOriginAlert")
  invoiceCapexSources InvoiceCapexSource[]

  @@index([organizationId, projectId], map: "idx_payment_alerts_org_project")
  @@index([status, snoozedUntil], map: "idx_payment_alerts_status_snoozed_until")
  @@map("payment_alerts")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  FINALIZED
  VOID
  /// Issued proforma that has its own tax invoice. Still printable. Posts nothing and does not hold the billing slot.
  CONVERTED
}

/// REGULAR is a tax invoice and posts the receivable. PROFORMA is the
/// document only. The books move when a separate tax invoice is finalized.
enum InvoiceKind {
  REGULAR
  PROFORMA
}

/// Invoice (Phase 5, Slice 5.1, docs/04 §11.4, docs/06 "Finalize client
/// invoice"). Always created from a PaymentAlert — no free-standing
/// creation (docs/04: "remove free ad-hoc invoice creation"). Exactly one
/// of sourceEventId/sourceInstallmentId is set, matching milestoneType —
/// same type-safe-by-type shape PaymentAlert's own two source columns
/// already use, CHECK-enforced in the migration. At most one invoice that
/// is not VOID or CONVERTED may exist per source at a time (partial unique
/// indexes, hand-added in the migration). A voided invoice, or a proforma
/// that has been converted, frees its source for the tax invoice.
/// Draft rows are fully editable; every column from invoiceNumber onward
/// through the seller/buyer snapshot and tax amounts is null until
/// finalize, then immutable — docs/03: "Finalized invoices are
/// immutable." Voiding a finalized invoice calls PostingService's
/// existing reverseJournal (Slice 4.6) against journalEntryId rather than
/// inventing new reversal logic, and reopens the source PaymentAlert.
model Invoice {
  id                  String        @id @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  projectId           String        @map("project_id") @db.Uuid
  legalEntityId       String        @map("legal_entity_id") @db.Uuid
  gstRegistrationId   String        @map("gst_registration_id") @db.Uuid
  /// Bank account printed on this invoice. Chosen when the legal entity has more than one.
  bankAccountId       String?       @map("bank_account_id") @db.Uuid
  paymentAlertId      String        @map("payment_alert_id") @db.Uuid
  milestoneType       MilestoneType @map("milestone_type")
  sourceEventId       String?       @map("source_event_id") @db.Uuid
  sourceInstallmentId String?       @map("source_installment_id") @db.Uuid
  status              InvoiceStatus @default(DRAFT)
  kind                InvoiceKind   @default(REGULAR)
  financialYearId     String?       @map("financial_year_id") @db.Uuid
  invoiceNumber       String?       @map("invoice_number")
  proformaNumber      String?       @map("proforma_number")
  /// Set on the tax invoice that was opened from an issued proforma.
  convertedFromInvoiceId String? @unique @map("converted_from_invoice_id") @db.Uuid
  invoiceDate         DateTime?     @map("invoice_date") @db.Date
  dueDate             DateTime?     @map("due_date") @db.Date
  paymentTermsDays    Int?          @map("payment_terms_days")
  servicePeriodStart  DateTime?     @map("service_period_start") @db.Date
  servicePeriodEnd    DateTime?     @map("service_period_end") @db.Date
  /// Set at finalize when this invoice is the full bill for its event(s) or
  /// installment although it bills less than what was left: nothing more is
  /// expected, so the source counts as fully invoiced (ADR-167). Voiding the
  /// invoice undoes it.
  completesSource     Boolean       @default(false) @map("completes_source")

  // Snapshotted at finalize — immutable afterward (docs/03 invariants).
  sellerLegalName String? @map("seller_legal_name")
  sellerPan       String? @map("seller_pan")
  sellerGstin     String? @map("seller_gstin")
  sellerState     String? @map("seller_state")
  sellerAddress   String? @map("seller_address")
  buyerName       String? @map("buyer_name")
  buyerGstin      String? @map("buyer_gstin")
  buyerState      String? @map("buyer_state")
  buyerAddress    String? @map("buyer_address")

  taxableAmount Decimal? @map("taxable_amount") @db.Decimal(19, 4)
  cgstAmount    Decimal? @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount    Decimal? @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount    Decimal? @map("igst_amount") @db.Decimal(19, 4)
  totalAmount   Decimal? @map("total_amount") @db.Decimal(19, 4)

  narrative          String?
  journalEntryId     String?   @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?   @map("void_journal_entry_id") @db.Uuid
  voidReason         String?   @map("void_reason")
  voidedBy           String?   @map("voided_by") @db.Uuid
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  project            Project               @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_invoices_project_org_consistent")
  legalEntity        LegalEntity           @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_invoices_legal_entity_org_consistent")
  gstRegistration    GstRegistration       @relation(fields: [gstRegistrationId, organizationId], references: [id, organizationId], map: "fk_invoices_gst_registration_org_consistent")
  bankAccount        BankAccount?          @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_invoices_bank_account_org_consistent")
  financialYear      FinancialYear?        @relation(fields: [financialYearId, organizationId], references: [id, organizationId], map: "fk_invoices_financial_year_org_consistent")
  sourceEvent        MilestoneEvent?       @relation(fields: [sourceEventId], references: [id], map: "fk_invoices_source_event")
  sourceInstallment  MilestoneInstallment? @relation(fields: [sourceInstallmentId], references: [id], map: "fk_invoices_source_installment")
  journalEntry       JournalEntry?         @relation("InvoiceFinalizeJournalEntry", fields: [journalEntryId], references: [id], map: "fk_invoices_journal_entry")
  voidJournalEntry   JournalEntry?         @relation("InvoiceVoidJournalEntry", fields: [voidJournalEntryId], references: [id], map: "fk_invoices_void_journal_entry")
  /// The alert this invoice was raised from — set once at draft creation,
  /// immutable thereafter (distinct from PaymentAlert.invoiceId, which
  /// records which invoice currently CLOSES the alert and is cleared on
  /// void-of-finalized).
  paymentAlert         PaymentAlert          @relation("InvoiceOriginAlert", fields: [paymentAlertId], references: [id], map: "fk_invoices_payment_alert")
  convertedFromInvoice Invoice?            @relation("ProformaConversion", fields: [convertedFromInvoiceId], references: [id], onDelete: Restrict, map: "fk_invoices_converted_from")
  convertedTaxInvoices Invoice[]           @relation("ProformaConversion")
  closingAlerts        PaymentAlert[]      @relation("PaymentAlertClosingInvoice")
  lines              InvoiceLine[]
  capexSources       InvoiceCapexSource[]
  receiptAllocations ReceiptAllocation[]
  creditDebitNotes   CreditDebitNote[]

  // Hand-added in the migration SQL (Prisma's @@unique cannot express a
  // WHERE clause), matching the uq_legal_entities_org_pan precedent:
  //   UNIQUE (source_event_id) WHERE status IN ('DRAFT', 'ISSUED')         (ADR-156)
  //   UNIQUE (source_installment_id) WHERE status IN ('DRAFT', 'ISSUED')   (ADR-156)
  //   UNIQUE (organization_id, gst_registration_id, financial_year_id, invoice_number) WHERE invoice_number IS NOT NULL AND status <> 'VOID' (ADR-163)
  @@index([projectId], map: "idx_invoices_project_id")
  @@index([organizationId, status], map: "idx_invoices_org_status")
  @@map("invoices")
}

/// Invoice line item. Tax split (CGST+SGST vs IGST) is computed once at
/// finalize by comparing the buyer's state to the seller GST
/// registration's state — mutually exclusive per docs/06 — and frozen
/// here from then on, same immutability as the Invoice header's own
/// snapshot fields.
model InvoiceLine {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  sequence       Int
  description    String
  hsnSac         String?  @map("hsn_sac")
  /// Set when this line bills a CAPEX event. Several lines on one invoice
  /// can name different events. Null on OPEX lines and on older invoices.
  sourceEventId  String?  @map("source_event_id") @db.Uuid
  quantity       Decimal  @default(1) @db.Decimal(19, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(19, 4)
  taxableAmount  Decimal  @map("taxable_amount") @db.Decimal(19, 4)
  gstRatePercent Decimal  @map("gst_rate_percent") @db.Decimal(5, 2)
  cgstAmount     Decimal  @default(0) @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount     Decimal  @default(0) @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount     Decimal  @default(0) @map("igst_amount") @db.Decimal(19, 4)
  lineTotal      Decimal  @map("line_total") @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade, map: "fk_invoice_lines_invoice")
  sourceEvent MilestoneEvent? @relation(fields: [sourceEventId], references: [id], map: "fk_invoice_lines_source_event")

  @@index([invoiceId], map: "idx_invoice_lines_invoice_id")
  @@map("invoice_lines")
}

/// CAPEX events billed by one invoice (ADR-126). The invoice header still
/// stores the first event. Each further event is a row here, and so is the
/// first, so "one open invoice per event" is one index. releasedAt is set
/// when the invoice is voided or converted; finalizedAt when it is
/// finalized. Either frees the event for another invoice, and a finalized
/// row still counts as billing the event (ADR-156). OPEX does not use this
/// table.
model InvoiceCapexSource {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  paymentAlertId String    @map("payment_alert_id") @db.Uuid
  sourceEventId  String    @map("source_event_id") @db.Uuid
  releasedAt     DateTime? @map("released_at") @db.Timestamptz
  finalizedAt    DateTime? @map("finalized_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade, map: "fk_invoice_capex_sources_invoice")
  paymentAlert PaymentAlert   @relation(fields: [paymentAlertId], references: [id], map: "fk_invoice_capex_sources_alert")
  sourceEvent  MilestoneEvent @relation(fields: [sourceEventId], references: [id], map: "fk_invoice_capex_sources_event")

  @@index([invoiceId], map: "idx_invoice_capex_sources_invoice")
  @@map("invoice_capex_sources")
}

enum CreditDebitNoteType {
  CREDIT
  DEBIT
}

enum CreditDebitNoteStatus {
  DRAFT
  FINALIZED
  VOID
}

/// Credit/Debit Note (Phase 5, docs/04 §18 "Credit Note and Debit Note",
/// docs/06 "Credit note": "Reverse revenue/output tax/receivable according
/// to the credited values. Reference the original invoice and preserve
/// tax-period rules."). Corrects an already-FINALIZED Invoice without
/// voiding it — Invoice.status and its source PaymentAlert are never
/// touched by a note. One invoice may receive many notes over time (no
/// uniqueness on invoiceId, unlike Invoice's own singleton-per-milestone-
/// event constraint). Debit Note has no frozen docs/06 rule of its own —
/// confirmed with the user to post the mirror direction of Credit Note
/// (identical shape to Invoice.finalize's own journal). Lines are free-
/// form (mirroring InvoiceLine exactly), not tied to specific original
/// InvoiceLine ids — the "reference the original invoice" requirement is
/// satisfied by invoiceId + the note's own number, not line-level
/// reconciliation. A note always posts into whatever accounting period is
/// open today, never forced into the original invoice's period — same
/// precedent as the Reversal Mechanism (ADR-067).
model CreditDebitNote {
  id                String                @id @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  invoiceId         String                @map("invoice_id") @db.Uuid
  projectId         String                @map("project_id") @db.Uuid
  legalEntityId     String                @map("legal_entity_id") @db.Uuid
  gstRegistrationId String                @map("gst_registration_id") @db.Uuid
  type              CreditDebitNoteType
  status            CreditDebitNoteStatus @default(DRAFT)
  reason            String
  financialYearId   String?               @map("financial_year_id") @db.Uuid
  noteNumber        String?               @map("note_number")
  noteDate          DateTime?             @map("note_date") @db.Date

  taxableAmount Decimal? @map("taxable_amount") @db.Decimal(19, 4)
  cgstAmount    Decimal? @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount    Decimal? @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount    Decimal? @map("igst_amount") @db.Decimal(19, 4)
  totalAmount   Decimal? @map("total_amount") @db.Decimal(19, 4)

  journalEntryId     String?   @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?   @map("void_journal_entry_id") @db.Uuid
  voidReason         String?   @map("void_reason")
  voidedBy           String?   @map("voided_by") @db.Uuid
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  invoice          Invoice               @relation(fields: [invoiceId], references: [id], map: "fk_credit_debit_notes_invoice")
  project          Project               @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_credit_debit_notes_project_org_consistent")
  legalEntity      LegalEntity           @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_credit_debit_notes_legal_entity_org_consistent")
  gstRegistration  GstRegistration       @relation(fields: [gstRegistrationId, organizationId], references: [id, organizationId], map: "fk_credit_debit_notes_gst_registration_org_consistent")
  financialYear    FinancialYear?        @relation(fields: [financialYearId, organizationId], references: [id, organizationId], map: "fk_credit_debit_notes_financial_year_org_consistent")
  journalEntry     JournalEntry?         @relation("CreditDebitNoteFinalizeJournalEntry", fields: [journalEntryId], references: [id], map: "fk_credit_debit_notes_journal_entry")
  voidJournalEntry JournalEntry?         @relation("CreditDebitNoteVoidJournalEntry", fields: [voidJournalEntryId], references: [id], map: "fk_credit_debit_notes_void_journal_entry")
  lines            CreditDebitNoteLine[]

  // Hand-added in the migration SQL (Prisma's @@unique cannot express a
  // WHERE clause), matching Invoice's own numbering-index precedent. type
  // is part of the scope, so Credit and Debit Notes get independent
  // series (CN-0001, DN-0001, ...) rather than sharing one counter:
  //   UNIQUE (organization_id, gst_registration_id, financial_year_id, type, note_number) WHERE note_number IS NOT NULL
  @@index([invoiceId], map: "idx_credit_debit_notes_invoice_id")
  @@index([organizationId, status], map: "idx_credit_debit_notes_org_status")
  @@map("credit_debit_notes")
}

/// Credit/Debit Note line item — byte-for-byte the same shape as
/// InvoiceLine, free-form (not tied to a specific original InvoiceLine).
model CreditDebitNoteLine {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  creditDebitNoteId String   @map("credit_debit_note_id") @db.Uuid
  sequence          Int
  description       String
  hsnSac            String?  @map("hsn_sac")
  quantity          Decimal  @default(1) @db.Decimal(19, 4)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(19, 4)
  taxableAmount     Decimal  @map("taxable_amount") @db.Decimal(19, 4)
  gstRatePercent    Decimal  @map("gst_rate_percent") @db.Decimal(5, 2)
  cgstAmount        Decimal  @default(0) @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount        Decimal  @default(0) @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount        Decimal  @default(0) @map("igst_amount") @db.Decimal(19, 4)
  lineTotal         Decimal  @map("line_total") @db.Decimal(19, 4)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  creditDebitNote CreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade, map: "fk_credit_debit_note_lines_note")

  @@index([creditDebitNoteId], map: "idx_credit_debit_note_lines_note_id")
  @@map("credit_debit_note_lines")
}

/// Legal-entity-scoped bank account master (Phase 5.2, docs/16
/// master-bank-account.html). Free-text bank/masked-number/IFSC — no bank
/// master exists anywhere in this schema, same reasoning EMD/SD (4.5) used
/// for issuing-bank. ledgerAccountId is required (not shown as a field in
/// the prototype's own form) since a receipt cannot post without a
/// resolvable Dr/Cr account — the same justified addition EMD/SD made for
/// its own bankLedgerAccountId. isActive-only, no soft-delete, matching
/// LedgerAccount's own shape (no dependent-record guard concern yet).
model BankAccount {
  id                  String   @id @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  legalEntityId       String   @map("legal_entity_id") @db.Uuid
  ledgerAccountId     String   @map("ledger_account_id") @db.Uuid
  accountName         String   @map("account_name")
  bankName            String?  @map("bank_name")
  maskedAccountNumber   String?  @map("masked_account_number")
  /// Full number printed as Bank A/C. The masked number stays the one shown in lists.
  invoiceAccountNumber  String?  @map("invoice_account_number")
  ifsc                  String?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy           String?  @map("created_by") @db.Uuid
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy           String?  @map("updated_by") @db.Uuid
  version             Int      @default(1)

  legalEntity           LegalEntity                @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_bank_accounts_legal_entity_org_consistent")
  ledgerAccount         LedgerAccount              @relation(fields: [ledgerAccountId, organizationId], references: [id, organizationId], map: "fk_bank_accounts_ledger_account_org_consistent")
  invoices                      Invoice[]
  clientReceipts        ClientReceipt[]
  releases              DeductionRelease[]
  vendorPayments        VendorPayment[]
  employeeAdvances      EmployeeAdvance[]
  directExpenses        DirectExpense[]
  cardAccounts          CardAccount[]
  cardSettlements       CardSettlement[]
  introducerPayments    IntroducerPayment[]
  salaryPayments        SalaryPayment[]
  tdsDeposits           TdsDeposit[]
  statementProfile      BankStatementProfile?
  statementImports      BankStatementImport[]
  statementLines        BankStatementLine[]
  reconciliationMatches BankReconciliationMatch[]
  reconciliationPeriods BankReconciliationPeriod[]

  @@unique([id, organizationId], map: "uq_bank_accounts_id_org")
  @@index([legalEntityId], map: "idx_bank_accounts_legal_entity_id")
  @@map("bank_accounts")
}

enum ClientReceiptStatus {
  POSTED
  REVERSED
}

/// Client receipt header (Phase 5.2, docs/04 §11.6, docs/06 "Record client
/// receipt with deductions"). One atomic post, no draft/finalize split —
/// docs/04 names only receipt.post, matching SecurityInstrumentsService's
/// lodge precedent (4.5). Immutable after posting, same no-edit-endpoint
/// reasoning as Invoice/JournalEntry; only reverseal (ADR-067's
/// reverseJournal, reused as-is) can undo its accounting effect. No
/// partyId here — the client is implied by the invoices being allocated,
/// all of which must share one client at post time (app-validated).
model ClientReceipt {
  id                     String              @id @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  legalEntityId          String              @map("legal_entity_id") @db.Uuid
  bankAccountId          String              @map("bank_account_id") @db.Uuid
  paymentModeId          String              @map("payment_mode_id") @db.Uuid
  receiptDate            DateTime            @map("receipt_date") @db.Date
  utrReference           String?             @map("utr_reference")
  actualAmount           Decimal             @map("actual_amount") @db.Decimal(19, 4)
  status                 ClientReceiptStatus @default(POSTED)
  journalEntryId         String?             @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?             @map("reversal_journal_entry_id") @db.Uuid
  reversalReason         String?             @map("reversal_reason")
  reversedBy             String?             @map("reversed_by") @db.Uuid
  reversedAt             DateTime?           @map("reversed_at") @db.Timestamptz
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?             @map("created_by") @db.Uuid
  version                Int                 @default(1)

  legalEntity          LegalEntity         @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_client_receipts_legal_entity_org_consistent")
  bankAccount          BankAccount         @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_client_receipts_bank_account_org_consistent")
  paymentMode          PaymentMode         @relation(fields: [paymentModeId], references: [id], map: "fk_client_receipts_payment_mode")
  journalEntry         JournalEntry?       @relation("ReceiptPostJournalEntry", fields: [journalEntryId], references: [id], map: "fk_client_receipts_journal_entry")
  reversalJournalEntry JournalEntry?       @relation("ReceiptReversalJournalEntry", fields: [reversalJournalEntryId], references: [id], map: "fk_client_receipts_reversal_journal_entry")
  allocations          ReceiptAllocation[]

  @@index([organizationId, legalEntityId], map: "idx_client_receipts_org_legal_entity")
  @@map("client_receipts")
}

/// One row per invoice settled by a receipt (docs/01: "one client
/// remittance may settle multiple invoices," "one invoice may receive
/// multiple receipts" — so no uniqueness constraint on invoiceId alone).
/// invoice*Snapshot fields are copied at allocation time and frozen —
/// docs/04: "Invoice taxable amount, CGST, SGST, IGST and total are
/// read-only." settledAmount is computed once at post
/// (cashAllocated + sum of this allocation's deductions, docs/03's
/// invariant literally) and never recomputed afterward.
model ReceiptAllocation {
  id                           String   @id @db.Uuid
  organizationId               String   @map("organization_id") @db.Uuid
  receiptId                    String   @map("receipt_id") @db.Uuid
  invoiceId                    String   @map("invoice_id") @db.Uuid
  invoiceTaxableAmountSnapshot Decimal  @map("invoice_taxable_amount_snapshot") @db.Decimal(19, 4)
  invoiceCgstSnapshot          Decimal  @map("invoice_cgst_snapshot") @db.Decimal(19, 4)
  invoiceSgstSnapshot          Decimal  @map("invoice_sgst_snapshot") @db.Decimal(19, 4)
  invoiceIgstSnapshot          Decimal  @map("invoice_igst_snapshot") @db.Decimal(19, 4)
  invoiceTotalSnapshot         Decimal  @map("invoice_total_snapshot") @db.Decimal(19, 4)
  cashAllocated                Decimal  @map("cash_allocated") @db.Decimal(19, 4)
  settledAmount                Decimal  @map("settled_amount") @db.Decimal(19, 4)
  /// The one CAPEX event of a multi-event invoice this allocation pays
  /// (ADR-151); null = the whole invoice.
  sourceEventId                String?  @map("source_event_id") @db.Uuid
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz

  receipt     ClientReceipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade, map: "fk_receipt_allocations_receipt")
  invoice     Invoice               @relation(fields: [invoiceId], references: [id], map: "fk_receipt_allocations_invoice")
  sourceEvent MilestoneEvent?       @relation(fields: [sourceEventId], references: [id], map: "fk_receipt_allocations_source_event")
  deductions  AllocationDeduction[]

  @@index([receiptId], map: "idx_receipt_allocations_receipt_id")
  @@index([invoiceId], map: "idx_receipt_allocations_invoice_id")
  @@index([sourceEventId], map: "idx_receipt_allocations_source_event_id")
  @@map("receipt_allocations")
}

enum AllocationDeductionType {
  TDS
  CGST_TDS
  SGST_TDS
  IGST_TDS
  HOLD
  RETENTION
  ACCEPTED_PENALTY
  DISPUTED_PENALTY
  OTHER
}

/// Typed deduction line under one allocation (docs/01: "TDS, GST-TDS,
/// hold, retention, penalties, and other deductions are separately
/// classified and lifecycle-tracked"). ratePercent is display-only
/// (docs/04 prototype hint: "rate is dynamic") — never drives amount
/// computation. penaltyCategoryId required only for ACCEPTED_PENALTY/
/// DISPUTED_PENALTY; otherLedgerAccountId required only for OTHER (no
/// master exists for arbitrary other-deduction types, so the ledger
/// account is picked directly — same pattern as EMD/SD's bank-account
/// picker). Outstanding-for-release amount is computed live
/// (amount - sum(releases.releasedAmount)), never stored, matching
/// PaymentAlert's "always read live" precedent.
model AllocationDeduction {
  id                   String                  @id @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  allocationId         String                  @map("allocation_id") @db.Uuid
  type                 AllocationDeductionType
  amount               Decimal                 @db.Decimal(19, 4)
  ratePercent          Decimal?                @map("rate_percent") @db.Decimal(5, 2)
  penaltyCategoryId    String?                 @map("penalty_category_id") @db.Uuid
  otherLedgerAccountId String?                 @map("other_ledger_account_id") @db.Uuid
  narrative            String?
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz

  allocation            ReceiptAllocation     @relation(fields: [allocationId], references: [id], onDelete: Cascade, map: "fk_allocation_deductions_allocation")
  penaltyCategory       PenaltyCategory?      @relation(fields: [penaltyCategoryId, organizationId], references: [id, organizationId], map: "fk_allocation_deductions_penalty_category_org_consistent")
  otherLedgerAccount    LedgerAccount?        @relation(fields: [otherLedgerAccountId, organizationId], references: [id, organizationId], map: "fk_allocation_deductions_other_ledger_account_org_consistent")
  releases              DeductionRelease[]
  tdsCertificateMatches TdsCertificateMatch[]

  @@index([allocationId], map: "idx_allocation_deductions_allocation_id")
  @@map("allocation_deductions")
}

/// A release against a HOLD/RETENTION deduction (app-validated type,
/// no DB CHECK — the two allowed types live on a shared table with
/// others). Immutable once created — a release is itself a small posting
/// event, same no-edit reasoning as every other financial record here.
/// docs/06 "Hold/retention release": Dr Bank; Cr Hold/Retention Receivable.
model DeductionRelease {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  deductionId    String   @map("deduction_id") @db.Uuid
  releasedAmount Decimal  @map("released_amount") @db.Decimal(19, 4)
  releasedOn     DateTime @map("released_on") @db.Date
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  utrReference   String?  @map("utr_reference")
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  correlationId  String?  @map("correlation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  deduction    AllocationDeduction @relation(fields: [deductionId], references: [id], map: "fk_deduction_releases_deduction")
  bankAccount  BankAccount         @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_deduction_releases_bank_account_org_consistent")
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id], map: "fk_deduction_releases_journal_entry")

  @@index([deductionId], map: "idx_deduction_releases_deduction_id")
  @@map("deduction_releases")
}

enum VendorBillPriority {
  NORMAL
  URGENT
  LOW
}

enum VendorBillStatus {
  DRAFT
  SUBMITTED
  FINALIZED
  REJECTED
  CANCELLED
  VOID
}

enum VendorBillDecisionType {
  APPROVED
  REJECTED
}

/// Phase 6.2, restructured in Phase 6.4 to absorb Purchase Request's own
/// fields and maker-checker workflow (docs/12 ADR-079) — Purchase Request no
/// longer exists as a separate pre-bill estimate/approval document. A
/// Vendor Bill is now raised directly with the real invoice in hand
/// (vendorId/projectId/priority entered here, legalEntityId derived from
/// the selected Project) and carries its own full lifecycle: DRAFT (freely
/// editable) -> SUBMITTED (frozen, awaiting approval) -> FINALIZED, where
/// approve() both runs the maker-checker decision (creator cannot approve
/// their own bill unless they hold vendor_bill.self_approve, mirroring
/// Purchase Request's own isSelfApproval pattern verbatim onto
/// VendorBillDecision) AND posts the docs/06 journal entry (Dr Expense/
/// Project Cost + Input CGST/SGST/IGST Receivable; Cr Accounts Payable —
/// Vendor) in the same transaction — there is no longer a separate,
/// unguarded "finalize" step. REJECTED is terminal (SUBMITTED only).
/// CANCELLED is a creator-only withdrawal from DRAFT/SUBMITTED, mirroring
/// Purchase Request's own header-column cancellation shape exactly (not a
/// VendorBillDecision row, matching how Purchase Request itself never put
/// CANCELLED in its own decision table). VOID remains unchanged — reserved
/// for reversing an already-posted (FINALIZED) bill's journal entry, never
/// for withdrawing an unposted draft/submission (that's what CANCELLED is
/// for now). vendorBillNumber is still the VENDOR's own invoice number
/// (free text, never system-generated) — uq_vendor_bills_vendor_number
/// (hand-added, partial WHERE status NOT IN ('VOID','CANCELLED')) stops the
/// same vendor invoice from being recorded twice while still letting a
/// voided OR cancelled entry's number be reused (neither ever posted
/// anything), same precedent as uq_invoices_source_event_active.
model VendorBill {
  id                String             @id @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  /// Optional (ADR-177): a bill without a project is company overhead, its
  /// legal entity chosen directly.
  projectId         String?            @map("project_id") @db.Uuid
  /// Links to the vendor's invoice and to the payment receipt (a drive or
  /// portal URL, or a file name as the sheet had it), ADR-178.
  billUrl           String?            @map("bill_url")
  paymentReceiptUrl String?            @map("payment_receipt_url")
  vendorId          String             @map("vendor_id") @db.Uuid
  priority          VendorBillPriority @default(NORMAL)
  legalEntityId     String             @map("legal_entity_id") @db.Uuid
  gstRegistrationId String             @map("gst_registration_id") @db.Uuid
  financialYearId   String?            @map("financial_year_id") @db.Uuid
  vendorBillNumber  String             @map("vendor_bill_number")
  vendorBillDate    DateTime           @map("vendor_bill_date") @db.Date
  status            VendorBillStatus   @default(DRAFT)

  // Header summary totals — always the sum across lines regardless of ITC
  // eligibility (that split only affects the journal, computed fresh from
  // lines at approve, never stored separately here). Null until approved.
  taxableAmount Decimal? @map("taxable_amount") @db.Decimal(19, 4)
  cgstAmount    Decimal? @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount    Decimal? @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount    Decimal? @map("igst_amount") @db.Decimal(19, 4)
  totalAmount   Decimal? @map("total_amount") @db.Decimal(19, 4)

  journalEntryId     String?   @map("journal_entry_id") @db.Uuid
  voidJournalEntryId String?   @map("void_journal_entry_id") @db.Uuid
  voidReason         String?   @map("void_reason")
  voidedBy           String?   @map("voided_by") @db.Uuid
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelledReason String?   @map("cancelled_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  project             Project?             @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_vendor_bills_project_org_consistent")
  vendor              Party                @relation(fields: [vendorId, organizationId], references: [id, organizationId], map: "fk_vendor_bills_vendor_org_consistent")
  legalEntity         LegalEntity          @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_vendor_bills_legal_entity_org_consistent")
  gstRegistration     GstRegistration      @relation(fields: [gstRegistrationId, organizationId], references: [id, organizationId], map: "fk_vendor_bills_gst_registration_org_consistent")
  financialYear       FinancialYear?       @relation(fields: [financialYearId, organizationId], references: [id, organizationId], map: "fk_vendor_bills_financial_year_org_consistent")
  journalEntry        JournalEntry?        @relation("VendorBillFinalizeJournalEntry", fields: [journalEntryId], references: [id], map: "fk_vendor_bills_journal_entry")
  voidJournalEntry    JournalEntry?        @relation("VendorBillVoidJournalEntry", fields: [voidJournalEntryId], references: [id], map: "fk_vendor_bills_void_journal_entry")
  lines               VendorBillLine[]
  decisions           VendorBillDecision[]
  paymentRequestLines PaymentRequestLine[]

  // uq_vendor_bills_vendor_number hand-added in the migration SQL (Prisma's
  // @@unique cannot express a WHERE clause) — see doc comment above.
  // uq_vendor_bills_id_org (Phase 6.3) is the same "id+org" composite-unique
  // support constraint Party/LegalEntity/BankAccount/DocumentCategory each
  // already carry — added here because PaymentRequestLine is the first
  // model that needs an org-consistent composite FK into VendorBill.
  @@unique([id, organizationId], map: "uq_vendor_bills_id_org")
  @@index([projectId], map: "idx_vendor_bills_project_id")
  @@index([vendorId], map: "idx_vendor_bills_vendor_id")
  @@index([organizationId, status], map: "idx_vendor_bills_org_status")
  @@map("vendor_bills")
}

/// Byte-for-byte the same shape as InvoiceLine, plus expenseCategoryId
/// (resolves which expense ledger account this line debits at finalize —
/// via ExpenseCategory.ledgerAccountId, falling back to a default account
/// when unset) and itcEligible (docs/06: "Ineligible GST is included in
/// cost rather than Input GST Receivable" — a per-line decision, since one
/// bill can mix eligible and blocked items).
model VendorBillLine {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  vendorBillId      String   @map("vendor_bill_id") @db.Uuid
  /// Exactly one of expenseCategoryId / inventoryItemId is set, enforced by
  /// chk_vendor_bill_lines_expense_or_inventory (Phase 7.2, ADR-092). An
  /// expense line resolves its debit through ExpenseCategory.ledgerAccountId
  /// (falling back to OTHER_EXPENSES); a stock line debits INVENTORY and
  /// creates an InventoryMovement in the same transaction as the bill's own
  /// journal — docs/06's two separate "Finalize vendor bill" tables.
  ///
  /// Nullable only because of that either/or: every pre-7.2 row has it set,
  /// and the NOT NULL was dropped, not the data.
  expenseCategoryId String?  @map("expense_category_id") @db.Uuid
  /// Set only for a stock line, and only ever to an is_stock_tracked item.
  inventoryItemId   String?  @map("inventory_item_id") @db.Uuid
  // Nullable at the DB layer only because a real (already-VOID) row
  // predates this column with no UnitOfMeasure data to backfill it from —
  // same nullable shape as ExpenseCategory.ledgerAccountId elsewhere on
  // this same table. Every new create/update call requires it (zod
  // `.uuid()`, no `.optional()`) — this is a legacy-row accommodation,
  // not a real optionality.
  unitOfMeasureId   String?  @map("unit_of_measure_id") @db.Uuid
  sequence          Int
  description       String
  hsnSac            String?  @map("hsn_sac")
  quantity          Decimal  @default(1) @db.Decimal(19, 4)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(19, 4)
  taxableAmount     Decimal  @map("taxable_amount") @db.Decimal(19, 4)
  gstRatePercent    Decimal  @map("gst_rate_percent") @db.Decimal(5, 2)
  cgstAmount        Decimal  @default(0) @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount        Decimal  @default(0) @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount        Decimal  @default(0) @map("igst_amount") @db.Decimal(19, 4)
  itcEligible       Boolean  @default(true) @map("itc_eligible")
  lineTotal         Decimal  @map("line_total") @db.Decimal(19, 4)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendorBill         VendorBill          @relation(fields: [vendorBillId], references: [id], onDelete: Cascade, map: "fk_vendor_bill_lines_vendor_bill")
  expenseCategory    ExpenseCategory?    @relation(fields: [expenseCategoryId, organizationId], references: [id, organizationId], map: "fk_vendor_bill_lines_expense_category_org_consistent")
  inventoryItem      InventoryItem?      @relation(fields: [inventoryItemId, organizationId], references: [id, organizationId], map: "fk_vendor_bill_lines_inventory_item_org_consistent")
  inventoryMovements InventoryMovement[]
  unitOfMeasure      UnitOfMeasure?      @relation(fields: [unitOfMeasureId, organizationId], references: [id, organizationId], map: "fk_vendor_bill_lines_unit_of_measure_org_consistent")

  @@index([vendorBillId], map: "idx_vendor_bill_lines_vendor_bill_id")
  @@map("vendor_bill_lines")
}

/// Append-only maker-checker decision ledger for VendorBill's own approve/
/// reject step — mirrors the deleted PurchaseRequestDecision exactly. note
/// is nullable at the schema level; VendorBillsService enforces it
/// non-empty whenever decision=REJECTED or isSelfApproval=true (the same
/// service-level required-reason pattern as Invoice.voidReason).
/// isSelfApproval is set true only when actorId equals the bill's own
/// createdBy at decision time (necessarily an actor holding
/// vendor_bill.self_approve) — an explicit, permanent record of the
/// exception, not inferred after the fact. CANCELLED is deliberately not a
/// decision here — it stays VendorBill's own header columns
/// (cancelledAt/cancelledBy/cancelledReason), matching how
/// PurchaseRequestDecision itself never recorded CANCELLED either.
model VendorBillDecision {
  id             String                 @id @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  vendorBillId   String                 @map("vendor_bill_id") @db.Uuid
  decision       VendorBillDecisionType
  actorId        String                 @map("actor_id") @db.Uuid
  decidedAt      DateTime               @default(now()) @map("decided_at") @db.Timestamptz
  note           String?
  isSelfApproval Boolean                @default(false) @map("is_self_approval")

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], map: "fk_vendor_bill_decisions_vendor_bill")

  @@index([vendorBillId], map: "idx_vendor_bill_decisions_vendor_bill_id")
  @@map("vendor_bill_decisions")
}

enum PaymentRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

enum PaymentRequestDecisionType {
  APPROVED
  REJECTED
  REVOKED
}

/// Phase 6.3 — the maker-checker authorization/reservation gate between
/// VendorBill (Phase 6.2, restructured Phase 6.4) and the not-yet-built
/// VendorPayment (Phase 6.4). Zero accounting effect at any status (docs/05:
/// "Approval creates no accounting entry" applies identically here — the
/// only real posting on the purchase side still happens at
/// VendorBill.approve). One request may batch several FINALIZED
/// VendorBills for the SAME vendor + legal entity (confirmed via
/// AskUserQuestion) — service-enforced, not DB-enforced, since a header
/// row alone can't express "every child line shares these two values."
/// requestedAmount on each line is the GROSS vendor-liability amount being
/// authorized for settlement, not a projected bank outflow — how a future
/// VendorPayment later splits that into cash paid vs. TDS withheld is
/// entirely a Phase 6.4 concern; no TDS field exists anywhere on this
/// model. requestNumber ("PMR-000001") is assigned at draft creation via
/// the shared generateSequentialNumber helper (apps/api/src/common/
/// sequential-number.util.ts), the same retry-on-collision pattern
/// VendorBill/Invoice numbering already use. title/description were
/// deliberately dropped (confirmed via design review) — a display title is
/// computed on read ("Payment to {vendorName} — {requestNumber}"), never
/// stored. priority reuses VendorBillPriority (renamed from
/// PurchaseRequestPriority when Purchase Request was merged into Vendor
/// Bill, Phase 6.4 — this column's own type never changed).
/// requestedPaymentDate is the planned execution date only; it has no
/// accounting effect and may differ from VendorPayment's own actual
/// payment date once that exists. REVOKED (from APPROVED only) releases an
/// approved request's reservation without ever having posted anything —
/// recorded as a PaymentRequestDecision row like APPROVED/REJECTED, not
/// separate header timestamp columns. Once Phase 6.4 exists, revoke must
/// additionally reject if any VendorPaymentAllocation already references
/// one of this request's lines — enforced there, not here (nothing to
/// check against yet).
model PaymentRequest {
  id                   String               @id @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  requestNumber        String?              @map("request_number")
  vendorId             String               @map("vendor_id") @db.Uuid
  legalEntityId        String               @map("legal_entity_id") @db.Uuid
  requestedPaymentDate DateTime             @map("requested_payment_date") @db.Date
  priority             VendorBillPriority   @default(NORMAL)
  remarks              String?
  totalRequestedAmount Decimal?             @map("total_requested_amount") @db.Decimal(19, 4)
  status               PaymentRequestStatus @default(DRAFT)
  submittedAt          DateTime?            @map("submitted_at") @db.Timestamptz
  cancelledAt          DateTime?            @map("cancelled_at") @db.Timestamptz
  cancelledBy          String?              @map("cancelled_by") @db.Uuid
  cancelledReason      String?              @map("cancelled_reason")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String?              @map("created_by") @db.Uuid
  updatedAt            DateTime             @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy            String?              @map("updated_by") @db.Uuid
  version              Int                  @default(1)

  vendor      Party                    @relation(fields: [vendorId, organizationId], references: [id, organizationId], map: "fk_payment_requests_vendor_org_consistent")
  legalEntity LegalEntity              @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_payment_requests_legal_entity_org_consistent")
  lines       PaymentRequestLine[]
  decisions   PaymentRequestDecision[]

  @@unique([organizationId, requestNumber], map: "uq_payment_requests_org_number")
  @@index([organizationId, status], map: "idx_payment_requests_org_status")
  @@index([vendorId], map: "idx_payment_requests_vendor_id")
  @@index([legalEntityId], map: "idx_payment_requests_legal_entity_id")
  @@map("payment_requests")
}

/// One row per finalized VendorBill included in this batch request.
/// requestedAmount is capped, at submit time, against the bill's own live
/// "available for request" balance (vendorBill.totalAmount minus the sum
/// of requestedAmount across every OTHER line referencing this same bill
/// whose parent request is SUBMITTED or APPROVED) — computed by
/// PaymentRequestsService.getAvailableForRequest, the single shared helper
/// backing this check, calculatePreview, and getEligibleBills alike.
/// @@unique([paymentRequestId, vendorBillId]) stops the same bill being
/// added twice within one request at the database layer, not just in the
/// service. No uniqueness on vendorBillId alone — the same bill may
/// legitimately appear in a later, separate request (partial payment over
/// time).
model PaymentRequestLine {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  paymentRequestId String   @map("payment_request_id") @db.Uuid
  vendorBillId     String   @map("vendor_bill_id") @db.Uuid
  requestedAmount  Decimal  @map("requested_amount") @db.Decimal(19, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  paymentRequest PaymentRequest            @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade, map: "fk_payment_request_lines_request")
  vendorBill     VendorBill                @relation(fields: [vendorBillId, organizationId], references: [id, organizationId], map: "fk_payment_request_lines_vendor_bill_org_consistent")
  allocations    VendorPaymentAllocation[]

  @@unique([paymentRequestId, vendorBillId], map: "uq_payment_request_lines_request_bill")
  @@index([paymentRequestId], map: "idx_payment_request_lines_request_id")
  @@index([vendorBillId], map: "idx_payment_request_lines_vendor_bill_id")
  @@map("payment_request_lines")
}

/// Append-only maker-checker decision ledger — byte-for-byte the same
/// shape as PurchaseRequestDecision, plus REVOKED as a third decision
/// type. note is nullable at the schema level; PaymentRequestsService
/// enforces it non-empty whenever decision IN (REJECTED, REVOKED) or
/// isSelfApproval=true.
model PaymentRequestDecision {
  id               String                     @id @db.Uuid
  organizationId   String                     @map("organization_id") @db.Uuid
  paymentRequestId String                     @map("payment_request_id") @db.Uuid
  decision         PaymentRequestDecisionType
  actorId          String                     @map("actor_id") @db.Uuid
  decidedAt        DateTime                   @default(now()) @map("decided_at") @db.Timestamptz
  note             String?
  isSelfApproval   Boolean                    @default(false) @map("is_self_approval")

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], map: "fk_payment_request_decisions_request")

  @@index([paymentRequestId], map: "idx_payment_request_decisions_request_id")
  @@map("payment_request_decisions")
}

enum VendorPaymentStatus {
  POSTED
  REVERSED
}

/// TDS/GST-TDS subset of AllocationDeductionType only (docs/12 ADR-080) --
/// Hold/Retention/Penalty-on-payment were explicitly deferred (confirmed via
/// AskUserQuestion): nothing in this codebase withholds a hold/retention/
/// penalty amount from an outbound vendor payment the way a client receipt
/// withholds one from an inbound one, so there is no symmetric deduction
/// concept to model yet on the payable side.
enum VendorPaymentDeductionType {
  TDS
  CGST_TDS
  SGST_TDS
  IGST_TDS
}

/// Phase 6.5 (Vendor Payment, ADR-080) -- the final step of the procurement
/// chain that actually moves money: VendorBill (6.2/6.4) -> PaymentRequest
/// (6.3, authorization/reservation only, zero accounting effect) ->
/// VendorPayment (this model, posts Dr Accounts Payable -- Vendor / Cr Bank /
/// Cr TDS+GST-TDS Payable). Direct mirror of ClientReceipt with the
/// debit/credit sides flipped -- paying down a liability instead of
/// collecting a receivable -- and PaymentRequestLine standing in for Invoice
/// as the thing being allocated against. One atomic post, no draft/finalize
/// split, same as ClientReceipt: the authorization gate already happened at
/// PaymentRequest's own approve(), so there is no maker-checker here. No
/// vendorId column here either, same reasoning as ClientReceipt having no
/// clientId -- the vendor is implied by the allocations, all of which must
/// share one vendor + one legal entity (app-validated at post time, matching
/// the bank account's own legal entity). No generated payment number,
/// matching ClientReceipt's own precedent of being identified by its own id.
model VendorPayment {
  id                     String              @id @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  legalEntityId          String              @map("legal_entity_id") @db.Uuid
  /// Exactly one of bankAccountId / cardAccountId (ADR-179): a credit card
  /// payment moves the debt to the card's payable instead of the bank.
  bankAccountId          String?             @map("bank_account_id") @db.Uuid
  cardAccountId          String?             @map("card_account_id") @db.Uuid
  paymentModeId          String              @map("payment_mode_id") @db.Uuid
  paymentDate            DateTime            @map("payment_date") @db.Date
  utrReference           String?             @map("utr_reference")
  actualAmount           Decimal             @map("actual_amount") @db.Decimal(19, 4)
  status                 VendorPaymentStatus @default(POSTED)
  journalEntryId         String?             @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?             @map("reversal_journal_entry_id") @db.Uuid
  reversalReason         String?             @map("reversal_reason")
  reversedBy             String?             @map("reversed_by") @db.Uuid
  reversedAt             DateTime?           @map("reversed_at") @db.Timestamptz
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?             @map("created_by") @db.Uuid
  version                Int                 @default(1)

  legalEntity          LegalEntity               @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_vendor_payments_legal_entity_org_consistent")
  bankAccount          BankAccount?              @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_vendor_payments_bank_account_org_consistent")
  cardAccount          CardAccount?              @relation(fields: [cardAccountId, organizationId], references: [id, organizationId], map: "fk_vendor_payments_card_account_org_consistent")
  paymentMode          PaymentMode               @relation(fields: [paymentModeId], references: [id], map: "fk_vendor_payments_payment_mode")
  journalEntry         JournalEntry?             @relation("VendorPaymentPostJournalEntry", fields: [journalEntryId], references: [id], map: "fk_vendor_payments_journal_entry")
  reversalJournalEntry JournalEntry?             @relation("VendorPaymentReversalJournalEntry", fields: [reversalJournalEntryId], references: [id], map: "fk_vendor_payments_reversal_journal_entry")
  allocations          VendorPaymentAllocation[]

  @@index([organizationId, legalEntityId], map: "idx_vendor_payments_org_legal_entity")
  @@map("vendor_payments")
}

/// One row per PaymentRequestLine settled by a vendor payment (docs/12
/// ADR-078: a payment request line's authorized amount may be paid across
/// multiple vendor payments over time, and one vendor payment may batch
/// several lines for the same vendor+legal entity -- confirmed via
/// AskUserQuestion, mirroring ReceiptAllocation's own multi-invoice
/// batching and Payment Request's own partial-request design). Snapshot
/// fields are copied at allocation time and frozen, same reasoning as
/// ReceiptAllocation's invoice*Snapshot columns --
/// vendorBillTaxableAmountSnapshot exists purely as a TDS-rate display
/// convenience (the underlying bill's own taxable base), requestedAmountSnapshot
/// records this line's own authorized ceiling at allocation time.
/// settledAmount (= cashPaid + sum of this allocation's deductions) is
/// computed once at post and never recomputed afterward, the same
/// docs/03 invariant ReceiptAllocation.settledAmount already implements.
/// No @@unique on paymentRequestLineId alone -- the same line may
/// legitimately receive several allocations across separate vendor
/// payments (partial payment over time).
model VendorPaymentAllocation {
  id                              String   @id @db.Uuid
  organizationId                  String   @map("organization_id") @db.Uuid
  paymentId                       String   @map("payment_id") @db.Uuid
  paymentRequestLineId            String   @map("payment_request_line_id") @db.Uuid
  vendorBillTaxableAmountSnapshot Decimal  @map("vendor_bill_taxable_amount_snapshot") @db.Decimal(19, 4)
  requestedAmountSnapshot         Decimal  @map("requested_amount_snapshot") @db.Decimal(19, 4)
  cashPaid                        Decimal  @map("cash_paid") @db.Decimal(19, 4)
  settledAmount                   Decimal  @map("settled_amount") @db.Decimal(19, 4)
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment            VendorPayment            @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "fk_vendor_payment_allocations_payment")
  paymentRequestLine PaymentRequestLine       @relation(fields: [paymentRequestLineId], references: [id], map: "fk_vendor_payment_allocations_request_line")
  deductions         VendorPaymentDeduction[]

  @@index([paymentId], map: "idx_vendor_payment_allocations_payment_id")
  @@index([paymentRequestLineId], map: "idx_vendor_payment_allocations_request_line_id")
  @@map("vendor_payment_allocations")
}

/// Typed TDS/GST-TDS deduction line under one allocation -- narrowed
/// AllocationDeduction (docs/12 ADR-080: free-entered amount, no TDS
/// section/rate master this slice, confirmed via AskUserQuestion).
/// ratePercent is display-only, same as AllocationDeduction.ratePercent --
/// never drives amount computation. No penaltyCategoryId/otherLedgerAccountId
/// -- VendorPaymentDeductionType has no ACCEPTED_PENALTY/DISPUTED_PENALTY/
/// OTHER variants to need them.
model VendorPaymentDeduction {
  id             String                     @id @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  allocationId   String                     @map("allocation_id") @db.Uuid
  type           VendorPaymentDeductionType
  amount         Decimal                    @db.Decimal(19, 4)
  ratePercent    Decimal?                   @map("rate_percent") @db.Decimal(5, 2)
  narrative      String?
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  allocation VendorPaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade, map: "fk_vendor_payment_deductions_allocation")

  @@index([allocationId], map: "idx_vendor_payment_deductions_allocation_id")
  @@map("vendor_payment_deductions")
}

enum EmployeeAdvanceStatus {
  POSTED
  REVERSED
}

/// Phase 6.6 (Employee Advance & Expense Claim, docs/12 ADR-081). Cash handed
/// to a reimbursable employee ahead of spending -- Dr EMPLOYEE_ADVANCE_RECEIVABLE
/// (employeeId dimension) / Cr the paying bank account. One atomic post, no
/// maker-checker (mirrors ClientReceipt's own shape exactly -- issuing an
/// advance is a plain treasury action, not something requiring approval).
/// bankAccountId/paymentModeId are both always required, same as
/// ClientReceipt/VendorPayment -- a "Cash" payment mode still resolves
/// through a real BankAccount row representing cash-in-hand, never a
/// conditionally-hidden field. EMPLOYEE_ADVANCE_RECEIVABLE is a bidirectional
/// control account (see EmployeeExpenseClaim's own doc comment) -- issuing an
/// advance and reimbursing an already-approved claim post the identical
/// Dr-control-account/Cr-Bank shape; only the business trigger differs.
model EmployeeAdvance {
  id                     String                @id @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  legalEntityId          String                @map("legal_entity_id") @db.Uuid
  employeeId             String                @map("employee_id") @db.Uuid
  projectId              String?               @map("project_id") @db.Uuid
  amount                 Decimal               @db.Decimal(19, 4)
  advanceDate            DateTime              @map("advance_date") @db.Date
  paymentModeId          String                @map("payment_mode_id") @db.Uuid
  bankAccountId          String                @map("bank_account_id") @db.Uuid
  utrReference           String?               @map("utr_reference")
  purpose                String?
  note                   String?
  status                 EmployeeAdvanceStatus @default(POSTED)
  journalEntryId         String?               @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?               @map("reversal_journal_entry_id") @db.Uuid
  reversalReason         String?               @map("reversal_reason")
  reversedBy             String?               @map("reversed_by") @db.Uuid
  reversedAt             DateTime?             @map("reversed_at") @db.Timestamptz
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?               @map("created_by") @db.Uuid
  version                Int                   @default(1)

  legalEntity          LegalEntity   @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_employee_advances_legal_entity_org_consistent")
  employee             Employee      @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_employee_advances_employee_org_consistent")
  project              Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_employee_advances_project_org_consistent")
  paymentMode          PaymentMode   @relation(fields: [paymentModeId], references: [id], map: "fk_employee_advances_payment_mode")
  bankAccount          BankAccount   @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_employee_advances_bank_account_org_consistent")
  journalEntry         JournalEntry? @relation("EmployeeAdvancePostJournalEntry", fields: [journalEntryId], references: [id], map: "fk_employee_advances_journal_entry")
  reversalJournalEntry JournalEntry? @relation("EmployeeAdvanceReversalJournalEntry", fields: [reversalJournalEntryId], references: [id], map: "fk_employee_advances_reversal_journal_entry")

  @@index([organizationId, employeeId], map: "idx_employee_advances_org_employee")
  @@map("employee_advances")
}

enum EmployeeExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  REIMBURSED
}

enum EmployeeExpenseClaimDecisionType {
  APPROVED
  REJECTED
}

/// Phase 6.6 (Employee Advance & Expense Claim, docs/12 ADR-081). An
/// employee's own out-of-pocket expense, submitted for maker-checker
/// approval -- DRAFT -> SUBMITTED -> APPROVED/REJECTED (mirrors VendorBill's
/// own shape exactly, ported verbatim: self-approval requires
/// employee_claim.self_approve plus a mandatory note, recorded on
/// EmployeeExpenseClaimDecision); DRAFT/SUBMITTED -> CANCELLED (creator-only,
/// reason required). APPROVED -> REIMBURSED is a fifth, later state unique to
/// this model -- approve() itself already posts the expense-recognition
/// journal (Dr [expense category ledger account] + Dr INPUT_GST_RECEIVABLE_EXPENSE
/// [gstCreditAmount, flat, no CGST/SGST/IGST split] / Cr EMPLOYEE_ADVANCE_RECEIVABLE),
/// a deliberate departure from Vendor Bill/Payment Request's own
/// "approval posts nothing" pattern (confirmed via AskUserQuestion -- docs/06
/// names "Approved expense claim against advance" as its own real posting
/// rule). reimburse() posts a second, later, independent journal
/// (Dr EMPLOYEE_ADVANCE_RECEIVABLE / Cr Bank) settling this one claim's own
/// approved amount -- no partial/batched reimbursement this slice. Only
/// post-reimbursement correction ships (reverseReimbursement, mirroring
/// ReceiptsService.reverseReceipt/VendorPaymentsService.reverseVendorPayment
/// exactly) -- reversing an APPROVED-but-not-yet-reimbursed claim's own
/// approve-journal is explicitly out of scope (disclosed, not silently
/// dropped: no cash has moved yet at that point). gstCreditAmount is a flat,
/// user-entered amount (no rate, no split) -- deliberately simpler than
/// Vendor Bill's own GST engine, confirmed via AskUserQuestion. projectId is
/// nullable ("company overhead"); when null, legalEntityId is entered
/// directly (auto-selected if the org has exactly one, else a picker --
/// reuses Payment Request's own already-proven Legal Entity selection
/// workflow) rather than derived from a project.
model EmployeeExpenseClaim {
  id                                  String                     @id @db.Uuid
  organizationId                      String                     @map("organization_id") @db.Uuid
  legalEntityId                       String                     @map("legal_entity_id") @db.Uuid
  employeeId                          String                     @map("employee_id") @db.Uuid
  expenseCategoryId                   String                     @map("expense_category_id") @db.Uuid
  title                               String
  projectId                           String?                    @map("project_id") @db.Uuid
  amount                              Decimal                    @db.Decimal(19, 4)
  expenseDate                         DateTime                   @map("expense_date") @db.Date
  gstInvoiceAvailable                 Boolean                    @default(false) @map("gst_invoice_available")
  gstCreditAmount                     Decimal                    @default(0) @map("gst_credit_amount") @db.Decimal(19, 4)
  note                                String?
  status                              EmployeeExpenseClaimStatus @default(DRAFT)
  submittedAt                         DateTime?                  @map("submitted_at") @db.Timestamptz
  cancelledAt                         DateTime?                  @map("cancelled_at") @db.Timestamptz
  cancelledBy                         String?                    @map("cancelled_by") @db.Uuid
  cancelledReason                     String?                    @map("cancelled_reason")
  journalEntryId                      String?                    @map("journal_entry_id") @db.Uuid
  reimbursementJournalEntryId         String?                    @map("reimbursement_journal_entry_id") @db.Uuid
  reimbursementReversalJournalEntryId String?                    @map("reimbursement_reversal_journal_entry_id") @db.Uuid
  reimbursementReversalReason         String?                    @map("reimbursement_reversal_reason")
  reimbursedAt                        DateTime?                  @map("reimbursed_at") @db.Timestamptz
  reimbursedBy                        String?                    @map("reimbursed_by") @db.Uuid
  createdAt                           DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  createdBy                           String?                    @map("created_by") @db.Uuid
  updatedAt                           DateTime                   @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy                           String?                    @map("updated_by") @db.Uuid
  version                             Int                        @default(1)

  legalEntity                       LegalEntity                    @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_employee_expense_claims_legal_entity_org_consistent")
  employee                          Employee                       @relation(fields: [employeeId, organizationId], references: [id, organizationId], map: "fk_employee_expense_claims_employee_org_consistent")
  expenseCategory                   ExpenseCategory                @relation(fields: [expenseCategoryId, organizationId], references: [id, organizationId], map: "fk_employee_expense_claims_expense_category_org_consistent")
  project                           Project?                       @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_employee_expense_claims_project_org_consistent")
  journalEntry                      JournalEntry?                  @relation("EmployeeExpenseClaimApproveJournalEntry", fields: [journalEntryId], references: [id], map: "fk_employee_expense_claims_journal_entry")
  reimbursementJournalEntry         JournalEntry?                  @relation("EmployeeExpenseClaimReimburseJournalEntry", fields: [reimbursementJournalEntryId], references: [id], map: "fk_employee_expense_claims_reimbursement_journal_entry")
  reimbursementReversalJournalEntry JournalEntry?                  @relation("EmployeeExpenseClaimReimburseReversalJournalEntry", fields: [reimbursementReversalJournalEntryId], references: [id], map: "fk_employee_expense_claims_reimbursement_reversal_journal_entry")
  decisions                         EmployeeExpenseClaimDecision[]

  @@index([organizationId, employeeId], map: "idx_employee_expense_claims_org_employee")
  @@index([organizationId, status], map: "idx_employee_expense_claims_org_status")
  @@map("employee_expense_claims")
}

/// Append-only maker-checker decision ledger for EmployeeExpenseClaim's own
/// approve/reject step -- byte-for-byte VendorBillDecision's own shape.
/// CANCELLED is deliberately not recorded here, matching VendorBillDecision's
/// own precedent -- it stays EmployeeExpenseClaim's own header columns.
model EmployeeExpenseClaimDecision {
  id             String                           @id @db.Uuid
  organizationId String                           @map("organization_id") @db.Uuid
  claimId        String                           @map("claim_id") @db.Uuid
  decision       EmployeeExpenseClaimDecisionType
  actorId        String                           @map("actor_id") @db.Uuid
  decidedAt      DateTime                         @default(now()) @map("decided_at") @db.Timestamptz
  note           String?
  isSelfApproval Boolean                          @default(false) @map("is_self_approval")

  claim EmployeeExpenseClaim @relation(fields: [claimId], references: [id], map: "fk_employee_expense_claim_decisions_claim")

  @@index([claimId], map: "idx_employee_expense_claim_decisions_claim_id")
  @@map("employee_expense_claim_decisions")
}

enum DirectExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

/// ADR-169: marks a direct expense as a server or a subscription bill, so the
/// project page and reports can show them apart. Null for every other expense.
enum DirectExpenseSpendType {
  SERVER
  SUBSCRIPTION
}

enum DirectExpenseSupplyType {
  INTRASTATE
  INTERSTATE
}

enum CardType {
  DEBIT_CARD
  CREDIT_CARD
}

/// The other branch of the shared expense-add.html prototype (docs/04,
/// docs/06 "Direct expense paid immediately") -- a company-paid bill with no
/// employee/wallet involvement at all, deliberately deferred out of Phase 6.6
/// (Employee Advance & Expense Claim). No maker-checker (confirmed via
/// AskUserQuestion, docs/04's own wording): a single direct_expense.post
/// holder creates a DRAFT and posts it, back to back if they choose --
/// post() is the sole authoritative action. DRAFT -> CANCELLED
/// (creator-only, reason required) mirrors VendorBill/EmployeeExpenseClaim's
/// own cancel; POSTED -> REVERSED mirrors EmployeeAdvance/VendorPayment's
/// own reversal exactly. projectId is nullable ("company overhead"), no Lead
/// link target (confirmed via AskUserQuestion, same simplification as
/// EmployeeExpenseClaim). No project-scoping anywhere in this module --
/// purely Accountant/Admin-facing, no employee self-service angle to scope.
///
/// Phase 6.8 extension (docs/12 ADR-088): the flat gstCreditAmount this
/// model shipped with (ADR-087) is replaced by a real CGST/SGST/IGST split
/// -- taxableAmount/gstRatePercent/supplyType are entered/selected, cgst/
/// sgst/igstAmount are computed at createDraft/updateDraft time using the
/// same split math as computeLines (invoices.service.ts), frozen into the
/// row and never recomputed at post() (mirrors Vendor Bill's freeze-at-
/// draft/sum-at-approve pattern). supplyType is a manual selection, not
/// derived the way Vendor Bill derives sameState from vendor/GST-
/// registration state, because Direct Expense has no vendor/registration
/// pair to compare. itcEligible gates whether the computed GST posts to
/// Input GST Receivable or folds into the expense debit, mirroring Vendor
/// Bill's own per-line ineligible-ITC behaviour. tdsAmount/tdsRatePercent
/// add optional flat TDS (Direct Expense has no allocations, so one amount
/// on the row is proportionate, unlike Vendor Payment's typed per-
/// allocation VendorPaymentDeduction rows) posted to the same TDS_PAYABLE
/// account Vendor Payment already uses. bankAccountId is now nullable and
/// cardAccountId added so a Credit Card payment can post to its own
/// CardAccount.ledgerAccountId liability instead of a bank account --
/// exactly one of the two must resolve at post() time, enforced in the
/// service (not a DB CHECK, since the rule depends on the linked
/// CardAccount's own type, not a local column).
model DirectExpense {
  id                     String                   @id @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  legalEntityId          String                   @map("legal_entity_id") @db.Uuid
  expenseCategoryId      String                   @map("expense_category_id") @db.Uuid
  vendorId               String?                  @map("vendor_id") @db.Uuid
  title                  String
  projectId              String?                  @map("project_id") @db.Uuid
  taxableAmount          Decimal                  @map("taxable_amount") @db.Decimal(19, 4)
  amount                 Decimal                  @db.Decimal(19, 4)
  expenseDate            DateTime                 @map("expense_date") @db.Date
  gstInvoiceAvailable    Boolean                  @default(false) @map("gst_invoice_available")
  gstRatePercent         Decimal?                 @map("gst_rate_percent") @db.Decimal(5, 2)
  supplyType             DirectExpenseSupplyType? @map("supply_type")
  cgstAmount             Decimal                  @default(0) @map("cgst_amount") @db.Decimal(19, 4)
  sgstAmount             Decimal                  @default(0) @map("sgst_amount") @db.Decimal(19, 4)
  igstAmount             Decimal                  @default(0) @map("igst_amount") @db.Decimal(19, 4)
  itcEligible            Boolean                  @default(true) @map("itc_eligible")
  tdsAmount              Decimal                  @default(0) @map("tds_amount") @db.Decimal(19, 4)
  tdsRatePercent         Decimal?                 @map("tds_rate_percent") @db.Decimal(5, 2)
  paymentModeId          String                   @map("payment_mode_id") @db.Uuid
  bankAccountId          String?                  @map("bank_account_id") @db.Uuid
  cardAccountId          String?                  @map("card_account_id") @db.Uuid
  transactionReference   String?                  @map("transaction_reference")
  purchasedByEmployeeId  String?                  @map("purchased_by_employee_id") @db.Uuid
  note                   String?
  spendType              DirectExpenseSpendType?  @map("spend_type")
  /// A link to the bill (a vendor portal or drive URL), ADR-169. An uploaded copy is a document instead.
  billUrl                String?                  @map("bill_url")
  /// A bill paid in another currency (ADR-169): the total as billed in that
  /// currency and the INR rate used. Every amount column above is in rupees.
  foreignAmount          Decimal?                 @map("foreign_amount") @db.Decimal(19, 4)
  /// The basic amount (before GST) in that currency, so a correction can start from the bill as it was.
  foreignTaxableAmount   Decimal?                 @map("foreign_taxable_amount") @db.Decimal(19, 4)
  exchangeRate           Decimal?                 @map("exchange_rate") @db.Decimal(19, 6)
  status                 DirectExpenseStatus      @default(DRAFT)
  postedAt               DateTime?                @map("posted_at") @db.Timestamptz
  postedBy               String?                  @map("posted_by") @db.Uuid
  journalEntryId         String?                  @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?                  @map("reversal_journal_entry_id") @db.Uuid
  reversalReason         String?                  @map("reversal_reason")
  reversedBy             String?                  @map("reversed_by") @db.Uuid
  reversedAt             DateTime?                @map("reversed_at") @db.Timestamptz
  cancelledAt            DateTime?                @map("cancelled_at") @db.Timestamptz
  cancelledBy            String?                  @map("cancelled_by") @db.Uuid
  cancelledReason        String?                  @map("cancelled_reason")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?                  @map("created_by") @db.Uuid
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?                  @map("updated_by") @db.Uuid
  version                Int                      @default(1)

  legalEntity           LegalEntity            @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_direct_expenses_legal_entity_org_consistent")
  expenseCategory       ExpenseCategory        @relation(fields: [expenseCategoryId, organizationId], references: [id, organizationId], map: "fk_direct_expenses_expense_category_org_consistent")
  vendor                Party?                 @relation(fields: [vendorId, organizationId], references: [id, organizationId], map: "fk_direct_expenses_vendor_org_consistent")
  project               Project?               @relation(fields: [projectId, organizationId], references: [id, organizationId], map: "fk_direct_expenses_project_org_consistent")
  paymentMode           PaymentMode            @relation(fields: [paymentModeId], references: [id], map: "fk_direct_expenses_payment_mode")
  bankAccount           BankAccount?           @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_direct_expenses_bank_account_org_consistent")
  cardAccount           CardAccount?           @relation(fields: [cardAccountId, organizationId], references: [id, organizationId], map: "fk_direct_expenses_card_account_org_consistent")
  purchasedByEmployee   Employee?              @relation(fields: [purchasedByEmployeeId, organizationId], references: [id, organizationId], map: "fk_direct_expenses_purchased_by_employee_org_consistent")
  journalEntry          JournalEntry?          @relation("DirectExpensePostJournalEntry", fields: [journalEntryId], references: [id], map: "fk_direct_expenses_journal_entry")
  reversalJournalEntry  JournalEntry?          @relation("DirectExpenseReversalJournalEntry", fields: [reversalJournalEntryId], references: [id], map: "fk_direct_expenses_reversal_journal_entry")

  @@unique([id, organizationId], map: "uq_direct_expenses_id_org")
  @@index([organizationId, status], map: "idx_direct_expenses_org_status")
  @@index([organizationId, spendType, expenseDate], map: "idx_direct_expenses_org_spend_type_date")
  @@map("direct_expenses")
}

/// Phase 6.8 (docs/12 ADR-088). A minimal debit/credit card master so
/// Direct Expense can post Debit Card payments straight to their linked
/// BankAccount (same shape as any other bank-sourced payment) and Credit
/// Card payments to a dedicated liability ledger account instead of
/// incorrectly reducing Bank immediately. Deliberately excludes every
/// sensitive field (full card number, CVV, PIN, OTP, banking credentials)
/// -- only a masked last-four digit string is ever stored. CRUD lives
/// behind legal_entity.manage/read, same boundary as BankAccount (bundled
/// into the same organization-setup module) since it is the same class of
/// financial-infrastructure master, not a workflow entity of its own.
model CardAccount {
  id                   String   @id @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  legalEntityId        String   @map("legal_entity_id") @db.Uuid
  type                 CardType
  displayName          String   @map("display_name")
  issuerName           String?  @map("issuer_name")
  maskedLastFour       String   @map("masked_last_four")
  cardNumber           String?  @map("card_number")
  cardholderEmployeeId String?  @map("cardholder_employee_id") @db.Uuid
  bankAccountId        String?  @map("bank_account_id") @db.Uuid
  ledgerAccountId      String?  @map("ledger_account_id") @db.Uuid
  statementDay         Int?     @map("statement_day")
  paymentDueDay        Int?     @map("payment_due_day")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String?  @map("created_by") @db.Uuid
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy            String?  @map("updated_by") @db.Uuid
  version              Int      @default(1)

  legalEntity        LegalEntity      @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_card_accounts_legal_entity_org_consistent")
  cardholderEmployee Employee?        @relation(fields: [cardholderEmployeeId, organizationId], references: [id, organizationId], map: "fk_card_accounts_cardholder_employee_org_consistent")
  bankAccount        BankAccount?     @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_card_accounts_bank_account_org_consistent")
  ledgerAccount      LedgerAccount?   @relation(fields: [ledgerAccountId, organizationId], references: [id, organizationId], map: "fk_card_accounts_ledger_account_org_consistent")
  directExpenses     DirectExpense[]
  vendorPayments     VendorPayment[]
  settlements        CardSettlement[]

  @@unique([id, organizationId], map: "uq_card_accounts_id_org")
  @@index([organizationId, isActive], map: "idx_card_accounts_org_active")
  @@map("card_accounts")
}

/// Phase 6.8 (ADR-088). Settles part or all of a Credit Card's outstanding
/// payable: Dr CardAccount.ledgerAccountId / Cr the paying BankAccount's own
/// ledger. amount is capped (service-level, not a DB CHECK -- the cap is the
/// card's own live ledger balance, not a locally-stored value) at the card's
/// outstanding balance so a settlement can never overpay past what was
/// actually charged. No reversal/void of its own -- a genuine correction
/// is a new, separate settlement or a manual journal adjustment, out of
/// scope for this minimal slice (see docs/12 ADR-088's own "explicitly
/// deferred" list).
model CardSettlement {
  id                   String   @id @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  cardAccountId        String   @map("card_account_id") @db.Uuid
  amount               Decimal  @db.Decimal(19, 4)
  settlementDate       DateTime @map("settlement_date") @db.Date
  bankAccountId        String   @map("bank_account_id") @db.Uuid
  transactionReference String?  @map("transaction_reference")
  journalEntryId       String   @map("journal_entry_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy            String?  @map("created_by") @db.Uuid

  cardAccount  CardAccount  @relation(fields: [cardAccountId, organizationId], references: [id, organizationId], map: "fk_card_settlements_card_account_org_consistent")
  bankAccount  BankAccount  @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_card_settlements_bank_account_org_consistent")
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], map: "fk_card_settlements_journal_entry")

  @@index([organizationId, cardAccountId], map: "idx_card_settlements_org_card_account")
  @@map("card_settlements")
}

/// Phase 8.5a (ADR-112) -- TDS and GST-TDS credits a client has reported
/// deducting from our receipts: a certificate received (Form 16A, GSTR-7A)
/// or a line of a government statement (Form 26AS, the GST portal's TDS
/// credit). Recorded by hand or from a CSV template. No accounting effect:
/// matching them to AllocationDeduction rows is reconciliation only, and it
/// is what moves a deduction through docs/05's lifecycle
/// RECORDED -> CERTIFICATE_PENDING -> CERTIFICATE_RECEIVED -> RECONCILED,
/// which is derived, never stored.
enum TdsCertificateSource {
  CERTIFICATE
  STATEMENT
}

enum TaxDeductionType {
  TDS
  CGST_TDS
  SGST_TDS
  IGST_TDS
}

enum TdsCertificateStatus {
  ACTIVE
  CANCELLED
}

model TdsCertificate {
  id              String               @id @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  legalEntityId   String               @map("legal_entity_id") @db.Uuid
  /// The client that deducted the tax.
  partyId         String               @map("party_id") @db.Uuid
  source          TdsCertificateSource
  deductionType   TaxDeductionType     @map("deduction_type")
  referenceNumber String               @map("reference_number")
  deductorTan     String?              @map("deductor_tan")
  deductorGstin   String?              @map("deductor_gstin")
  periodStart     DateTime             @map("period_start") @db.Date
  periodEnd       DateTime             @map("period_end") @db.Date
  /// The date the credit carries in the certificate or statement.
  creditDate      DateTime             @map("credit_date") @db.Date
  amount          Decimal              @db.Decimal(19, 4)
  remarks         String?
  status          TdsCertificateStatus @default(ACTIVE)
  cancelledAt     DateTime?            @map("cancelled_at") @db.Timestamptz
  cancelledBy     String?              @map("cancelled_by") @db.Uuid
  cancelReason    String?              @map("cancel_reason")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?              @map("created_by") @db.Uuid
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?              @map("updated_by") @db.Uuid
  version         Int                  @default(1)

  legalEntity LegalEntity           @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_tds_certificates_legal_entity_org_consistent")
  party       Party                 @relation(fields: [partyId, organizationId], references: [id, organizationId], map: "fk_tds_certificates_party_org_consistent")
  matches     TdsCertificateMatch[]

  @@unique([organizationId, partyId, source, deductionType, referenceNumber], map: "uq_tds_certificates_reference")
  @@index([organizationId, status], map: "idx_tds_certificates_org_status")
  @@index([organizationId, partyId], map: "idx_tds_certificates_org_party")
  @@map("tds_certificates")
}

/// One matched amount between a certificate and a client deduction. Never
/// edited or deleted: unmatching stamps unmatchedAt, so what was matched when
/// survives for audit and for as-of reporting.
model TdsCertificateMatch {
  id                    String    @id @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  certificateId         String    @map("certificate_id") @db.Uuid
  allocationDeductionId String    @map("allocation_deduction_id") @db.Uuid
  amount                Decimal   @db.Decimal(19, 4)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy             String?   @map("created_by") @db.Uuid
  unmatchedAt           DateTime? @map("unmatched_at") @db.Timestamptz
  unmatchedBy           String?   @map("unmatched_by") @db.Uuid
  unmatchReason         String?   @map("unmatch_reason")

  certificate TdsCertificate      @relation(fields: [certificateId], references: [id], map: "fk_tds_certificate_matches_certificate")
  deduction   AllocationDeduction @relation(fields: [allocationDeductionId], references: [id], map: "fk_tds_certificate_matches_deduction")

  @@index([certificateId], map: "idx_tds_certificate_matches_certificate")
  @@index([allocationDeductionId], map: "idx_tds_certificate_matches_deduction")
  @@index([organizationId], map: "idx_tds_certificate_matches_org")
  @@map("tds_certificate_matches")
}

/// Phase 8.5b (ADR-113) -- a deposit of TDS or GST-TDS withheld from
/// payments to the government (an income-tax challan, a GST cash-ledger
/// payment). Posts docs/06 "TDS deposited": Dr the payable / Cr Bank. Its
/// amount is exactly the sum of its allocations to the deductions it pays,
/// so the payable can never go below what was withheld. Reversed, never
/// edited or deleted.
enum TdsDepositStatus {
  POSTED
  REVERSED
}

/// The kinds of payment that withhold tax into TDS/GST-TDS payable.
enum TdsOutwardSourceKind {
  VENDOR_PAYMENT_DEDUCTION
  DIRECT_EXPENSE
  INTRODUCER_PAYMENT
  SALARY_PAYMENT_LINE
}

model TdsDeposit {
  id                     String           @id @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  legalEntityId          String           @map("legal_entity_id") @db.Uuid
  bankAccountId          String           @map("bank_account_id") @db.Uuid
  deductionType          TaxDeductionType @map("deduction_type")
  /// Challan identification (CIN, or BSR code + date + serial) or the GST payment reference.
  challanNumber          String           @map("challan_number")
  depositDate            DateTime         @map("deposit_date") @db.Date
  amount                 Decimal          @db.Decimal(19, 4)
  remarks                String?
  status                 TdsDepositStatus @default(POSTED)
  journalEntryId         String           @map("journal_entry_id") @db.Uuid
  reversalJournalEntryId String?          @map("reversal_journal_entry_id") @db.Uuid
  reversedAt             DateTime?        @map("reversed_at") @db.Timestamptz
  reversedBy             String?          @map("reversed_by") @db.Uuid
  reversalReason         String?          @map("reversal_reason")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz
  createdBy              String?          @map("created_by") @db.Uuid
  updatedAt              DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy              String?          @map("updated_by") @db.Uuid
  version                Int              @default(1)

  legalEntity          LegalEntity            @relation(fields: [legalEntityId, organizationId], references: [id, organizationId], map: "fk_tds_deposits_legal_entity_org_consistent")
  bankAccount          BankAccount            @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_tds_deposits_bank_account_org_consistent")
  journalEntry         JournalEntry           @relation("TdsDepositPostJournalEntry", fields: [journalEntryId], references: [id], map: "fk_tds_deposits_journal_entry")
  reversalJournalEntry JournalEntry?          @relation("TdsDepositReversalJournalEntry", fields: [reversalJournalEntryId], references: [id], map: "fk_tds_deposits_reversal_journal_entry")
  allocations          TdsDepositAllocation[]

  @@unique([organizationId, deductionType, challanNumber], map: "uq_tds_deposits_challan")
  @@index([organizationId, status], map: "idx_tds_deposits_org_status")
  @@index([organizationId, depositDate], map: "idx_tds_deposits_org_date")
  @@map("tds_deposits")
}

/// How much of one withheld amount a deposit pays. The source is
/// polymorphic (four different tables), so it carries no foreign key; the
/// service validates it, and a deposit's allocations never change after
/// posting.
model TdsDepositAllocation {
  id             String               @id @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  depositId      String               @map("deposit_id") @db.Uuid
  sourceKind     TdsOutwardSourceKind @map("source_kind")
  sourceId       String               @map("source_id") @db.Uuid
  amount         Decimal              @db.Decimal(19, 4)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  deposit TdsDeposit @relation(fields: [depositId], references: [id], map: "fk_tds_deposit_allocations_deposit")

  @@unique([depositId, sourceKind, sourceId], map: "uq_tds_deposit_allocations_source")
  @@index([organizationId, sourceKind, sourceId], map: "idx_tds_deposit_allocations_source")
  @@map("tds_deposit_allocations")
}

/// Phase 8.6a (ADR-114) -- bank statement import and reconciliation matching
/// (docs/04 §18 "Bank Transaction Import and Reconciliation"). The user's
/// choice: any bank's CSV, with its columns mapped once per bank account.
enum BankStatementAmountMode {
  DEBIT_CREDIT_COLUMNS
  SIGNED_AMOUNT
  AMOUNT_WITH_INDICATOR
}

enum BankStatementDateFormat {
  YYYY_MM_DD
  DD_MM_YYYY_SLASH
  DD_MM_YYYY_DASH
  DD_MMM_YYYY
  MM_DD_YYYY_SLASH
}

/// How one bank account's CSV export maps to statement lines. Columns are
/// named by their header text.
model BankStatementProfile {
  id                String                  @id @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  bankAccountId     String                  @map("bank_account_id") @db.Uuid
  dateColumn        String                  @map("date_column")
  dateFormat        BankStatementDateFormat @map("date_format")
  descriptionColumn String                  @map("description_column")
  referenceColumn   String?                 @map("reference_column")
  amountMode        BankStatementAmountMode @map("amount_mode")
  /// Money out, for DEBIT_CREDIT_COLUMNS.
  debitColumn       String?                 @map("debit_column")
  /// Money in, for DEBIT_CREDIT_COLUMNS.
  creditColumn      String?                 @map("credit_column")
  /// SIGNED_AMOUNT (positive = money in) and AMOUNT_WITH_INDICATOR.
  amountColumn      String?                 @map("amount_column")
  indicatorColumn   String?                 @map("indicator_column")
  /// The indicator value meaning money in, e.g. "CR".
  creditIndicator   String?                 @map("credit_indicator")
  balanceColumn     String?                 @map("balance_column")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?                 @map("created_by") @db.Uuid
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy         String?                 @map("updated_by") @db.Uuid
  version           Int                     @default(1)

  bankAccount BankAccount @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_bank_statement_profiles_bank_account_org_consistent")

  @@unique([bankAccountId, organizationId], map: "uq_bank_statement_profiles_bank_account")
  @@index([organizationId], map: "idx_bank_statement_profiles_org")
  @@map("bank_statement_profiles")
}

/// One uploaded file. Lines already imported (same fingerprint) are skipped
/// and counted, so re-uploading an overlapping export is safe.
model BankStatementImport {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  fileName       String   @map("file_name")
  lineCount      Int      @map("line_count")
  duplicateCount Int      @map("duplicate_count")
  firstDate      DateTime @map("first_date") @db.Date
  lastDate       DateTime @map("last_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid

  bankAccount BankAccount         @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_bank_statement_imports_bank_account_org_consistent")
  lines       BankStatementLine[]

  @@index([organizationId, bankAccountId], map: "idx_bank_statement_imports_org_account")
  @@map("bank_statement_imports")
}

/// A transaction as the bank reports it. Amount is signed: positive is
/// money in. Never edited; an exception is an explanation for a line no
/// book entry will match, marked by one person and approved by another.
model BankStatementLine {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  bankAccountId       String    @map("bank_account_id") @db.Uuid
  importId            String    @map("import_id") @db.Uuid
  lineNumber          Int       @map("line_number")
  transactionDate     DateTime  @map("transaction_date") @db.Date
  description         String
  reference           String?
  amount              Decimal   @db.Decimal(19, 4)
  balance             Decimal?  @db.Decimal(19, 4)
  /// Hash of date, amount, description, reference, balance and its
  /// occurrence among identical lines in the file — how re-imports are detected.
  fingerprint         String
  exceptionReason     String?   @map("exception_reason")
  exceptionMarkedAt   DateTime? @map("exception_marked_at") @db.Timestamptz
  exceptionMarkedBy   String?   @map("exception_marked_by") @db.Uuid
  exceptionApprovedAt DateTime? @map("exception_approved_at") @db.Timestamptz
  exceptionApprovedBy String?   @map("exception_approved_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  bankAccount BankAccount               @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_bank_statement_lines_bank_account_org_consistent")
  import      BankStatementImport       @relation(fields: [importId], references: [id], map: "fk_bank_statement_lines_import")
  matches     BankReconciliationMatch[]

  @@unique([bankAccountId, fingerprint], map: "uq_bank_statement_lines_fingerprint")
  @@index([bankAccountId, transactionDate], map: "idx_bank_statement_lines_account_date")
  @@index([importId], map: "idx_bank_statement_lines_import")
  @@map("bank_statement_lines")
}

/// An amount matched between a statement line and a bank journal line (same
/// sign). Many-to-many: one deposit on the statement can clear several
/// receipts and one payment several lines. Unmatching stamps, never deletes.
model BankReconciliationMatch {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  bankAccountId   String    @map("bank_account_id") @db.Uuid
  statementLineId String    @map("statement_line_id") @db.Uuid
  journalLineId   String    @map("journal_line_id") @db.Uuid
  amount          Decimal   @db.Decimal(19, 4)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  unmatchedAt     DateTime? @map("unmatched_at") @db.Timestamptz
  unmatchedBy     String?   @map("unmatched_by") @db.Uuid
  unmatchReason   String?   @map("unmatch_reason")

  bankAccount   BankAccount       @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_bank_reconciliation_matches_bank_account_org_consistent")
  statementLine BankStatementLine @relation(fields: [statementLineId], references: [id], map: "fk_bank_reconciliation_matches_statement_line")
  journalLine   JournalLine       @relation(fields: [journalLineId], references: [id], map: "fk_bank_reconciliation_matches_journal_line")

  @@index([statementLineId], map: "idx_bank_reconciliation_matches_statement_line")
  @@index([journalLineId], map: "idx_bank_reconciliation_matches_journal_line")
  @@index([organizationId, bankAccountId], map: "idx_bank_reconciliation_matches_org_account")
  @@map("bank_reconciliation_matches")
}

/// Phase 8.6b (ADR-115) -- docs/05 "Bank reconciliation period"
/// OPEN -> IN_PROGRESS -> RECONCILED -> LOCKED, per bank account per month.
/// OPEN is having no row. A row is written when the month is first marked
/// reconciled; changing a match or exception in a RECONCILED month returns it
/// to IN_PROGRESS; a LOCKED month refuses every change. The figures are the
/// bank reconciliation statement as it stood when the month was reconciled.
enum BankReconciliationPeriodStatus {
  IN_PROGRESS
  RECONCILED
  LOCKED
}

model BankReconciliationPeriod {
  id                      String                         @id @db.Uuid
  organizationId          String                         @map("organization_id") @db.Uuid
  bankAccountId           String                         @map("bank_account_id") @db.Uuid
  periodStart             DateTime                       @map("period_start") @db.Date
  periodEnd               DateTime                       @map("period_end") @db.Date
  status                  BankReconciliationPeriodStatus
  /// The bank's balance before the month: entered for an account's first reconciled month, the previous month's closing after that.
  statementOpeningBalance Decimal                        @map("statement_opening_balance") @db.Decimal(19, 4)
  statementClosingBalance Decimal                        @map("statement_closing_balance") @db.Decimal(19, 4)
  bookClosingBalance      Decimal                        @map("book_closing_balance") @db.Decimal(19, 4)
  unclearedBookAmount     Decimal                        @map("uncleared_book_amount") @db.Decimal(19, 4)
  exceptionAmount         Decimal                        @map("exception_amount") @db.Decimal(19, 4)
  preparedAt              DateTime                       @map("prepared_at") @db.Timestamptz
  preparedBy              String                         @map("prepared_by") @db.Uuid
  lockedAt                DateTime?                      @map("locked_at") @db.Timestamptz
  lockedBy                String?                        @map("locked_by") @db.Uuid
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                       @default(now()) @map("updated_at") @db.Timestamptz
  version                 Int                            @default(1)

  bankAccount BankAccount @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], map: "fk_bank_reconciliation_periods_bank_account_org_consistent")

  @@unique([bankAccountId, periodStart], map: "uq_bank_reconciliation_periods_month")
  @@index([organizationId, status], map: "idx_bank_reconciliation_periods_org_status")
  @@map("bank_reconciliation_periods")
}

/// An unfinished form, stored for the user who typed it. It is not a business
/// record: Save as draft writes this without the checks Save still runs.
model FormDraft {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  formKey        String   @map("form_key") @db.VarChar(200)
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([organizationId, userId, formKey], map: "uq_form_drafts_owner_key")
  @@index([organizationId], map: "idx_form_drafts_organization_id")
  @@map("form_drafts")
}

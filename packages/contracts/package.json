{
  "name": "@zitaware/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reports": {
      "types": "./dist/ports/report.port.d.ts",
      "default": "./dist/ports/report.port.js"
    },
    "./bank-reconciliation": {
      "types": "./dist/ports/bank-reconciliation.port.d.ts",
      "default": "./dist/ports/bank-reconciliation.port.js"
    },
    "./dashboard": {
      "types": "./dist/ports/dashboard.port.d.ts",
      "default": "./dist/ports/dashboard.port.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@trpc/server": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

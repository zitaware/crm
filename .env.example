# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- Public URLs ---
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# --- Ports ---
WEB_PORT=3000
API_PORT=4000
WORKER_HEALTH_PORT=4100

# --- Database ---
DATABASE_URL=postgresql://zitaware:zitaware@localhost:5432/zitaware_crm_dev
# Genuinely separate, disposable database — Prisma's migrate dev/diff use
# this as scratch space. Must NEVER equal DATABASE_URL (see
# packages/database/scripts/assert-shadow-database-safe.mjs, run
# automatically before prisma:migrate:dev / prisma:migrate:diff).
SHADOW_DATABASE_URL=postgresql://zitaware:zitaware@localhost:5432/zitaware_crm_shadow
# The database integration tests create and delete data in. Migrated and
# seeded automatically before each integration run; must NEVER equal
# DATABASE_URL or SHADOW_DATABASE_URL (see
# packages/database/scripts/integration-test-database.mjs).
TEST_DATABASE_URL=postgresql://zitaware:zitaware@localhost:5432/zitaware_crm_test

# --- Auth / session ---
SESSION_SECRET=change-me-dev-only-32-byte-minimum-placeholder
# Access token is the short-lived JWT (1 hour). The refresh token keeps the
# session alive (1 day) and is rotated when the access token expires.
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=1
# A refresh token rotated this many seconds ago or less may be used again
# (two tabs, or the web server and the browser, refreshing at once).
REFRESH_REUSE_GRACE_SECONDS=60
INVITATION_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=1
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Outbox worker ---
OUTBOX_LEASE_TIMEOUT_MINUTES=5
OUTBOX_MAX_ATTEMPTS=5

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Object storage (S3-compatible) ---
# S3_ENDPOINT is optional — only set it for a non-AWS S3-compatible provider
# (MinIO, DigitalOcean Spaces, R2, etc.). Real AWS S3 resolves its endpoint
# from S3_REGION alone; leave S3_ENDPOINT unset/commented out for real AWS.
# S3_ENDPOINT=https://s3.example-region.example-provider.com
S3_REGION=ap-south-1
S3_BUCKET=zitaware-crm-dev-documents
S3_ACCESS_KEY_ID=replace-with-dev-access-key
S3_SECRET_ACCESS_KEY=replace-with-dev-secret-key
# Optional folder new objects are stored under (e.g. crm → crm/<org>/...).
S3_PREFIX_FOLDER=crm

# --- Email (Gmail SMTP) ---
# SMTP_PASS is a Gmail App Password (Google Account → Security → App passwords),
# not the account password. 465 = implicit TLS; use 587 for STARTTLS.
# A SMTP_PASS starting with replace-with- makes the worker log emails instead
# of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=zitawaresolutions@gmail.com
SMTP_PASS=replace-with-gmail-app-password
# Defaults to SMTP_USER; Gmail only sends as the account or a verified alias.
# SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Zitaware CRM"

# --- Seed ---
# Password for the seeded admin (zitawaresolutions@gmail.com), used only when
# the seed creates that user. Quoted because # would otherwise start a comment.
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Jobs ---
PGBOSS_SCHEMA=pgboss
